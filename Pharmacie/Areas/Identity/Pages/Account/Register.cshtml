@page
@model RegisterModel
@{
    ViewData["Title"] = "S'inscrire";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-3">@ViewData["Title"]</h1>
                <p class="text-muted mb-4">Créer un nouveau compte</p>
                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label"></label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="Input.Password" class="form-control" id="password-field-register"
                                   autocomplete="new-password" aria-required="true" />
                            <button class="btn btn-outline-secondary" type="button"
                                    onclick="togglePassword('password-field-register')"
                                    tabindex="-1"
                                    title="Afficher/masquer le mot de passe">
                                <i class="bi bi-eye" id="eye-icon-register"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="Input.ConfirmPassword" class="form-control" id="password-field-register-confirm"
                                   autocomplete="new-password" aria-required="true" />
                            <button class="btn btn-outline-secondary" type="button"
                                    onclick="togglePassword('password-field-register-confirm')"
                                    tabindex="-1"
                                    title="Afficher/masquer le mot de passe">
                                <i class="bi bi-eye" id="eye-icon-register-confirm"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>

                    <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">S'inscrire</button>

                    <p class="mt-3 mb-0">
                        Déjà un compte ?
                        <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Se connecter</a>
                    </p>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
