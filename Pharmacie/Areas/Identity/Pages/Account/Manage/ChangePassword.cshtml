@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Changer le mot de passe";
}

<div class="container-fluid px-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-key me-2"></i>
                        Changer le mot de passe
                    </h5>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.StatusMessage))
                    {
                        <div class="alert alert-success py-2">@Model.StatusMessage</div>
                    }

                    <form id="change-password-form" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Input.OldPassword" class="form-label fw-bold">Mot de passe actuel</label>
                            <div class="input-group">
                                <input asp-for="Input.OldPassword" class="form-control" id="password-field-old"
                                       autocomplete="current-password" aria-required="true" />
                                <button class="btn btn-outline-secondary" type="button"
                                        onclick="togglePassword('password-field-old')"
                                        tabindex="-1"
                                        title="Afficher/masquer le mot de passe">
                                    <i class="bi bi-eye" id="eye-icon-old"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.NewPassword" class="form-label fw-bold">Nouveau mot de passe</label>
                            <div class="input-group">
                                <input asp-for="Input.NewPassword" class="form-control" id="password-field-new"
                                       autocomplete="new-password" aria-required="true" />
                                <button class="btn btn-outline-secondary" type="button"
                                        onclick="togglePassword('password-field-new')"
                                        tabindex="-1"
                                        title="Afficher/masquer le mot de passe">
                                    <i class="bi bi-eye" id="eye-icon-new"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.ConfirmPassword" class="form-label fw-bold">Confirmer le nouveau mot de passe</label>
                            <div class="input-group">
                                <input asp-for="Input.ConfirmPassword" class="form-control" id="password-field-confirm"
                                       autocomplete="new-password" aria-required="true" />
                                <button class="btn btn-outline-secondary" type="button"
                                        onclick="togglePassword('password-field-confirm')"
                                        tabindex="-1"
                                        title="Afficher/masquer le mot de passe">
                                    <i class="bi bi-eye" id="eye-icon-confirm"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-circle me-1"></i>
                                Enregistrer
                            </button>
                            <a class="btn btn-outline-secondary" asp-page="./Index">Annuler</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
