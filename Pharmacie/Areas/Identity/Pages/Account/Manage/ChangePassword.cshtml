@page
@model Pharmacie.Areas.Identity.Pages.Account.Manage.ChangePasswordModel
@{
    ViewData["Title"] = "Changer le mot de passe";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1 class="h3 mb-3">@ViewData["Title"]</h1>
        @if (!string.IsNullOrEmpty(Model.StatusMessage))
        {
            <div class="alert alert-success alert-dismissible" role="alert">
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                @Model.StatusMessage
            </div>
        }
        <form id="change-password-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Input.OldPassword" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="Input.OldPassword" class="form-control" id="password-field-old"
                           autocomplete="current-password" aria-required="true" />
                    <button class="btn btn-outline-secondary" type="button"
                            onclick="togglePassword('password-field-old')"
                            tabindex="-1"
                            title="Afficher/masquer le mot de passe">
                        <i class="bi bi-eye" id="eye-icon-old"></i>
                    </button>
                </div>
                <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.NewPassword" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="Input.NewPassword" class="form-control" id="password-field-new"
                           autocomplete="new-password" aria-required="true" />
                    <button class="btn btn-outline-secondary" type="button"
                            onclick="togglePassword('password-field-new')"
                            tabindex="-1"
                            title="Afficher/masquer le mot de passe">
                        <i class="bi bi-eye" id="eye-icon-new"></i>
                    </button>
                </div>
                <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="Input.ConfirmPassword" class="form-control" id="password-field-confirm"
                           autocomplete="new-password" aria-required="true" />
                    <button class="btn btn-outline-secondary" type="button"
                            onclick="togglePassword('password-field-confirm')"
                            tabindex="-1"
                            title="Afficher/masquer le mot de passe">
                        <i class="bi bi-eye" id="eye-icon-confirm"></i>
                    </button>
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="w-100 btn btn-lg btn-primary">Valider</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
