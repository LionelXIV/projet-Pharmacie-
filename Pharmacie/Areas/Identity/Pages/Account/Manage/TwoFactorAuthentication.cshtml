@page
@model TwoFactorAuthenticationModel
@{
    ViewData["Title"] = "Authentification à deux facteurs";
}

<div class="container-fluid px-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-shield-lock me-2"></i>
                        Authentification à deux facteurs
                    </h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-info py-2">
                        <i class="bi bi-info-circle me-1"></i>
                        L'authentification à deux facteurs n'est pas activée sur ce compte.
                    </div>

                    @if (false) // Désactivé temporairement
                    {
                        <a class="btn btn-success" asp-page="./EnableAuthenticator">Activer l'authentification à deux facteurs</a>
                        <button type="button" class="btn btn-outline-secondary">Réinitialiser les codes de récupération</button>
                    }

                    <a class="btn btn-outline-secondary" asp-page="./Index">Annuler</a>
                </div>
            </div>
        </div>
    </div>
</div>
