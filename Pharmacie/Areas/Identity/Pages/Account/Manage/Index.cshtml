@page
@model IndexModel
@{
    ViewData["Title"] = "Mon compte";
}

<div class="container-fluid px-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-person-circle me-2"></i>
                        Mon compte
                    </h5>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.StatusMessage))
                    {
                        <div class="alert alert-success py-2">
                            @Model.StatusMessage
                        </div>
                    }

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                        <div class="mb-3">
                            <label class="form-label fw-bold" asp-for="Username">Identifiant</label>
                            <input asp-for="Username" class="form-control" disabled />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold" asp-for="Input.DisplayName">Nom affiché</label>
                            <input asp-for="Input.DisplayName" class="form-control" placeholder="Votre nom" />
                            <span asp-validation-for="Input.DisplayName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold" asp-for="Input.PhoneNumber">Téléphone</label>
                            <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Ex: 77 123 45 67" />
                            <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-circle me-1"></i>
                                Enregistrer
                            </button>
                            <a class="btn btn-outline-secondary" asp-page="./ChangePassword">Changer le mot de passe</a>
                            <a class="btn btn-outline-secondary" asp-page="./Email">Adresse email</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
