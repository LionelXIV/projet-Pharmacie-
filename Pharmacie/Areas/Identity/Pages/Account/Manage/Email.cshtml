@page
@model EmailModel
@{
    ViewData["Title"] = "Adresse email";
}

<div class="container-fluid px-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-envelope me-2"></i>
                        Adresse email
                    </h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Adresse email</label>
                        <input class="form-control" value="@Model.Email" disabled />
                    </div>
                    @if (Model.IsEmailConfirmed)
                    {
                        <p class="text-muted small mb-3">Cette adresse est confirmée.</p>
                    }
                    else
                    {
                        <p class="text-muted small mb-3">Pour modifier l'adresse, contactez un administrateur.</p>
                    }
                    <a class="btn btn-outline-secondary" asp-page="./Index">Annuler</a>
                </div>
            </div>
        </div>
    </div>
</div>
