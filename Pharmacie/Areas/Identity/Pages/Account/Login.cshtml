@page
@model LoginModel
@{
    ViewData["Title"] = "Se connecter";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-3">@ViewData["Title"]</h1>
                <p class="text-muted mb-4">Connexion au compte de la pharmacie</p>
                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label"></label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="Input.Password" class="form-control" id="password-field-login"
                                   autocomplete="current-password" aria-required="true" />
                            <button class="btn btn-outline-secondary" type="button"
                                    onclick="togglePassword('password-field-login')"
                                    tabindex="-1"
                                    title="Afficher/masquer le mot de passe">
                                <i class="bi bi-eye" id="eye-icon-login"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        <label asp-for="Input.RememberMe" class="form-check-label"></label>
                    </div>

                    <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">Se connecter</button>

                    <div class="mt-3">
                        <p class="mb-1">
                            <a id="forgot-password" asp-page="./ForgotPassword">Mot de passe oublié ?</a>
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
