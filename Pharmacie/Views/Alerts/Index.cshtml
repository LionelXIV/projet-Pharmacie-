@model AlertsIndexViewModel
@{
    ViewData["Title"] = "Alertes";
    var today = Model.Today;
    var horizonOptions = new[] { 7, 30, 90, 180, 365 };
}

<div class="page-header">
    <h1 class="page-title">Alertes</h1>
    <p class="page-lead mb-0">Ruptures, stock faible, lots expirés et péremptions proches (fenêtre <strong>@Model.HorizonDays</strong> jours).</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-danger text-center">
            <div class="card-body py-3">
                <div class="fs-2 fw-bold text-danger">@ViewBag.NbRuptures</div>
                <div class="small text-muted">Ruptures de stock</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-warning text-center">
            <div class="card-body py-3">
                <div class="fs-2 fw-bold text-warning">@ViewBag.NbFaible</div>
                <div class="small text-muted">Stock faible</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-dark text-center">
            <div class="card-body py-3">
                <div class="fs-2 fw-bold">@ViewBag.NbExpires</div>
                <div class="small text-muted">Lots expirés</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center" style="border-color:#F97316 !important">
            <div class="card-body py-3">
                <div class="fs-2 fw-bold" style="color:#F97316">@ViewBag.NbProches</div>
                <div class="small text-muted">Péremptions proches</div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-bold" for="categorieId">Catégorie</label>
                <select name="categorieId" id="categorieId" class="form-select form-select-sm">
                    <option value="">Toutes les catégories</option>
                    @foreach (var cat in Model.Categories)
                    {
                        if (Model.CategorieId == cat.Id)
                        {
                            <option value="@cat.Id" selected>@cat.Name</option>
                        }
                        else
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold" for="horizon">Horizon péremption</label>
                <select name="horizon" id="horizon" class="form-select form-select-sm">
                    @foreach (var h in horizonOptions)
                    {
                        if (Model.HorizonDays == h)
                        {
                            <option value="@h" selected>@h jours</option>
                        }
                        else
                        {
                            <option value="@h">@h jours</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="bi bi-search me-1"></i>Filtrer
                </button>
            </div>
            <div class="col-md-3">
                <a asp-action="ExportAlertesPdf"
                   asp-route-categorieId="@Model.CategorieId"
                   asp-route-horizon="@Model.HorizonDays"
                   class="btn btn-outline-success btn-sm w-100"
                   target="_blank">
                    <i class="bi bi-file-pdf me-1"></i>Exporter PDF
                </a>
            </div>
        </form>
    </div>
</div>

@if (Model.Ruptures.Count > 0)
{
    <div class="card border-danger mb-3">
        <div class="card-header bg-danger text-white d-flex justify-content-between">
            <span>
                <i class="bi bi-x-circle me-1"></i>
                Ruptures de stock (@ViewBag.NbRuptures)
            </span>
        </div>
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>Produit</th>
                        <th>Catégorie</th>
                        <th>Fournisseur</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Ruptures)
                    {
                        <tr>
                            <td class="fw-bold text-danger">@p.CommercialName</td>
                            <td>@(p.Category?.Name ?? "—")</td>
                            <td>@(p.Supplier?.Name ?? "—")</td>
                            <td>
                                <a asp-controller="Products" asp-action="Edit" asp-route-id="@p.Id"
                                   class="btn btn-sm btn-outline-danger py-0 px-2" style="font-size:11px">Ajuster</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (Model.StockFaible.Count > 0)
{
    <div class="card border-warning mb-3">
        <div class="card-header bg-warning text-dark d-flex justify-content-between">
            <span>
                <i class="bi bi-exclamation-triangle me-1"></i>
                Stock faible (@ViewBag.NbFaible)
            </span>
        </div>
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>Produit</th>
                        <th>Catégorie</th>
                        <th class="text-center">Stock actuel</th>
                        <th class="text-center">Seuil alerte</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.StockFaible)
                    {
                        <tr>
                            <td>@p.CommercialName</td>
                            <td>@(p.Category?.Name ?? "—")</td>
                            <td class="text-center fw-bold text-warning">@p.StockQuantity</td>
                            <td class="text-center text-muted">@p.AlertThreshold</td>
                            <td>
                                <a asp-controller="Products" asp-action="Edit" asp-route-id="@p.Id"
                                   class="btn btn-sm btn-outline-warning py-0 px-2" style="font-size:11px">Ajuster</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (Model.LotsExpires.Count > 0)
{
    <div class="card border-dark mb-3">
        <div class="card-header bg-dark text-white">
            <i class="bi bi-slash-circle me-1"></i>
            Lots expirés — à retirer (@ViewBag.NbExpires)
        </div>
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>Produit</th>
                        <th>N° Lot</th>
                        <th class="text-center">Quantité</th>
                        <th>Date expiration</th>
                        <th>Expiré depuis</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.LotsExpires)
                    {
                        var joursEcoules = (today - b.ExpirationDate.Date).Days;
                        <tr>
                            <td class="fw-bold">@(b.Product?.CommercialName ?? "—")</td>
                            <td class="text-muted small">@b.LotNumber</td>
                            <td class="text-center">@b.Quantity</td>
                            <td class="text-danger fw-bold">@b.ExpirationDate.ToString("dd/MM/yyyy")</td>
                            <td class="text-danger small">@joursEcoules j.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (Model.PeremptionsProches.Count > 0)
{
    <div class="card mb-3" style="border-color:#F97316">
        <div class="card-header text-white" style="background:#F97316">
            <i class="bi bi-clock-history me-1"></i>
            Péremptions proches — dans @ViewBag.Horizon jours (@ViewBag.NbProches)
        </div>
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>Produit</th>
                        <th>N° Lot</th>
                        <th class="text-center">Quantité</th>
                        <th>Date expiration</th>
                        <th>Jours restants</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.PeremptionsProches)
                    {
                        var joursRestants = (b.ExpirationDate.Date - today).Days;
                        var couleur = joursRestants <= 30
                            ? "text-danger"
                            : joursRestants <= 60
                                ? "text-warning"
                                : "text-success";
                        <tr>
                            <td>@(b.Product?.CommercialName ?? "—")</td>
                            <td class="text-muted small">@b.LotNumber</td>
                            <td class="text-center">@b.Quantity</td>
                            <td>@b.ExpirationDate.ToString("dd/MM/yyyy")</td>
                            <td class="fw-bold @couleur">@joursRestants j.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (Model.Ruptures.Count == 0 && Model.StockFaible.Count == 0 && Model.LotsExpires.Count == 0 && Model.PeremptionsProches.Count == 0)
{
    <div class="app-empty-state my-3" role="status">
        <i class="bi bi-check-circle text-success" aria-hidden="true"></i>
        <p class="app-empty-state-title mb-1">Aucune alerte</p>
        <p class="mb-0 small">Rien à signaler pour ces critères.</p>
    </div>
}
