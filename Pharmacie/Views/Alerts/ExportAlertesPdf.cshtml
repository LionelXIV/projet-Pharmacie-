@model AlertsIndexViewModel
@{
    Layout = null;
    var today = Model.Today;
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Alertes stock — @today.ToString("dd/MM/yyyy")</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: Arial, sans-serif; font-size: 11px; color: #000; padding: 15mm; }
        .header { text-align: center; margin-bottom: 10px; border-bottom: 2px solid #000; padding-bottom: 8px; }
        .header h1 { font-size: 14px; font-weight: bold; }
        .header h2 { font-size: 12px; margin-top: 4px; }
        .kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin: 10px 0; }
        .kpi-box { border: 1px solid #ccc; padding: 6px; text-align: center; }
        .kpi-value { font-size: 13px; font-weight: bold; }
        .kpi-label { font-size: 9px; color: #666; }
        h3 { font-size: 12px; margin: 12px 0 6px; padding: 4px 6px; color: #fff; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 8px; }
        th { background: #333; color: #fff; padding: 4px 6px; text-align: left; font-size: 10px; }
        td { padding: 3px 6px; border-bottom: 1px solid #eee; font-size: 10px; }
        tr:nth-child(even) { background: #f9f9f9; }
        .text-end { text-align: right; }
        .text-center { text-align: center; }
        .footer { margin-top: 15px; font-size: 9px; color: #666; text-align: center; }
        .no-print { text-align: center; margin-bottom: 15px; }
        @@media print {
            .no-print { display: none !important; }
            @@page { size: A4 portrait; margin: 12mm; }
        }
    </style>
</head>
<body>
    <div class="no-print">
        <button type="button" onclick="window.print()" style="padding:8px 20px;background:#4CAF82;color:white;border:none;border-radius:4px;cursor:pointer;">Imprimer / Enregistrer PDF</button>
        <button type="button" onclick="window.close()" style="padding:8px 20px;background:#ccc;border:none;margin-left:8px;border-radius:4px;cursor:pointer;">Fermer</button>
    </div>

    <div class="header">
        <h1>PHARMACIE SAINT JEAN PAUL II PNR</h1>
        <h2>ALERTES STOCK</h2>
        <div>Horizon péremption : @Model.HorizonDays jours · Généré le @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
    </div>

    <div class="kpi-grid">
        <div class="kpi-box"><div class="kpi-value">@Model.Ruptures.Count</div><div class="kpi-label">Ruptures</div></div>
        <div class="kpi-box"><div class="kpi-value">@Model.StockFaible.Count</div><div class="kpi-label">Stock faible</div></div>
        <div class="kpi-box"><div class="kpi-value">@Model.LotsExpires.Count</div><div class="kpi-label">Lots expirés</div></div>
        <div class="kpi-box"><div class="kpi-value">@Model.PeremptionsProches.Count</div><div class="kpi-label">Péremptions proches</div></div>
    </div>

    @if (Model.Ruptures.Count > 0)
    {
        <h3 style="background:#dc3545">Ruptures de stock (@Model.Ruptures.Count)</h3>
        <table>
            <thead><tr><th>Produit</th><th>Catégorie</th><th>Fournisseur</th></tr></thead>
            <tbody>
            @foreach (var p in Model.Ruptures)
            {
                <tr>
                    <td>@p.CommercialName</td>
                    <td>@(p.Category?.Name ?? "—")</td>
                    <td>@(p.Supplier?.Name ?? "—")</td>
                </tr>
            }
            </tbody>
        </table>
    }

    @if (Model.StockFaible.Count > 0)
    {
        <h3 style="background:#ffc107;color:#000">Stock faible (@Model.StockFaible.Count)</h3>
        <table>
            <thead><tr><th>Produit</th><th>Catégorie</th><th class="text-center">Stock</th><th class="text-center">Seuil</th></tr></thead>
            <tbody>
            @foreach (var p in Model.StockFaible)
            {
                <tr>
                    <td>@p.CommercialName</td>
                    <td>@(p.Category?.Name ?? "—")</td>
                    <td class="text-center">@p.StockQuantity</td>
                    <td class="text-center">@p.AlertThreshold</td>
                </tr>
            }
            </tbody>
        </table>
    }

    @if (Model.LotsExpires.Count > 0)
    {
        <h3 style="background:#111">Lots expirés — à retirer (@Model.LotsExpires.Count)</h3>
        <table>
            <thead><tr><th>Produit</th><th>N° Lot</th><th class="text-center">Qté</th><th>Expiration</th><th>Depuis</th></tr></thead>
            <tbody>
            @foreach (var b in Model.LotsExpires)
            {
                var joursEcoules = (today - b.ExpirationDate.Date).Days;
                <tr>
                    <td>@(b.Product?.CommercialName ?? "—")</td>
                    <td>@b.LotNumber</td>
                    <td class="text-center">@b.Quantity</td>
                    <td>@b.ExpirationDate.ToString("dd/MM/yyyy")</td>
                    <td>@joursEcoules j.</td>
                </tr>
            }
            </tbody>
        </table>
    }

    @if (Model.PeremptionsProches.Count > 0)
    {
        <h3 style="background:#F97316">Péremptions proches — @Model.HorizonDays jours (@Model.PeremptionsProches.Count)</h3>
        <table>
            <thead><tr><th>Produit</th><th>N° Lot</th><th class="text-center">Qté</th><th>Expiration</th><th>Jours restants</th></tr></thead>
            <tbody>
            @foreach (var b in Model.PeremptionsProches)
            {
                var joursRestants = (b.ExpirationDate.Date - today).Days;
                <tr>
                    <td>@(b.Product?.CommercialName ?? "—")</td>
                    <td>@b.LotNumber</td>
                    <td class="text-center">@b.Quantity</td>
                    <td>@b.ExpirationDate.ToString("dd/MM/yyyy")</td>
                    <td>@joursRestants j.</td>
                </tr>
            }
            </tbody>
        </table>
    }

    <div class="footer">Pharmacie Saint Jean Paul II PNR — Document confidentiel</div>
    <script>
        window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 500); });
    </script>
</body>
</html>
