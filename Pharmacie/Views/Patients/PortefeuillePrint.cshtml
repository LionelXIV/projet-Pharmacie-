@model IList<Patient>
@{
    Layout = null;

    (string Nom, string Prenom) SplitName(string fullName)
    {
        var parts = (fullName ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return ("—", "—");
        if (parts.Length == 1) return (parts[0], "—");
        return (string.Join(' ', parts.Skip(1)), parts[0]);
    }
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Portefeuille patients</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: Arial, sans-serif; font-size: 10px; color: #000; padding: 12mm; }
        .header { text-align: center; margin-bottom: 12px; border-bottom: 2px solid #000; padding-bottom: 8px; }
        .header h1 { font-size: 14px; font-weight: bold; }
        .header h2 { font-size: 12px; margin-top: 4px; }
        table { width: 100%; border-collapse: collapse; margin-top: 8px; }
        th, td { border: 1px solid #333; padding: 4px 6px; }
        th { background: #f0f0f0; text-align: left; font-size: 9px; }
        .text-end { text-align: right; }
        .total { margin-top: 10px; font-weight: bold; font-size: 11px; }
        .footer { margin-top: 16px; font-size: 9px; color: #666; text-align: center; }
        .no-print { text-align: center; margin-bottom: 15px; }
        @@media print {
            .no-print { display: none !important; }
            @@page { size: A4 portrait; margin: 10mm; }
        }
    </style>
</head>
<body>
    <div class="no-print">
        <button type="button" onclick="window.print()" style="padding:8px 20px;background:#4CAF82;color:white;border:none;border-radius:4px;cursor:pointer;">Imprimer / PDF</button>
        <button type="button" onclick="window.close()" style="padding:8px 20px;background:#ccc;border:none;margin-left:8px;border-radius:4px;cursor:pointer;">Fermer</button>
    </div>

    <div class="header">
        <h1>PHARMACIE SAINT JEAN PAUL II PNR</h1>
        <h2>PORTEFEUILLE PATIENTS</h2>
        <div>Généré le @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
    </div>

    <table>
        <thead>
            <tr>
                <th style="width:40px">N°</th>
                <th>Nom</th>
                <th>Prénom</th>
                <th>Téléphone</th>
                <th class="text-end">Nb ordonnances</th>
                <th class="text-end">Nb rappels</th>
                <th>Dernière visite</th>
            </tr>
        </thead>
        <tbody>
        @{
            var n = 0;
        }
        @foreach (var p in Model)
        {
            n++;
            var (nom, prenom) = SplitName(p.FullName);
            var lastVisit = p.Prescriptions?.Select(x => (DateTime?)x.PrescribedAt).DefaultIfEmpty().Max();
            <tr>
                <td>@n</td>
                <td>@nom</td>
                <td>@prenom</td>
                <td>@p.Phone</td>
                <td class="text-end">@(p.Prescriptions?.Count ?? 0)</td>
                <td class="text-end">@(p.TreatmentReminders?.Count ?? 0)</td>
                <td>@(lastVisit?.ToString("dd/MM/yyyy") ?? "—")</td>
            </tr>
        }
        </tbody>
    </table>

    <div class="total">Total patients : @Model.Count</div>
    <div class="footer">Pharmacie Saint Jean Paul II PNR — Document confidentiel</div>

    <script>
        if (new URLSearchParams(window.location.search).get('auto') === 'true') {
            window.addEventListener('load', function () {
                setTimeout(function () { window.print(); }, 500);
            });
        }
    </script>
</body>
</html>
