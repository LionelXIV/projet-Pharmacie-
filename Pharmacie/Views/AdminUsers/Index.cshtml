@model IEnumerable<AdminUserRowViewModel>
@using Pharmacie.Authorization
@{
    ViewData["Title"] = "Gestion des utilisateurs";

    string ShortRole(string label) => label switch
    {
        "Pharmacien Titulaire" => "Titulaire",
        "Assistant Pharmacien" => "Assistant",
        "Administrateur" => "Admin",
        _ => label
    };
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" crossorigin="anonymous" />
}

<div class="page-header">
    <div class="d-flex flex-column flex-md-row align-items-md-start justify-content-md-between gap-3">
        <div>
            <h1 class="page-title">Gestion des utilisateurs</h1>
            <p class="page-lead mb-0">Comptes multi-rôles — réservé au Pharmacien Titulaire et au Pharmacien.</p>
        </div>
        <div class="d-flex flex-wrap gap-2 flex-shrink-0">
            @if (User.IsInRole(AppRoles.PharmacienTitulaire) || User.IsInRole(AppRoles.Administrateur))
            {
                <a class="btn btn-outline-secondary" asp-controller="Products" asp-action="PrixModifications">
                    <i class="bi bi-tags me-1" aria-hidden="true"></i>Modifications de prix
                </a>
            }
            <a class="btn btn-primary" asp-action="Create"><i class="bi bi-person-plus me-1" aria-hidden="true"></i>Créer un utilisateur</a>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="app-empty-state my-3" role="status">
        <i class="bi bi-people" aria-hidden="true"></i>
        <p class="app-empty-state-title mb-1">Aucun utilisateur</p>
        <p class="mb-0 small">Créez un compte pour permettre la connexion au système.</p>
        <a class="btn btn-primary btn-sm mt-3" asp-action="Create"><i class="bi bi-person-plus me-1" aria-hidden="true"></i>Créer un utilisateur</a>
    </div>
}
else
{
    <div class="table-card mb-3">
        <div class="table-responsive">
            <table class="table table-striped table-sm align-middle mb-0 js-datatable">
                <thead>
                    <tr>
                        <th style="width:100px">Actions</th>
                        <th>Identifiant</th>
                        <th class="d-none d-lg-table-cell">Email</th>
                        <th>Rôles</th>
                        <th class="d-none d-lg-table-cell">Connexion</th>
                        <th class="d-none d-xl-table-cell">État</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit"
                                       asp-route-id="@u.Id"
                                       class="btn btn-outline-primary"
                                       title="Modifier">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="DeleteWithReport"
                                       asp-route-id="@u.Id"
                                       class="btn btn-outline-danger"
                                       title="Supprimer avec rapport">
                                        <i class="bi bi-trash3"></i>
                                    </a>
                                </div>
                            </td>
                            <td class="fw-semibold">@u.DisplayName</td>
                            <td class="small d-none d-lg-table-cell">@u.Email</td>
                            <td>
                                @if (u.RoleLabels != null && u.RoleLabels.Count > 0)
                                {
                                    @foreach (var label in u.RoleLabels)
                                    {
                                        <span class="badge bg-primary me-1 mb-1">@ShortRole(label)</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="d-none d-lg-table-cell">
                                @if (u.LoginType == "PIN")
                                {
                                    <span class="badge bg-info text-dark">PIN</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Email</span>
                                }
                            </td>
                            <td class="d-none d-xl-table-cell">
                                @if (u.IsLockedOut)
                                {
                                    <span class="badge bg-danger">Verrouillé</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Actif</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<p class="text-muted small mb-0">
    L'inscription publique est désactivée : seuls les comptes créés ici (ou existants) peuvent se connecter.
</p>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js" crossorigin="anonymous"></script>
    <script>
      $(function () {
        $('.js-datatable').each(function () {
          if ($.fn.DataTable.isDataTable(this)) {
            return;
          }

          $(this).DataTable({
            language: {
              url: 'https://cdn.datatables.net/plug-ins/1.13.8/i18n/fr-FR.json'
            },
            pageLength: 25,
            lengthMenu: [10, 25, 50],
            order: []
          });
        });
      });
    </script>
}
