@model UserActivityReport
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rapport utilisateur — @Model.DeletedUserDisplayName</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: Arial, sans-serif; font-size: 11px; color: #000; padding: 15mm; }
        .header { text-align: center; margin-bottom: 12px; border-bottom: 2px solid #000; padding-bottom: 8px; }
        .header h1 { font-size: 14px; font-weight: bold; }
        .header h2 { font-size: 12px; margin-top: 4px; }
        .kpi-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin: 12px 0; }
        .kpi-box { border: 1px solid #ccc; padding: 8px; text-align: center; }
        .kpi-value { font-size: 13px; font-weight: bold; }
        .kpi-label { font-size: 9px; color: #666; }
        .info { margin: 10px 0; border: 1px solid #ddd; padding: 8px; }
        .info div { margin: 3px 0; }
        .note { margin-top: 12px; padding: 8px; border: 1px dashed #999; font-size: 10px; text-align: center; }
        .footer { margin-top: 16px; font-size: 9px; color: #666; text-align: center; }
        .no-print { text-align: center; margin-bottom: 15px; }
        @@media print {
            .no-print { display: none !important; }
            @@page { size: A4 portrait; margin: 12mm; }
        }
    </style>
</head>
<body>
    <div class="no-print">
        <button type="button" onclick="window.print()" style="padding:8px 20px;background:#4CAF82;color:white;border:none;border-radius:4px;cursor:pointer;">Imprimer / PDF</button>
        <button type="button" onclick="window.close()" style="padding:8px 20px;background:#ccc;border:none;margin-left:8px;border-radius:4px;cursor:pointer;">Fermer</button>
    </div>

    <div class="header">
        <h1>PHARMACIE SAINT JEAN PAUL II PNR</h1>
        <h2>RAPPORT D'ACTIVITÉ — UTILISATEUR SUPPRIMÉ</h2>
        <div>Généré le @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
    </div>

    <div class="info">
        <div><strong>Identifiant :</strong> @Model.DeletedUserDisplayName</div>
        <div><strong>Email :</strong> @Model.DeletedUserEmail</div>
        <div><strong>Rôle :</strong> @Model.DeletedUserRole</div>
        <div><strong>Type de connexion :</strong> @Model.DeletedUserConnectionType</div>
        <div><strong>Supprimé par :</strong> @Model.DeletedByDisplayName</div>
        <div><strong>Date de suppression :</strong> @Model.DeletedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
    </div>

    <div class="kpi-grid">
        <div class="kpi-box">
            <div class="kpi-value">@Model.TotalSales</div>
            <div class="kpi-label">Nb ventes</div>
        </div>
        <div class="kpi-box">
            <div class="kpi-value">@Model.TotalSalesAmount.ToString("N0") F</div>
            <div class="kpi-label">CA total</div>
        </div>
        <div class="kpi-box">
            <div class="kpi-value">@Model.TotalStockMovements</div>
            <div class="kpi-label">Nb mouvements</div>
        </div>
        <div class="kpi-box">
            <div class="kpi-value">@(Model.FirstActivityDate?.ToLocalTime().ToString("dd/MM/yyyy") ?? "—")</div>
            <div class="kpi-label">Première activité</div>
        </div>
        <div class="kpi-box">
            <div class="kpi-value">@(Model.LastActivityDate?.ToLocalTime().ToString("dd/MM/yyyy") ?? "—")</div>
            <div class="kpi-label">Dernière activité</div>
        </div>
        <div class="kpi-box">
            <div class="kpi-value">@Model.TotalPurchaseOrders / @Model.TotalGoodsReceipts</div>
            <div class="kpi-label">Commandes / BL</div>
        </div>
    </div>

    <div class="note">Document archivé — activité de l'utilisateur avant suppression du compte.</div>
    <div class="footer">Pharmacie Saint Jean Paul II PNR — Document confidentiel</div>

    <script>
        if (new URLSearchParams(window.location.search).get('auto') === 'true') {
            window.addEventListener('load', function () {
                setTimeout(function () { window.print(); }, 500);
            });
        }
    </script>
</body>
</html>
