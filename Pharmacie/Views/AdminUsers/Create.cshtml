@model AdminUserCreateViewModel
@using Pharmacie.Authorization
@{
    ViewData["Title"] = "Créer un utilisateur";
    var roleChoices = ViewBag.Roles as List<RoleChoixViewModel> ?? new List<RoleChoixViewModel>();
    var titulaireChecked = Model.RolesSelectionnes?.Contains(AppRoles.PharmacienTitulaire) == true;
    var anyRole = Model.RolesSelectionnes?.Count > 0;
    var showAdmin = titulaireChecked;
    var showQuick = anyRole && !titulaireChecked;
}

@await Html.PartialAsync("_BackButton")

<div class="page-header">
    <h1 class="page-title">Créer un utilisateur</h1>
    <nav class="app-breadcrumb mt-2 mb-0 d-inline-block" aria-label="Navigation">
        <a asp-action="Index"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Utilisateurs</a>
    </nav>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 border-bottom d-flex align-items-center gap-2">
                <i class="bi bi-person-plus text-primary fs-5" aria-hidden="true"></i>
                <span class="fw-semibold">Compte et rôles</span>
            </div>
            <div class="card-body p-3 p-md-4">
                <form asp-action="Create" method="post" id="create-user-form">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">
                            Rôles *
                            <small class="text-muted fw-normal">(plusieurs choix possibles)</small>
                        </label>
                        <div class="row g-2">
                            @foreach (var role in roleChoices)
                            {
                                <div class="col-md-6">
                                    <div class="card border h-100">
                                        <div class="card-body py-2">
                                            <div class="form-check">
                                                <input type="checkbox"
                                                       name="RolesSelectionnes"
                                                       value="@role.Nom"
                                                       id="role-@role.Nom"
                                                       class="form-check-input role-choice"
                                                       data-titulaire="@(role.Nom == AppRoles.PharmacienTitulaire ? "true" : "false")"
                                                       @(role.Selectionne || (Model.RolesSelectionnes?.Contains(role.Nom) == true) ? "checked" : null) />
                                                <label class="form-check-label fw-bold" for="role-@role.Nom">
                                                    @role.Label
                                                </label>
                                                <div class="text-muted small">@role.Description</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        <span asp-validation-for="RolesSelectionnes" class="text-danger"></span>
                        <div class="form-text">Au moins un rôle est obligatoire. Le Pharmacien Titulaire utilise email + mot de passe ; les autres rôles utilisent un code PIN.</div>
                    </div>

                    <div id="admin-fields" class="@(showAdmin ? "" : "d-none")">
                        <p class="form-section-title">Compte Pharmacien Titulaire</p>
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" autocomplete="off" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="DisplayName" class="form-label">Identifiant affiché</label>
                            <input asp-for="DisplayName" class="form-control" autocomplete="off" />
                            <span asp-validation-for="DisplayName" class="text-danger"></span>
                            <div class="form-text">Ex. : DrDiallo — visible dans l'historique des ventes.</div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="Password" class="form-control" id="password-field-create"
                                       autocomplete="new-password" />
                                <button class="btn btn-outline-secondary" type="button"
                                        onclick="togglePassword('password-field-create')"
                                        tabindex="-1"
                                        title="Afficher/masquer le mot de passe">
                                    <i class="bi bi-eye" id="eye-icon-create"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="ConfirmPassword" class="form-control" id="password-field-create-confirm"
                                       autocomplete="new-password" />
                                <button class="btn btn-outline-secondary" type="button"
                                        onclick="togglePassword('password-field-create-confirm')"
                                        tabindex="-1"
                                        title="Afficher/masquer le mot de passe">
                                    <i class="bi bi-eye" id="eye-icon-create-confirm"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>

                    <div id="quick-fields" class="@(showQuick ? "" : "d-none")">
                        <p class="form-section-title">Connexion rapide (PIN)</p>
                        <div class="mb-3">
                            <label class="form-label" for="QuickDisplayName">Identifiant</label>
                            <input class="form-control" id="QuickDisplayName" autocomplete="off"
                                   value="@Model.DisplayName" />
                            <div class="form-text">Ex. : Fatou — prénom ou pseudo pour la connexion PIN.</div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Pin" class="form-label"></label>
                            <input asp-for="Pin" class="form-control" type="tel" inputmode="numeric"
                                   maxlength="4" pattern="[0-9]{4}" autocomplete="off" />
                            <span asp-validation-for="Pin" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ConfirmPin" class="form-label"></label>
                            <input asp-for="ConfirmPin" class="form-control" type="tel" inputmode="numeric"
                                   maxlength="4" pattern="[0-9]{4}" autocomplete="off" />
                            <span asp-validation-for="ConfirmPin" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2 pt-2 border-top">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1" aria-hidden="true"></i>Créer</button>
                        <a class="btn btn-outline-secondary" asp-action="Index">Annuler</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
(function () {
  var adminSection = document.getElementById('admin-fields');
  var quickSection = document.getElementById('quick-fields');
  var adminDisplay = adminSection.querySelector('[name="DisplayName"]');
  var quickDisplay = document.getElementById('QuickDisplayName');
  var titulaireValue = '@AppRoles.PharmacienTitulaire';

  function setDisabled(section, disabled) {
    section.querySelectorAll('input, select, textarea').forEach(function (el) {
      el.disabled = disabled;
    });
  }

  function selectedRoles() {
    return Array.prototype.slice.call(document.querySelectorAll('.role-choice:checked'))
      .map(function (el) { return el.value; });
  }

  function syncRoleFields() {
    var roles = selectedRoles();
    var isTitulaire = roles.indexOf(titulaireValue) !== -1;
    var any = roles.length > 0;

    if (isTitulaire) {
      adminSection.classList.remove('d-none');
      quickSection.classList.add('d-none');
      setDisabled(adminSection, false);
      setDisabled(quickSection, true);
    } else if (any) {
      adminSection.classList.add('d-none');
      quickSection.classList.remove('d-none');
      setDisabled(adminSection, true);
      setDisabled(quickSection, false);
      adminDisplay.disabled = false;
      adminDisplay.value = quickDisplay.value;
    } else {
      adminSection.classList.add('d-none');
      quickSection.classList.add('d-none');
      setDisabled(adminSection, true);
      setDisabled(quickSection, true);
    }
  }

  quickDisplay.addEventListener('input', function () {
    var roles = selectedRoles();
    if (roles.length && roles.indexOf(titulaireValue) === -1) {
      adminDisplay.disabled = false;
      adminDisplay.value = quickDisplay.value;
    }
  });

  document.getElementById('create-user-form').addEventListener('submit', function () {
    var roles = selectedRoles();
    if (roles.length && roles.indexOf(titulaireValue) === -1) {
      adminDisplay.disabled = false;
      adminDisplay.value = quickDisplay.value;
    }
  });

  document.querySelectorAll('.role-choice').forEach(function (cb) {
    cb.addEventListener('change', syncRoleFields);
  });

  syncRoleFields();
})();
    </script>
}
