@model AdminUserEditViewModel
@using Pharmacie.Authorization
@{
    ViewData["Title"] = "Modifier un utilisateur";
    var roleChoices = ViewBag.Roles as List<RoleChoixViewModel> ?? new List<RoleChoixViewModel>();
}

@await Html.PartialAsync("_BackButton")

<div class="page-header">
    <h1 class="page-title">Modifier un utilisateur</h1>
    <nav class="app-breadcrumb mt-2 mb-0 d-inline-block" aria-label="Navigation">
        <a asp-action="Index"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Utilisateurs</a>
    </nav>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 border-bottom d-flex align-items-center gap-2">
                <i class="bi bi-person-gear text-primary fs-5" aria-hidden="true"></i>
                <span class="fw-semibold">Profil et sécurité</span>
            </div>
            <div class="card-body p-3 p-md-4">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="IsPinLogin" />
                    <input type="hidden" asp-for="IsTitulaireAccount" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Adresse email</label>
                        <input asp-for="Email" class="form-control" readonly />
                        <span class="form-text">L’email ne peut pas être modifié ici.</span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DisplayName" class="form-label"></label>
                        <input asp-for="DisplayName" class="form-control" autocomplete="off" />
                        <span asp-validation-for="DisplayName" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">
                            Rôles *
                            <small class="text-muted fw-normal">(plusieurs choix possibles)</small>
                        </label>
                        <div class="row g-2">
                            @foreach (var role in roleChoices)
                            {
                                var isChecked = role.Selectionne || (Model.RolesSelectionnes?.Contains(role.Nom) == true);
                                <div class="col-md-6">
                                    <div class="card border h-100">
                                        <div class="card-body py-2">
                                            <div class="form-check">
                                                <input type="checkbox"
                                                       name="RolesSelectionnes"
                                                       value="@role.Nom"
                                                       id="role-@role.Nom"
                                                       class="form-check-input"
                                                       @(isChecked ? "checked" : null) />
                                                <label class="form-check-label fw-bold" for="role-@role.Nom">
                                                    @role.Label
                                                </label>
                                                <div class="text-muted small">@role.Description</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        <span asp-validation-for="RolesSelectionnes" class="text-danger"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="AccountLocked" class="form-check-input" />
                        <label asp-for="AccountLocked" class="form-check-label"></label>
                        <span asp-validation-for="AccountLocked" class="text-danger d-block"></span>
                    </div>

                    @if (Model.IsTitulaireAccount)
                    {
                        <p class="form-section-title">Réinitialisation du mot de passe</p>
                        <p class="text-muted small">Laisser vide pour ne pas changer. Compte Pharmacien Titulaire : connexion email.</p>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="NewPassword" class="form-control" id="password-field-edit"
                                       autocomplete="new-password" />
                                <button class="btn btn-outline-secondary" type="button"
                                        onclick="togglePassword('password-field-edit')"
                                        tabindex="-1"
                                        title="Afficher/masquer le mot de passe">
                                    <i class="bi bi-eye" id="eye-icon-edit"></i>
                                </button>
                            </div>
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmNewPassword" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="ConfirmNewPassword" class="form-control" id="password-field-edit-confirm"
                                       autocomplete="new-password" />
                                <button class="btn btn-outline-secondary" type="button"
                                        onclick="togglePassword('password-field-edit-confirm')"
                                        tabindex="-1"
                                        title="Afficher/masquer le mot de passe">
                                    <i class="bi bi-eye" id="eye-icon-edit-confirm"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
                        </div>
                    }
                    else
                    {
                        <p class="form-section-title">Réinitialisation du code PIN</p>
                        <p class="text-muted small">Laisser vide pour ne pas changer.</p>

                        <div class="mb-3">
                            <label asp-for="NewPin" class="form-label"></label>
                            <input asp-for="NewPin" class="form-control" type="tel" inputmode="numeric"
                                   maxlength="4" pattern="[0-9]{4}" autocomplete="off" />
                            <span asp-validation-for="NewPin" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmNewPin" class="form-label"></label>
                            <input asp-for="ConfirmNewPin" class="form-control" type="tel" inputmode="numeric"
                                   maxlength="4" pattern="[0-9]{4}" autocomplete="off" />
                            <span asp-validation-for="ConfirmNewPin" class="text-danger"></span>
                        </div>
                    }

                    <div class="d-flex flex-wrap gap-2 pt-2 border-top">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1" aria-hidden="true"></i>Enregistrer</button>
                        <a class="btn btn-outline-secondary" asp-action="Index">Annuler</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
