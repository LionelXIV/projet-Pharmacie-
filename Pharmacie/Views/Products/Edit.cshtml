@model Product
@{
    ViewData["Title"] = "Modifier le produit";
}

@await Html.PartialAsync("_BackButton")

<div class="page-header">
    <h1 class="page-title">Modifier le produit</h1>
    <p class="page-lead mb-0">Mettez à jour la fiche ; le stock est aussi piloté par les lots et mouvements.</p>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 border-bottom d-flex align-items-center gap-2">
                <i class="bi bi-pencil-square text-primary fs-5" aria-hidden="true"></i>
                <span class="fw-semibold">Fiche produit</span>
            </div>
            <div class="card-body p-3 p-md-4">
                <form asp-action="Edit">
                    <partial name="_ProductForm" model="Model" />
                    @if (AppRoles.IsTitulaire(User) || User.IsInRole(AppRoles.Pharmacien))
                    {
                        <div class="card border-warning mt-3">
                            <div class="card-header bg-warning text-dark fw-bold">
                                <i class="bi bi-boxes me-1" aria-hidden="true"></i>
                                Ajustement de stock
                            </div>
                            <div class="card-body">
                                <div class="alert alert-info py-2 mb-3">
                                    <small>
                                        Stock actuel : <strong>@Model.StockQuantity unités</strong>
                                        — L'ajustement crée un mouvement de stock tracé.
                                        Préférez les lots pour les entrées normales.
                                    </small>
                                </div>
                                <div class="row g-2">
                                    <div class="col-md-4">
                                        <label class="form-label fw-bold" for="ajustement-stock">Nouvelle quantité</label>
                                        <input type="number"
                                               name="ajustementStock"
                                               id="ajustement-stock"
                                               class="form-control"
                                               min="0"
                                               placeholder="Ex: 50" />
                                        <div class="form-text">Laisser vide pour ne pas modifier le stock.</div>
                                    </div>
                                    <div class="col-md-8">
                                        <label class="form-label fw-bold" for="ajustement-raison">Raison de l'ajustement *</label>
                                        <input type="text"
                                               name="ajustementRaison"
                                               id="ajustement-raison"
                                               class="form-control"
                                               placeholder="Ex: Correction après inventaire"
                                               maxlength="200" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    <div class="mt-4 pt-3 border-top d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1" aria-hidden="true"></i>Enregistrer</button>
                        <a class="btn btn-outline-secondary" asp-action="Index">Annuler</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
    (function () {
      var tarifInfos = {
        0: "Prix public fixé (PPH). Prix de vente = PPH. Exonéré de TVA.",
        1: "Consommable. Prix de vente = Prix achat × 1.436. TVA 18% incluse dans le coefficient.",
        2: "Parapharmacie sans TVA. Prix de vente = Prix achat × 1.5. Exonéré de TVA.",
        3: "Parapharmacie avec TVA. Prix de vente = Prix achat × 1.5 + 18%. TVA collectée à déclarer."
      };

      function updateTarifInfo(select) {
        var el = document.getElementById('tarif-info');
        if (el) el.textContent = tarifInfos[select.value] || "";
      }

      function previewSalePrice() {
        var type = parseInt(document.getElementById('tarif-type-select')?.value || '0', 10);
        var pa = parseFloat(document.getElementById('purchase-price-input')?.value || '0') || 0;
        var saleInput = document.getElementById('sale-price-input');
        if (!saleInput || pa <= 0) return;
        if (type === 1) saleInput.value = Math.round(pa * 1.436);
        else if (type === 2) saleInput.value = Math.round(pa * 1.5);
        else if (type === 3) saleInput.value = Math.round(pa * 1.5 * 1.18);
      }

      document.addEventListener('DOMContentLoaded', function () {
        var sel = document.getElementById('tarif-type-select');
        if (!sel) return;
        updateTarifInfo(sel);
        sel.addEventListener('change', function () {
          updateTarifInfo(sel);
          previewSalePrice();
        });
        var pa = document.getElementById('purchase-price-input');
        if (pa) pa.addEventListener('input', previewSalePrice);
      });
    })();
    </script>
}
