@model IList<Product>
@{
    ViewData["Title"] = "Anomalies produits";
    var filtre = ViewBag.Filtre as string;
    var total = (int)(ViewBag.TotalAnomalies ?? 0);
    var page = (int)(ViewBag.Page ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalFiltered = (int)(ViewBag.Total ?? Model.Count);
    var categories = ViewBag.Categories as IEnumerable<Category>
        ?? Enumerable.Empty<Category>();

    string TypeLabel(ProductType type) => type switch
    {
        ProductType.Medicament => "Médicament",
        ProductType.Parapharmacie => "Parapharmacie",
        _ => "Inconnu"
    };

    bool IsSansCategorie(Product p) =>
        p.Category != null && p.Category.Name == "À catégoriser";
}

@await Html.PartialAsync("_BackButton")

<div class="page-header d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h1 class="page-title">Anomalies produits</h1>
        <p class="page-lead mb-0">
            Cliquez un badge pour filtrer. Corrigez directement dans le tableau
            (listes + Valider). Les tablettes (vente détail) sont indiquées.
        </p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
    </div>
}

<div class="row g-2 mb-3">
    <div class="col-auto">
        <a asp-action="Anomalies" asp-route-filtre="prixvente"
           class="badge bg-danger fs-6 text-decoration-none"
           title="Filtrer : sans prix de vente">
            @ViewBag.PrixVenteZero sans prix de vente
        </a>
    </div>
    <div class="col-auto">
        <a asp-action="Anomalies" asp-route-filtre="prixachat"
           class="badge bg-danger fs-6 text-decoration-none"
           title="Filtrer : sans prix d'achat">
            @ViewBag.PrixAchatZero sans prix d'achat
        </a>
    </div>
    <div class="col-auto">
        <a asp-action="Anomalies" asp-route-filtre="type"
           class="badge bg-warning text-dark fs-6 text-decoration-none"
           title="Filtrer : type inconnu">
            @ViewBag.TypeInconnu type inconnu
        </a>
    </div>
    <div class="col-auto">
        <a asp-action="Anomalies" asp-route-filtre="seuil"
           class="badge bg-secondary fs-6 text-decoration-none"
           title="Filtrer : sans seuil d'alerte">
            @ViewBag.SeuilZero sans seuil d'alerte
        </a>
    </div>
    <div class="col-auto">
        <a asp-action="Anomalies" asp-route-filtre="categorie"
           class="badge bg-info fs-6 text-decoration-none"
           title="Filtrer : sans catégorie">
            @ViewBag.SansCategorie sans catégorie
        </a>
    </div>
</div>

<div class="d-flex gap-2 mb-3 flex-wrap">
    <a asp-action="Anomalies"
       class="btn btn-sm @(string.IsNullOrEmpty(filtre) ? "btn-secondary" : "btn-outline-secondary")">
        Tous (@total)
    </a>
    <a asp-action="Anomalies"
       asp-route-filtre="prixvente"
       class="btn btn-sm @(filtre is "prixvente" or "prix" ? "btn-danger" : "btn-outline-danger")">
        Prix vente = 0
    </a>
    <a asp-action="Anomalies"
       asp-route-filtre="prixachat"
       class="btn btn-sm @(filtre == "prixachat" ? "btn-danger" : "btn-outline-danger")">
        Prix achat = 0
    </a>
    <a asp-action="Anomalies"
       asp-route-filtre="type"
       class="btn btn-sm @(filtre == "type" ? "btn-warning" : "btn-outline-warning")">
        Type inconnu
    </a>
    <a asp-action="Anomalies"
       asp-route-filtre="seuil"
       class="btn btn-sm @(filtre == "seuil" ? "btn-secondary" : "btn-outline-secondary")">
        Seuil = 0
    </a>
    <a asp-action="Anomalies"
       asp-route-filtre="categorie"
       class="btn btn-sm @(filtre == "categorie" ? "btn-info" : "btn-outline-info")">
        Sans catégorie
    </a>
</div>

<form asp-action="CorrigerGroupeAnomalie" method="post" id="form-groupe">
    @Html.AntiForgeryToken()
    <input type="hidden" name="filtre" value="@filtre" />
</form>

<div class="card border-warning mb-3" id="barre-groupe" style="display:none">
    <div class="card-body py-2 d-flex gap-3 align-items-center flex-wrap">
        <span class="fw-bold">
            Action groupée sur
            <span id="nb-selectionnes">0</span>
            produit(s) :
        </span>
        <select name="champAcorriger" form="form-groupe"
                class="form-select form-select-sm" style="width:180px"
                id="champ-select" onchange="updateValeurOptions(this.value)">
            <option value="">Choisir le champ...</option>
            <option value="ProductType">Type de produit</option>
            <option value="CategoryId">Catégorie</option>
            <option value="AlertThreshold">Seuil d'alerte</option>
            <option value="TarifType">Tarification TVA</option>
        </select>
        <select name="nouvelleValeur" form="form-groupe"
                class="form-select form-select-sm" style="width:220px" id="valeur-select">
            <option value="">Choisir la valeur...</option>
        </select>
        <button type="submit" form="form-groupe" class="btn btn-warning btn-sm"
                onclick="return confirm('Appliquer cette correction à tous les produits sélectionnés ?');">
            <i class="bi bi-check-lg me-1"></i>Appliquer
        </button>
        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="deselectionnerTout()">
            Tout désélectionner
        </button>
    </div>
</div>

<div class="table-responsive card border-0 shadow-sm">
    <table class="table table-sm table-hover align-middle mb-0">
        <thead class="table-dark">
            <tr>
                <th style="width:36px">
                    <input type="checkbox" id="select-all" onchange="toggleAll(this)" title="Tout sélectionner" />
                </th>
                <th>Nom</th>
                <th>CIP</th>
                <th>Prix achat</th>
                <th>Prix vente</th>
                <th>Type</th>
                <th>Catégorie</th>
                <th>Seuil</th>
                <th>Anomalies</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="10" class="text-muted text-center py-4">Aucune anomalie pour ce filtre.</td>
            </tr>
        }
        else
        {
            foreach (var item in Model)
            {
                var sansCat = IsSansCategorie(item);
                var formId = "ligne-" + item.Id;
                <tr>
                    <td>
                        <input type="checkbox" name="productIds" value="@item.Id"
                               class="product-cb" form="form-groupe" onchange="updateBarre()" />
                    </td>
                    <td>
                        <div class="fw-medium">@item.CommercialName</div>
                        @if (item.ParentProductId.HasValue)
                        {
                            <div class="small text-primary">
                                <i class="bi bi-diagram-2"></i> Tablette
                                @if (item.ParentProduct != null)
                                {
                                    <span class="text-muted">← @item.ParentProduct.CommercialName</span>
                                }
                            </div>
                        }
                        else if (item.EstVenteDetail)
                        {
                            <div class="small text-success">
                                <i class="bi bi-box-seam"></i> Boîte (vente détail)
                            </div>
                        }
                    </td>
                    <td class="small font-monospace">@(string.IsNullOrWhiteSpace(item.Cip) ? "—" : item.Cip)</td>

                    <td>
                        @if (item.PurchasePrice == 0)
                        {
                            <input type="number" name="purchasePrice" form="@formId"
                                   class="form-control form-control-sm border-danger"
                                   min="0" step="1" value="0" style="width:6.5rem"
                                   title="Prix d'achat" />
                        }
                        else
                        {
                            @item.PurchasePrice.ToString("N0") <span class="text-muted">F</span>
                            <input type="hidden" name="purchasePrice" form="@formId"
                                   value="@item.PurchasePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                        }
                    </td>
                    <td>
                        @if (item.SalePrice == 0)
                        {
                            <input type="number" name="salePrice" form="@formId"
                                   class="form-control form-control-sm border-danger"
                                   min="0" step="1" value="0" style="width:6.5rem"
                                   title="Prix de vente" />
                        }
                        else
                        {
                            @item.SalePrice.ToString("N0") <span class="text-muted">F</span>
                            <input type="hidden" name="salePrice" form="@formId"
                                   value="@item.SalePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                        }
                    </td>
                    <td>
                        @if (item.ProductType == ProductType.Inconnu)
                        {
                            <select name="productType" form="@formId" class="form-select form-select-sm border-warning" style="min-width:8rem">
                                <option value="Inconnu" selected>Inconnu</option>
                                <option value="Medicament">Médicament</option>
                                <option value="Parapharmacie">Parapharmacie</option>
                            </select>
                        }
                        else
                        {
                            @TypeLabel(item.ProductType)
                            <input type="hidden" name="productType" form="@formId" value="@item.ProductType" />
                        }
                    </td>
                    <td>
                        @if (sansCat)
                        {
                            <select name="categoryId" form="@formId" class="form-select form-select-sm border-info" style="min-width:9rem">
                                <option value="">— Choisir —</option>
                                @foreach (var c in categories)
                                {
                                    if (c.Name == "À catégoriser")
                                    {
                                        <option value="@c.Id" selected>@c.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                }
                            </select>
                        }
                        else
                        {
                            @(item.Category?.Name ?? "—")
                            <input type="hidden" name="categoryId" form="@formId" value="@item.CategoryId" />
                        }
                    </td>
                    <td>
                        @if (item.AlertThreshold == 0)
                        {
                            <select name="alertThreshold" form="@formId" class="form-select form-select-sm" style="width:4.5rem">
                                <option value="0" selected>0</option>
                                <option value="5">5</option>
                                <option value="10">10</option>
                                <option value="20">20</option>
                                <option value="50">50</option>
                            </select>
                        }
                        else
                        {
                            @item.AlertThreshold
                            <input type="hidden" name="alertThreshold" form="@formId" value="@item.AlertThreshold" />
                        }
                    </td>
                    <td>
                        @if (item.SalePrice == 0)
                        {
                            <span class="badge bg-danger">PV=0</span>
                        }
                        @if (item.PurchasePrice == 0)
                        {
                            <span class="badge bg-danger">PA=0</span>
                        }
                        @if (item.ProductType == ProductType.Inconnu)
                        {
                            <span class="badge bg-warning text-dark">Type</span>
                        }
                        @if (item.AlertThreshold == 0)
                        {
                            <span class="badge bg-secondary">Seuil</span>
                        }
                        @if (sansCat)
                        {
                            <span class="badge bg-info">Catégorie</span>
                        }
                    </td>
                    <td class="text-nowrap">
                        <form asp-action="CorrigerLigneAnomalie" method="post" id="@formId" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@item.Id" />
                            <input type="hidden" name="filtre" value="@filtre" />
                            <input type="hidden" name="page" value="@(page)" />
                            <button type="submit" class="btn btn-sm btn-success" title="Valider les corrections">
                                <i class="bi bi-check-lg"></i> Valider
                            </button>
                        </form>
                        <a asp-action="Edit" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-secondary" title="Fiche complète">
                            <i class="bi bi-pencil"></i>
                        </a>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>

@if (totalPages > 1)
{
    <nav aria-label="Pagination anomalies" class="mt-3">
        <ul class="pagination pagination-sm mb-0">
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == page ? "active" : "")">
                    <a class="page-link"
                       asp-action="Anomalies"
                       asp-route-page="@i"
                       asp-route-filtre="@filtre">
                        @i
                    </a>
                </li>
            }
        </ul>
    </nav>
    <p class="text-muted small mt-2 mb-0">Page @(page) / @totalPages — @totalFiltered résultat(s)</p>
}

<script>
var categoriesOptions = [
@foreach (var c in categories)
{
    @: { v: '@c.Id', l: '@Html.Raw(c.Name.Replace("\\", "\\\\").Replace("'", "\\'"))' },
}
];

var optionsParChamp = {
    ProductType: [
        { v: 'Medicament', l: 'Médicament' },
        { v: 'Parapharmacie', l: 'Parapharmacie' },
        { v: 'Inconnu', l: 'Inconnu' }
    ],
    TarifType: [
        { v: '0', l: 'Prix public PPH' },
        { v: '1', l: 'Consommable ×1.436' },
        { v: '2', l: 'Parapharmacie sans TVA' },
        { v: '3', l: 'Parapharmacie avec TVA' },
        { v: '4', l: 'PPH avec TVA 18%' }
    ],
    AlertThreshold: [
        { v: '5', l: 'Seuil = 5' },
        { v: '10', l: 'Seuil = 10' },
        { v: '20', l: 'Seuil = 20' },
        { v: '50', l: 'Seuil = 50' }
    ],
    CategoryId: categoriesOptions
};

function updateValeurOptions(champ) {
    var sel = document.getElementById('valeur-select');
    sel.innerHTML = '<option value="">Valeur...</option>';
    if (optionsParChamp[champ]) {
        optionsParChamp[champ].forEach(function (o) {
            sel.innerHTML += '<option value="' + o.v + '">' + o.l + '</option>';
        });
    }
}

function toggleAll(cb) {
    document.querySelectorAll('.product-cb').forEach(function (c) { c.checked = cb.checked; });
    updateBarre();
}

function updateBarre() {
    var nb = document.querySelectorAll('.product-cb:checked').length;
    document.getElementById('nb-selectionnes').textContent = nb;
    document.getElementById('barre-groupe').style.display = nb > 0 ? 'block' : 'none';
}

function deselectionnerTout() {
    document.querySelectorAll('.product-cb').forEach(function (c) { c.checked = false; });
    document.getElementById('select-all').checked = false;
    updateBarre();
}
</script>
