@model IReadOnlyList<ReportStockStatusRowViewModel>
@using Pharmacie.Authorization
@{
    ViewData["Title"] = "Rapport — État du stock";
    var showValeurStock = AppRoles.IsTitulaire(User)
        || User.IsInRole(AppRoles.Pharmacien)
        || User.IsInRole(AppRoles.Comptable);
    var valeurPa = ViewBag.ValeurStockPA as decimal? ?? 0m;
    var valeurPv = ViewBag.ValeurStockPV as decimal? ?? 0m;
    var marge = ViewBag.MargePotentielle as decimal? ?? 0m;
    var nbEnStock = ViewBag.NbProduitsEnStock as int? ?? 0;
    var nbRupture = ViewBag.NbRupture as int? ?? 0;
}

@await Html.PartialAsync("_BackButton")

<nav class="app-breadcrumb mb-3" aria-label="Fil d’Ariane">
    <ol class="breadcrumb mb-0 py-1">
        <li class="breadcrumb-item"><a asp-action="Index">Rapports</a></li>
        <li class="breadcrumb-item active" aria-current="page">État du stock</li>
    </ol>
</nav>

<div class="page-header">
    <h1 class="page-title">État du stock</h1>
    <p class="page-lead mb-0">Produits <strong>actifs</strong> uniquement. Statut : <span class="badge bg-success">Normal</span> stock &gt; seuil, <span class="badge bg-warning text-dark">Stock faible</span> ≤ seuil, <span class="badge bg-danger">Rupture</span> = 0.</p>
</div>

@if (showValeurStock)
{
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-3 p-3 bg-primary bg-opacity-10">
                            <i class="bi bi-box-seam fs-4 text-primary" aria-hidden="true"></i>
                        </div>
                        <div>
                            <div class="fs-5 fw-bold text-primary">@valeurPa.ToString("N0") FCFA</div>
                            <div class="text-muted small">Valeur stock (prix d'achat)</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-3 p-3 bg-success bg-opacity-10">
                            <i class="bi bi-cash-stack fs-4 text-success" aria-hidden="true"></i>
                        </div>
                        <div>
                            <div class="fs-5 fw-bold text-success">@valeurPv.ToString("N0") FCFA</div>
                            <div class="text-muted small">Valeur stock (prix de vente)</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-3 p-3 bg-warning bg-opacity-10">
                            <i class="bi bi-graph-up fs-4 text-warning" aria-hidden="true"></i>
                        </div>
                        <div>
                            <div class="fs-5 fw-bold text-warning">@marge.ToString("N0") FCFA</div>
                            <div class="text-muted small">Marge potentielle</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-2 mb-3">
        <div class="col-auto">
            <span class="badge bg-success">@nbEnStock produits en stock</span>
        </div>
        <div class="col-auto">
            <span class="badge bg-danger">@nbRupture en rupture</span>
        </div>
    </div>
}

<div class="mb-3">
    <a class="btn btn-outline-secondary btn-sm" asp-action="StockStatusCsv" role="button">
        <i class="bi bi-download me-1" aria-hidden="true"></i>Exporter CSV
    </a>
</div>

<div class="table-card mb-3">
    <div class="table-responsive">
    <table class="table table-sm table-hover mb-0">
        <thead class="table-light">
            <tr>
                <th>Produit</th>
                <th>Catégorie</th>
                <th>Fournisseur</th>
                <th class="text-end">Stock</th>
                <th class="text-end">Seuil</th>
                <th>Statut</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.ProductName</td>
                    <td>@r.CategoryName</td>
                    <td>@r.SupplierName</td>
                    <td class="text-end">@r.StockQuantity</td>
                    <td class="text-end">@r.AlertThreshold</td>
                    <td><span class="badge @r.StatusBadgeClass">@r.StatusLabel</span></td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    @if (Model.Count > 0)
    {
        <div class="table-card-caption">@Model.Count produit(s) actif(s) listé(s).</div>
    }
</div>
@if (Model.Count == 0)
{
    <div class="app-empty-state app-empty-state--compact mt-3" role="status">
        <i class="bi bi-clipboard-data" aria-hidden="true"></i>
        <p class="app-empty-state-title mb-1">Aucun produit actif</p>
        <p class="mb-0 small">Activez des produits ou créez-en dans le catalogue.</p>
    </div>
}
