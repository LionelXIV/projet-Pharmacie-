@model RapportExtrasViewModel
@using Pharmacie.Reporting
@using Pharmacie.Services
@{
    ViewData["Title"] = "Rapport Produits Extras";
}

@await Html.PartialAsync("_BackButton")

<div class="page-header">
    <h1 class="page-title">Rapport Produits Extras</h1>
    <p class="page-lead mb-0">
        Du @Model.DateDebut.ToString("dd/MM/yyyy") au @Model.DateFin.ToString("dd/MM/yyyy").
    </p>
</div>

<div class="alert alert-warning">
    <i class="bi bi-bag me-1" aria-hidden="true"></i>
    <strong>Rapport Produits Extras</strong> —
    Ces ventes sont exclues des rapports officiels (TVA, DGID, CA pharmacie).
</div>

<form method="get" asp-action="RapportExtras" class="row g-2 mb-4 align-items-end">
    <div class="col-md-3">
        <label class="form-label fw-bold" for="dateDebut">Date début</label>
        <input type="date"
               name="dateDebut"
               id="dateDebut"
               class="form-control"
               data-flatpickr-ignore="true"
               value="@Model.DateDebut.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-md-3">
        <label class="form-label fw-bold" for="dateFin">Date fin</label>
        <input type="date"
               name="dateFin"
               id="dateFin"
               class="form-control"
               data-flatpickr-ignore="true"
               value="@Model.DateFin.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">
            <i class="bi bi-search me-1" aria-hidden="true"></i>Rechercher
        </button>
    </div>
    <div class="col-md-2">
        <a asp-action="ExportRapportExtrasCSV"
           asp-route-dateDebut="@Model.DateDebut.ToString("yyyy-MM-dd")"
           asp-route-dateFin="@Model.DateFin.ToString("yyyy-MM-dd")"
           class="btn btn-outline-success w-100">
            <i class="bi bi-download me-1" aria-hidden="true"></i>Export CSV
        </a>
    </div>
</form>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Nombre de ventes</div>
                <div class="fs-4 fw-bold">@Model.NombreVentes</div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">CA Produits Extras</div>
                <div class="fs-4 fw-bold text-warning-emphasis">@ReportCsvFormatter.FormatFcfa(Model.CATotal)</div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-semibold">Ventes Extras</div>
    @if (!Model.Ventes.Any())
    {
        <div class="card-body text-muted small">Aucune vente Extras sur la période.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Produits</th>
                        <th class="text-end">CA</th>
                        <th>Mode paiement</th>
                        <th>Vendeur</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in Model.Ventes)
                    {
                        var lignes = ProduitsExtrasFilter.LignesExtras(v.Lines).ToList();
                        var produits = string.Join(", ", lignes.Select(l =>
                            $"{l.Product?.CommercialName ?? "#"} ×{l.Quantity}"));
                        var ca = lignes.Sum(l => l.UnitPrice * l.Quantity);
                        <tr>
                            <td class="text-nowrap small">@v.SoldAt.ToString("g")</td>
                            <td class="small">@produits</td>
                            <td class="text-end fw-semibold">@ReportCsvFormatter.FormatFcfa(ca)</td>
                            <td>
                                <span class="badge @PaymentMethodDisplay.BadgeCssClass(v.PaymentMethod)">
                                    @PaymentMethodDisplay.GetName(v.PaymentMethod)
                                </span>
                            </td>
                            <td class="small">@(v.Vendeur?.Nom ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
