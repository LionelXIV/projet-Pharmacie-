@model EtatTVAViewModel
@{
    ViewData["Title"] = "État de TVA — DGID";
}

@await Html.PartialAsync("_BackButton")

<div class="page-header d-flex flex-wrap justify-content-between align-items-start gap-2">
    <div>
        <h1 class="page-title">État de TVA — Déclaration DGID</h1>
        <p class="page-lead mb-0">Sélectionnez une période libre pour la déclaration DGID.</p>
    </div>
</div>

<form method="get" asp-action="EtatTVA" class="row g-2 mb-3">
    <div class="col-md-3">
        <label class="form-label fw-bold">Date début</label>
        <input type="date"
               name="dateDebut"
               class="form-control"
               data-flatpickr-ignore="true"
               value="@Model.DateDebut.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-md-3">
        <label class="form-label fw-bold">Date fin</label>
        <input type="date"
               name="dateFin"
               class="form-control"
               data-flatpickr-ignore="true"
               value="@Model.DateFin.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">
            <i class="bi bi-search me-1"></i>Afficher
        </button>
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <a asp-action="ExportTVAPdf"
           asp-route-dateDebut="@Model.DateDebut.ToString("yyyy-MM-dd")"
           asp-route-dateFin="@Model.DateFin.ToString("yyyy-MM-dd")"
           class="btn btn-success w-100"
           target="_blank">
            <i class="bi bi-file-pdf me-1"></i>PDF
        </a>
    </div>
</form>

<h6 class="text-muted mb-3">ÉTAT DE TVA — @Model.PeriodeLabel</h6>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <h2 class="h5 text-center mb-1">PHARMACIE SAINT JEAN PAUL II PNR</h2>
        <p class="text-center text-muted mb-0">@Model.PeriodeLabel</p>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-bordered table-sm table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>DATE</th>
                <th class="text-end">MONTANT EXONÉRÉ</th>
                <th class="text-end">MONTANT HT</th>
                <th class="text-end">TVA 18%</th>
                <th class="text-end">MONTANT TTC</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ligne in Model.Lignes)
            {
                <tr>
                    <td>@ligne.Date.ToString("dd/MM/yyyy")</td>
                    <td class="text-end">@ligne.MontantExonere.ToString("N0") F</td>
                    <td class="text-end">@ligne.MontantHT.ToString("N0") F</td>
                    <td class="text-end">@ligne.MontantTVA.ToString("N0") F</td>
                    <td class="text-end">@ligne.MontantTTC.ToString("N0") F</td>
                </tr>
            }
        </tbody>
        <tfoot class="table-warning fw-bold">
            <tr>
                <td>TOTAL</td>
                <td class="text-end">@Model.TotalExonere.ToString("N0") F</td>
                <td class="text-end">@Model.TotalHT.ToString("N0") F</td>
                <td class="text-end">@Model.TotalTVA.ToString("N0") F</td>
                <td class="text-end">@Model.TotalTTC.ToString("N0") F</td>
            </tr>
        </tfoot>
    </table>
</div>
