@using Pharmacie.Authorization
@{
    ViewData["Title"] = "Rapports";
    var showOperational = AppRoles.CanAccessOperationalReports(User);
    var showStockReports = AppRoles.CanAccessStockReports(User);
    var showFinances = AppRoles.CanAccessFinances(User);
}

<div class="page-header">
    <h1 class="page-title">Rapports</h1>
    <p class="page-lead mb-0">Synthèses sur le stock, la péremption, les ventes et les mouvements.</p>
</div>

<div class="row g-3">
    @if (showStockReports)
    {
        <div class="col-md-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100 report-hub-card">
                <div class="card-body">
                    <h2 class="h5 card-title"><i class="bi bi-clipboard-data" aria-hidden="true"></i>État du stock</h2>
                    <p class="card-text small text-muted">Quantités, seuils et statut par produit actif.</p>
                    <a class="btn btn-outline-primary stretched-link" asp-action="StockStatus">Ouvrir</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100 report-hub-card">
                <div class="card-body">
                    <h2 class="h5 card-title"><i class="bi bi-hourglass-split" aria-hidden="true"></i>Proches de l’expiration</h2>
                    <p class="card-text small text-muted">Lots encore valides dans la fenêtre d’alerte (@ViewBag.ExpirationHorizonDays jours).</p>
                    <a class="btn btn-outline-primary stretched-link" asp-action="NearExpiration">Ouvrir</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100 report-hub-card">
                <div class="card-body">
                    <h2 class="h5 card-title"><i class="bi bi-calendar-x" aria-hidden="true"></i>Produits expirés</h2>
                    <p class="card-text small text-muted">Lots encore en stock après date de péremption.</p>
                    <a class="btn btn-outline-primary stretched-link" asp-action="ExpiredProducts">Ouvrir</a>
                </div>
            </div>
        </div>
    }
    @if (showOperational)
    {
        <div class="col-md-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100 report-hub-card">
                <div class="card-body">
                    <h2 class="h5 card-title"><i class="bi bi-receipt" aria-hidden="true"></i>Historique des ventes</h2>
                    <p class="card-text small text-muted">Dernières ventes enregistrées.</p>
                    <a class="btn btn-outline-primary stretched-link" asp-action="SalesHistory">Ouvrir</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100 report-hub-card">
                <div class="card-body">
                    <h2 class="h5 card-title"><i class="bi bi-arrow-left-right" aria-hidden="true"></i>Historique des mouvements</h2>
                    <p class="card-text small text-muted">Derniers mouvements et responsable.</p>
                    <a class="btn btn-outline-primary stretched-link" asp-action="StockMovementsHistory">Ouvrir</a>
                </div>
            </div>
        </div>
    }
    @if (showFinances)
    {
        <div class="col-md-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100 report-hub-card">
                <div class="card-body">
                    <h2 class="h5 card-title"><i class="bi bi-bar-chart-steps" aria-hidden="true"></i>Performance vendeurs</h2>
                    <p class="card-text small text-muted">Chiffre d'affaires du jour par vendeur.</p>
                    <a class="btn btn-outline-primary stretched-link" asp-action="VendeursDuJour">Ouvrir</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-4">
            <div class="card border-success shadow-sm h-100 report-hub-card">
                <div class="card-body">
                    <h2 class="h5 card-title"><i class="bi bi-cash-coin me-1" aria-hidden="true"></i>Rapport CA par période</h2>
                    <p class="card-text small text-muted">CA, marge, TVA et répartition vendeurs entre deux dates.</p>
                    <a class="btn btn-success btn-sm stretched-link" asp-action="RapportCA">Rechercher le CA</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-4">
            <div class="card border-warning shadow-sm h-100 report-hub-card">
                <div class="card-body">
                    <h2 class="h5 card-title"><i class="bi bi-percent me-1" aria-hidden="true"></i>État de TVA — DGID</h2>
                    <p class="card-text small text-muted">Tableau mensuel pour déclaration au 15 du mois suivant.</p>
                    <a class="btn btn-warning btn-sm stretched-link" asp-action="EtatTVA">Voir l'état TVA</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-4">
            <div class="card border-primary shadow-sm h-100 report-hub-card">
                <div class="card-body">
                    <h2 class="h5 card-title"><i class="bi bi-journal-richtext me-1" aria-hidden="true"></i>Récapitulatif global</h2>
                    <p class="card-text small text-muted">
                        CA, PA, marge, TVA, bons et avoirs sur une période.
                    </p>
                    <a class="btn btn-primary btn-sm stretched-link" asp-action="Recapitulatif">Voir le récapitulatif</a>
                </div>
            </div>
        </div>
        @if (AppRoles.IsTitulaire(User))
        {
            <div class="col-md-6 col-xl-4">
                <div class="card border-warning shadow-sm h-100 report-hub-card">
                    <div class="card-body">
                        <h2 class="h5 card-title"><i class="bi bi-bag me-1" aria-hidden="true"></i>Produits Extras</h2>
                        <p class="card-text small text-muted">
                            Ventes hors rapports officiels. Visible uniquement par le Pharmacien Titulaire.
                        </p>
                        <a class="btn btn-warning btn-sm stretched-link" asp-action="RapportExtras">Voir le rapport</a>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-4">
                <div class="card border-danger shadow-sm h-100 report-hub-card">
                    <div class="card-body">
                        <h2 class="h5 card-title text-danger">
                            <i class="bi bi-shield-exclamation me-1" aria-hidden="true"></i>
                            Contrôle ventes en détail
                        </h2>
                        <p class="card-text small text-muted">
                            Vérifier les écarts entre boîtes ouvertes et unités vendues (anti-fraude).
                        </p>
                        <a asp-action="RapportEcarts" class="btn btn-danger btn-sm stretched-link">Voir le rapport</a>
                    </div>
                </div>
            </div>
        }
    }
</div>
