@model IReadOnlyList<ReportStockStatusRowViewModel>
@{
    Layout = null;
    var valeurPa = ViewBag.ValeurStockPA as decimal? ?? 0m;
    var valeurPv = ViewBag.ValeurStockPV as decimal? ?? 0m;
    var marge = ViewBag.MargePotentielle as decimal? ?? 0m;
    var nbEnStock = ViewBag.NbProduitsEnStock as int? ?? 0;
    var nbRupture = ViewBag.NbRupture as int? ?? 0;
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>État du stock</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: Arial, sans-serif; font-size: 11px; color: #000; padding: 15mm; }
        .header { text-align: center; margin-bottom: 10px; border-bottom: 2px solid #000; padding-bottom: 8px; }
        .header h1 { font-size: 14px; font-weight: bold; }
        .header h2 { font-size: 12px; margin-top: 4px; }
        .kpi-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin: 10px 0; }
        .kpi-box { border: 1px solid #ccc; padding: 6px; text-align: center; }
        .kpi-value { font-size: 13px; font-weight: bold; }
        .kpi-label { font-size: 9px; color: #666; }
        table { width: 100%; border-collapse: collapse; margin-top: 8px; }
        th { background: #333; color: #fff; padding: 4px 6px; text-align: left; font-size: 10px; }
        td { padding: 3px 6px; border-bottom: 1px solid #eee; font-size: 10px; }
        tr:nth-child(even) { background: #f9f9f9; }
        .text-end { text-align: right; }
        .footer { margin-top: 15px; font-size: 9px; color: #666; text-align: center; }
        .no-print { text-align: center; margin-bottom: 15px; }
        @@media print {
            .no-print { display: none !important; }
            @@page { size: A4 portrait; margin: 12mm; }
        }
    </style>
</head>
<body>
    <div class="no-print">
        <button type="button" onclick="window.print()" style="padding:8px 20px;background:#4CAF82;color:white;border:none;border-radius:4px;cursor:pointer;">Imprimer / Enregistrer PDF</button>
        <button type="button" onclick="window.close()" style="padding:8px 20px;background:#ccc;border:none;margin-left:8px;border-radius:4px;cursor:pointer;">Fermer</button>
    </div>

    <div class="header">
        <h1>PHARMACIE SAINT JEAN PAUL II PNR</h1>
        <h2>ÉTAT DU STOCK</h2>
        <div>Généré le @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
    </div>

    <div class="kpi-grid">
        <div class="kpi-box"><div class="kpi-value">@valeurPa.ToString("N0") F</div><div class="kpi-label">Valeur stock (PA)</div></div>
        <div class="kpi-box"><div class="kpi-value">@valeurPv.ToString("N0") F</div><div class="kpi-label">Valeur stock (PV)</div></div>
        <div class="kpi-box"><div class="kpi-value">@marge.ToString("N0") F</div><div class="kpi-label">Marge potentielle</div></div>
        <div class="kpi-box"><div class="kpi-value">@nbEnStock</div><div class="kpi-label">Produits en stock</div></div>
        <div class="kpi-box"><div class="kpi-value">@nbRupture</div><div class="kpi-label">En rupture</div></div>
        <div class="kpi-box"><div class="kpi-value">@Model.Count</div><div class="kpi-label">Lignes</div></div>
    </div>

    <table>
        <thead>
            <tr>
                <th>Produit</th>
                <th>Catégorie</th>
                <th>Fournisseur</th>
                <th class="text-end">Stock</th>
                <th class="text-end">Seuil</th>
                <th>Statut</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.ProductName</td>
                <td>@r.CategoryName</td>
                <td>@r.SupplierName</td>
                <td class="text-end">@r.StockQuantity</td>
                <td class="text-end">@r.AlertThreshold</td>
                <td>@r.StatusLabel</td>
            </tr>
        }
        </tbody>
    </table>

    <div class="footer">Pharmacie Saint Jean Paul II PNR — Document confidentiel</div>

    <script>
        if (new URLSearchParams(window.location.search).get('auto') === 'true') {
            window.addEventListener('load', function () {
                setTimeout(function () { window.print(); }, 500);
            });
        }
    </script>
</body>
</html>
