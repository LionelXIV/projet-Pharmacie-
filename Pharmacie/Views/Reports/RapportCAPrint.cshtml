@model RapportCAViewModel
@{
    Layout = null;
    string Pct(decimal part) => Model.CATotal > 0
        ? (part / Model.CATotal * 100).ToString("N1")
        : "0";
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rapport CA — @Model.DateDebut.ToString("dd/MM/yyyy") → @Model.DateFin.ToString("dd/MM/yyyy")</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: Arial, sans-serif; font-size: 11px; color: #000; padding: 15mm; }
        .header { text-align: center; margin-bottom: 10px; border-bottom: 2px solid #000; padding-bottom: 8px; }
        .header h1 { font-size: 14px; font-weight: bold; }
        .header h2 { font-size: 12px; margin-top: 4px; }
        .kpi-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin: 10px 0; }
        .kpi-box { border: 1px solid #ccc; padding: 6px; text-align: center; }
        .kpi-value { font-size: 13px; font-weight: bold; }
        .kpi-label { font-size: 9px; color: #666; }
        table { width: 100%; border-collapse: collapse; margin-top: 8px; }
        th { background: #333; color: #fff; padding: 4px 6px; text-align: left; font-size: 10px; }
        td { padding: 3px 6px; border-bottom: 1px solid #eee; font-size: 10px; }
        tr:nth-child(even) { background: #f9f9f9; }
        .text-end { text-align: right; }
        .footer { margin-top: 15px; font-size: 9px; color: #666; text-align: center; }
        .no-print { text-align: center; margin-bottom: 15px; }
        .section-title { margin-top: 12px; font-size: 11px; font-weight: bold; }
        @@media print {
            .no-print { display: none !important; }
            @@page { size: A4 portrait; margin: 12mm; }
        }
    </style>
</head>
<body>
    <div class="no-print">
        <button type="button" onclick="window.print()" style="padding:8px 20px;background:#4CAF82;color:white;border:none;border-radius:4px;cursor:pointer;">Imprimer / Enregistrer PDF</button>
        <button type="button" onclick="window.close()" style="padding:8px 20px;background:#ccc;border:none;margin-left:8px;border-radius:4px;cursor:pointer;">Fermer</button>
    </div>

    <div class="header">
        <h1>PHARMACIE SAINT JEAN PAUL II PNR</h1>
        <h2>RAPPORT CA — DU @Model.DateDebut.ToString("dd/MM/yyyy") AU @Model.DateFin.ToString("dd/MM/yyyy")</h2>
        <div>Généré le @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
    </div>

    <div class="kpi-grid">
        <div class="kpi-box"><div class="kpi-value">@Model.CATotal.ToString("N0") F</div><div class="kpi-label">CA Total</div></div>
        <div class="kpi-box"><div class="kpi-value">@Model.MargeBrute.ToString("N0") F</div><div class="kpi-label">Marge (@Model.TauxMarge.ToString("N1")%)</div></div>
        <div class="kpi-box"><div class="kpi-value">@Model.PanierMoyen.ToString("N0") F</div><div class="kpi-label">Panier moyen</div></div>
        <div class="kpi-box"><div class="kpi-value">@Model.TVACollectee.ToString("N0") F</div><div class="kpi-label">TVA collectée</div></div>
        <div class="kpi-box"><div class="kpi-value">@Model.NombreVentes</div><div class="kpi-label">Nb ventes</div></div>
        <div class="kpi-box"><div class="kpi-value">@Model.PATotal.ToString("N0") F</div><div class="kpi-label">PA Total</div></div>
    </div>

    <div class="section-title">RÉPARTITION PAIEMENTS</div>
    <table>
        <thead><tr><th>Mode de paiement</th><th class="text-end">CA</th><th class="text-end">%</th></tr></thead>
        <tbody>
            <tr><td>Espèces</td><td class="text-end">@Model.CAEspeces.ToString("N0") F</td><td class="text-end">@Pct(Model.CAEspeces)%</td></tr>
            <tr><td>Wave</td><td class="text-end">@Model.CAWave.ToString("N0") F</td><td class="text-end">@Pct(Model.CAWave)%</td></tr>
            <tr><td>Orange Money</td><td class="text-end">@Model.CAOrangeMoney.ToString("N0") F</td><td class="text-end">@Pct(Model.CAOrangeMoney)%</td></tr>
            <tr><td>Autres</td><td class="text-end">@Model.CAAutres.ToString("N0") F</td><td class="text-end">@Pct(Model.CAAutres)%</td></tr>
        </tbody>
    </table>

    @if (Model.CAParVendeur.Any())
    {
        <div class="section-title">CA PAR VENDEUR</div>
        <table>
            <thead><tr><th>Vendeur</th><th class="text-end">Nb ventes</th><th class="text-end">CA</th><th class="text-end">Panier moyen</th></tr></thead>
            <tbody>
            @foreach (var v in Model.CAParVendeur)
            {
                <tr>
                    <td>@v.NomVendeur</td>
                    <td class="text-end">@v.NbVentes</td>
                    <td class="text-end">@v.CA.ToString("N0") F</td>
                    <td class="text-end">@v.PanierMoyen.ToString("N0") F</td>
                </tr>
            }
            </tbody>
        </table>
    }

    @if (Model.CAParJour.Any())
    {
        <div class="section-title">CA PAR JOUR</div>
        <table>
            <thead><tr><th>Date</th><th class="text-end">Nb ventes</th><th class="text-end">CA</th></tr></thead>
            <tbody>
            @foreach (var j in Model.CAParJour)
            {
                <tr>
                    <td>@j.Date.ToString("dd/MM/yyyy")</td>
                    <td class="text-end">@j.NbVentes</td>
                    <td class="text-end">@j.CA.ToString("N0") F</td>
                </tr>
            }
            </tbody>
        </table>
    }

    <div class="footer">Pharmacie Saint Jean Paul II PNR — Document confidentiel</div>

    <script>
        if (new URLSearchParams(window.location.search).get('auto') === 'true') {
            window.addEventListener('load', function () {
                setTimeout(function () { window.print(); }, 500);
            });
        }
    </script>
</body>
</html>
