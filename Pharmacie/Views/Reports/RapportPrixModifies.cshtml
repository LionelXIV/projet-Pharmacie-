@model IList<Pharmacie.Models.PrixModification>
@using Pharmacie.Authorization
@using Pharmacie.Models
@{
    ViewData["Title"] = "Modifications de prix";
    var debut = ViewBag.DateDebut as string ?? "";
    var fin = ViewBag.DateFin as string ?? "";
}

<nav class="app-breadcrumb mb-3" aria-label="Fil d’Ariane">
    <ol class="breadcrumb mb-0 py-1">
        <li class="breadcrumb-item"><a asp-action="Index">Rapports</a></li>
        <li class="breadcrumb-item active" aria-current="page">Modifications de prix</li>
    </ol>
</nav>

<div class="page-header d-flex flex-wrap justify-content-between align-items-start gap-2">
    <div>
        <h1 class="page-title">Modifications de prix en vente</h1>
        <p class="page-lead mb-0">Le catalogue n’est pas modifié. Visible par le Pharmacien Titulaire uniquement.</p>
    </div>
    <button type="button" class="btn btn-outline-secondary btn-sm d-print-none" onclick="window.print()">
        <i class="bi bi-printer me-1"></i>Imprimer PDF
    </button>
</div>

<form method="get" class="row g-2 align-items-end mb-3 d-print-none">
    <div class="col-auto">
        <label class="form-label small mb-0" for="dateDebut">Du</label>
        <input type="date" id="dateDebut" name="dateDebut" value="@debut" class="form-control form-control-sm" />
    </div>
    <div class="col-auto">
        <label class="form-label small mb-0" for="dateFin">Au</label>
        <input type="date" id="dateFin" name="dateFin" value="@fin" class="form-control form-control-sm" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary btn-sm">Filtrer</button>
    </div>
</form>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-sm table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Date</th>
                    <th>Vente #</th>
                    <th>Produit</th>
                    <th class="text-end">Prix original</th>
                    <th class="text-end">Prix appliqué</th>
                    <th class="text-end">Écart</th>
                    <th>Vendeur</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-muted text-center py-4">Aucune modification sur cette période.</td>
                    </tr>
                }
                else
                {
                    foreach (var m in Model)
                    {
                        var ecart = m.NouveauPrix - m.AncienPrix;
                        <tr>
                            <td class="text-nowrap small">@m.ModifiedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @if (m.SaleId.HasValue)
                                {
                                    <a asp-controller="Sales" asp-action="Details" asp-route-id="@m.SaleId">#@m.SaleId</a>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td>@(m.Product?.CommercialName ?? "—")</td>
                            <td class="text-end">@m.AncienPrix.ToString("N0") F</td>
                            <td class="text-end fw-bold">@m.NouveauPrix.ToString("N0") F</td>
                            <td class="text-end @(ecart == 0 ? "" : ecart > 0 ? "text-danger" : "text-success")">
                                @(ecart >= 0 ? "+" : "")@ecart.ToString("N0") F
                            </td>
                            <td class="small">@(m.Sale?.Vendeur?.Nom ?? m.ModifiedByDisplayName)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
