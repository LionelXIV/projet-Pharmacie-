@model SaleIndexPageViewModel
@using System.Security.Claims
@using Microsoft.AspNetCore.Mvc.Rendering
@using Pharmacie.Services
@{
    ViewData["Title"] = "Ventes";
    var userLabels = ViewBag.UserLabels as Dictionary<string, string> ?? new Dictionary<string, string>();
    var filterUserList = ViewData["FilterUserId"] as IEnumerable<SelectListItem>;
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var canCancelAny = User.IsInRole("PharmacienTitulaire") || User.IsInRole("Pharmacien");
}

<div class="page-header">
    <div class="d-flex flex-column flex-md-row align-items-md-start justify-content-md-between gap-3">
        <div>
            <h1 class="page-title">Ventes</h1>
            <p class="page-lead mb-0">Historique des ventes. <strong>Enregistré par</strong> : utilisateur connecté lors de la validation.</p>
        </div>
        <div class="flex-shrink-0">
            <a class="btn btn-primary" asp-action="Create"><i class="bi bi-cash-register me-1" aria-hidden="true"></i>Nouvelle vente</a>
            @if (ViewBag.SaisieVentePasseeActive == true
                 && (User.IsInRole("PharmacienTitulaire")
                     || User.IsInRole("Pharmacien")))
            {
                <a asp-action="CreatePassee" class="btn btn-warning ms-2">
                    <i class="bi bi-clock-history me-1"></i>
                    Saisie vente passée
                </a>
            }
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body p-3 p-md-4">
        <h2 class="h6 text-uppercase text-muted mb-3"><i class="bi bi-funnel me-1" aria-hidden="true"></i>Filtres</h2>
        <p class="small text-muted mb-3">
            <strong>Du / Au</strong> : plage sur la <em>date-heure de vente</em> (inclusif sur les jours calendaires choisis).
            <strong>Utilisateur</strong> : restreint aux ventes enregistrées par ce compte (liste dérivée des ventes existantes).
        </p>
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-4 col-lg-2">
                <label class="form-label small mb-0" for="From">Du</label>
                <input type="date" name="From" id="From" value="@(Model.Filter.From?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" data-flatpickr-ignore="true" />
            </div>
            <div class="col-md-4 col-lg-2">
                <label class="form-label small mb-0" for="To">Au</label>
                <input type="date" name="To" id="To" value="@(Model.Filter.To?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" data-flatpickr-ignore="true" />
            </div>
            <div class="col-md-4 col-lg-4">
                <label class="form-label small mb-0" for="UserId">Utilisateur</label>
                <select name="UserId" id="UserId" class="form-select form-select-sm">
                    @if (string.IsNullOrEmpty(Model.Filter.UserId))
                    {
                        <option value="" selected>Tous</option>
                    }
                    else
                    {
                        <option value="">Tous</option>
                    }
                    @if (filterUserList != null)
                    {
                        @foreach (var opt in filterUserList)
                        {
                            if (Model.Filter.UserId == opt.Value)
                            {
                                <option value="@opt.Value" selected>@opt.Text</option>
                            }
                            else
                            {
                                <option value="@opt.Value">@opt.Text</option>
                            }
                        }
                    }
                </select>
            </div>
            <div class="col-12 col-lg-auto d-flex flex-wrap gap-2 pt-1 pt-lg-0">
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-funnel me-1" aria-hidden="true"></i>Filtrer</button>
                <a class="btn btn-outline-secondary btn-sm" asp-action="Index">Réinitialiser</a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm table-card mb-3">
    <div class="card-header bg-white border-bottom py-3">
        <span class="fw-semibold"><i class="bi bi-receipt me-2 text-primary" aria-hidden="true"></i>Historique des ventes</span>
    </div>
    <div class="table-responsive">
        <table class="table table-striped table-sm align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th><i class="bi bi-hash text-muted me-1" aria-hidden="true"></i>N°</th>
                    <th><i class="bi bi-calendar3 text-muted me-1" aria-hidden="true"></i>Date</th>
                    <th class="text-end"><i class="bi bi-list-ul text-muted me-1" aria-hidden="true"></i>Lignes</th>
                    <th class="text-end"><i class="bi bi-cash-coin text-muted me-1" aria-hidden="true"></i>Total</th>
                    <th><i class="bi bi-wallet2 text-muted me-1" aria-hidden="true"></i>Paiement</th>
                    <th><i class="bi bi-person-badge text-muted me-1" aria-hidden="true"></i>Vendeur</th>
                    <th><i class="bi bi-person text-muted me-1" aria-hidden="true"></i>Enregistré par</th>
                    <th class="text-end"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Sales)
                {
                    var lineCount = s.Lines?.Count ?? 0;
                    var total = s.Lines?.Sum(l => l.Quantity * l.UnitPrice) ?? 0m;
                    <tr>
                        <td><span class="badge text-bg-light border font-monospace">#@s.Id</span>
                            @if (s.Lines != null && s.Lines.Any(l => l.Product?.Category?.EstHorsSysteme == true))
                            {
                                <span class="badge bg-warning text-dark ms-1" title="Contient des Produits Extras">
                                    <i class="bi bi-bag-fill" aria-hidden="true"></i> Extras
                                </span>
                            }
                            @if (s.IsRegularisation)
                            {
                                <span class="badge bg-warning text-dark ms-1">
                                    <i class="bi bi-clock-history me-1"></i>
                                    Régularisation
                                </span>
                            }
                            @if (s.IsAdminTest)
                            {
                                <span class="badge bg-secondary">
                                    <i class="bi bi-gear me-1"></i>
                                    Admin/Test
                                </span>
                            }
                            @if (s.IsAnnulee)
                            {
                                <span class="badge bg-danger">
                                    <i class="bi bi-x-circle me-1"></i>
                                    Annulée
                                </span>
                                <small class="text-muted d-block">
                                    par @s.AnnuleeParNom
                                    le @s.DateAnnulation?.ToString("dd/MM HH:mm")
                                </small>
                            }
                            @if (s.IsModifiee && s.IsAnnulee)
                            {
                                <span class="badge bg-warning text-dark">Remplacée</span>
                            }
                            @if (s.VenteOriginaleId.HasValue)
                            {
                                <span class="badge bg-info text-dark" title="Issue de la vente #@s.VenteOriginaleId">Modifiée</span>
                            }
                            @if (s.IsModifiee && s.VenteOriginaleId.HasValue)
                            {
                                <div class="small text-muted mt-1">
                                    <i class="bi bi-arrow-left-circle me-1"></i>
                                    Remplace la vente
                                    <a asp-action="Details" asp-route-id="@s.VenteOriginaleId" class="text-warning fw-bold">#@s.VenteOriginaleId</a>
                                </div>
                            }
                            @if (s.IsAnnulee && s.VenteRemplaceeParId.HasValue)
                            {
                                <div class="small text-muted mt-1">
                                    <i class="bi bi-arrow-right-circle me-1"></i>
                                    Remplacée par
                                    <a asp-action="Details" asp-route-id="@s.VenteRemplaceeParId" class="text-success fw-bold">#@s.VenteRemplaceeParId</a>
                                </div>
                            }
                        </td>
                        <td class="text-nowrap small">@s.SoldAt.ToString("g")</td>
                        <td class="text-end">
                            <span class="badge text-bg-secondary-subtle text-secondary-emphasis border">@lineCount</span>
                        </td>
                        <td class="text-end">
                            <span class="fw-bold text-success-emphasis fs-6">@ReportCsvFormatter.FormatFcfa(total)</span>
                        </td>
                        <td>
                            <span class="badge @PaymentMethodDisplay.BadgeCssClass(s.PaymentMethod)">
                                @PaymentMethodDisplay.Format(s.PaymentMethod, s.PaymentMethodAutre)
                            </span>
                        </td>
                        <td class="small">@(s.Vendeur?.Nom ?? "—")</td>
                        <td class="small">
                            <i class="bi bi-person-circle me-1 text-muted" aria-hidden="true"></i>@UserDisplayResolver.Resolve(userLabels, s.UserId)
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-success" asp-action="Ticket" asp-route-id="@s.Id" target="_blank" title="Imprimer ticket" data-bs-toggle="tooltip">
                                <i class="bi bi-printer" aria-hidden="true"></i>
                            </a>
                            <a class="btn btn-sm btn-outline-dark" asp-action="FicheVente" asp-route-id="@s.Id" target="_blank" title="Fiche A4" data-bs-toggle="tooltip">
                                <i class="bi bi-file-text" aria-hidden="true"></i>
                            </a>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@s.Id" title="Voir le détail" data-bs-toggle="tooltip">
                                <i class="bi bi-eye" aria-hidden="true"></i><span class="d-none d-md-inline ms-1">Détail</span>
                            </a>
                            @{
                                var peutModifierVente = !s.IsAnnulee && (
                                    User.IsInRole("PharmacienTitulaire")
                                    || User.IsInRole("Pharmacien")
                                    || User.IsInRole("Administrateur")
                                    || ((User.IsInRole("Caissier")
                                         || User.IsInRole("AssistantPharmacien")
                                         || User.IsInRole("Vendeur"))
                                        && s.SoldAt >= DateTime.Now.AddHours(-24)
                                        && s.UserId == currentUserId));
                            }
                            @if (peutModifierVente)
                            {
                                <a asp-action="Modifier" asp-route-id="@s.Id"
                                   class="btn btn-sm btn-outline-warning"
                                   title="Modifier cette vente">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            }
                            @if (!s.IsAnnulee && (
                                canCancelAny
                                || User.IsInRole("Administrateur")
                                || ((User.IsInRole("Caissier")
                                     || User.IsInRole("AssistantPharmacien")
                                     || User.IsInRole("Vendeur"))
                                    && s.UserId == currentUserId
                                    && s.SoldAt >= DateTime.Now.AddHours(-24))))
                            {
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modal-annuler-@s.Id"
                                        title="Annuler cette vente">
                                    <i class="bi bi-x-circle"></i>
                                </button>
                                <div class="modal fade" id="modal-annuler-@s.Id" tabindex="-1">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header bg-danger text-white">
                                                <h5 class="modal-title">Annuler la vente #@s.Id</h5>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p>
                                                    Annuler la vente
                                                    <strong>#@s.Id</strong>
                                                    du
                                                    @s.SoldAt.ToString("dd/MM/yyyy")
                                                    d'un montant de
                                                    <strong>@total.ToString("N0") FCFA</strong> ?
                                                </p>
                                                <p class="text-success">
                                                    <i class="bi bi-arrow-up me-1"></i>
                                                    Le stock sera restitué automatiquement.
                                                </p>
                                                <form asp-action="AnnulerVente" asp-route-id="@s.Id" method="post" id="form-annuler-@s.Id">
                                                    @Html.AntiForgeryToken()
                                                    <div class="mb-3">
                                                        <label class="form-label">Raison (optionnel)</label>
                                                        <input type="text" name="raison" class="form-control" placeholder="Ex: Erreur de saisie" maxlength="500">
                                                    </div>
                                                </form>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                                                <button type="submit" form="form-annuler-@s.Id" class="btn btn-danger">
                                                    <i class="bi bi-x-circle me-1"></i>
                                                    Confirmer l'annulation
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Sales.Count > 0)
    {
        <div class="table-card-caption d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 px-3 py-2">
            <span>@Model.Sales.Count vente(s) sur @(ViewBag.TotalCount ?? 0) · page @(ViewBag.CurrentPage ?? 1)/@(ViewBag.TotalPages ?? 1)</span>
            @{
                var paginationRoutes = new Dictionary<string, string>();
                if (Model.Filter.From.HasValue)
                    paginationRoutes["From"] = Model.Filter.From.Value.ToString("yyyy-MM-dd");
                if (Model.Filter.To.HasValue)
                    paginationRoutes["To"] = Model.Filter.To.Value.ToString("yyyy-MM-dd");
                if (!string.IsNullOrEmpty(Model.Filter.UserId))
                    paginationRoutes["UserId"] = Model.Filter.UserId;
                ViewBag.PaginationRoutes = paginationRoutes;
            }
            <partial name="_Pagination" />
        </div>
    }
</div>
@if (Model.Sales.Count == 0)
{
    <div class="app-empty-state my-3" role="status">
        <i class="bi bi-cart-x" aria-hidden="true"></i>
        <p class="app-empty-state-title mb-1">Aucune vente</p>
        <p class="mb-0 small">Aucun résultat pour ces critères.</p>
        <a class="btn btn-primary btn-sm mt-3" asp-action="Create"><i class="bi bi-cash-register me-1" aria-hidden="true"></i>Nouvelle vente</a>
    </div>
}

@section Scripts {
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
          new bootstrap.Tooltip(el);
        });
      });
    </script>
}
