@model IReadOnlyList<Sale>
@using Pharmacie.Services
@{
    Layout = null;
    var filter = ViewBag.Filter as SaleListFilters ?? new SaleListFilters();
    var userLabels = ViewBag.UserLabels as Dictionary<string, string> ?? new Dictionary<string, string>();
    var periode = filter.From.HasValue || filter.To.HasValue
        ? $"{(filter.From?.ToString("dd/MM/yyyy") ?? "…")} → {(filter.To?.ToString("dd/MM/yyyy") ?? "…")}"
        : "Toutes dates";
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Historique des ventes</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: Arial, sans-serif; font-size: 11px; color: #000; padding: 15mm; }
        .header { text-align: center; margin-bottom: 10px; border-bottom: 2px solid #000; padding-bottom: 8px; }
        .header h1 { font-size: 14px; font-weight: bold; }
        .header h2 { font-size: 12px; margin-top: 4px; }
        table { width: 100%; border-collapse: collapse; margin-top: 8px; }
        th { background: #333; color: #fff; padding: 4px 6px; text-align: left; font-size: 10px; }
        td { padding: 3px 6px; border-bottom: 1px solid #eee; font-size: 10px; }
        tr:nth-child(even) { background: #f9f9f9; }
        .text-end { text-align: right; }
        .footer { margin-top: 15px; font-size: 9px; color: #666; text-align: center; }
        .no-print { text-align: center; margin-bottom: 15px; }
        @@media print {
            .no-print { display: none !important; }
            @@page { size: A4 landscape; margin: 12mm; }
        }
    </style>
</head>
<body>
    <div class="no-print">
        <button type="button" onclick="window.print()" style="padding:8px 20px;background:#4CAF82;color:white;border:none;border-radius:4px;cursor:pointer;">Imprimer / Enregistrer PDF</button>
        <button type="button" onclick="window.close()" style="padding:8px 20px;background:#ccc;border:none;margin-left:8px;border-radius:4px;cursor:pointer;">Fermer</button>
    </div>

    <div class="header">
        <h1>PHARMACIE SAINT JEAN PAUL II PNR</h1>
        <h2>HISTORIQUE DES VENTES</h2>
        <div>Période : @periode · @Model.Count vente(s) · Généré le @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
    </div>

    <table>
        <thead>
            <tr>
                <th>N°</th>
                <th>Date</th>
                <th>Vendeur</th>
                <th>Paiement</th>
                <th class="text-end">Lignes</th>
                <th class="text-end">Total</th>
                <th>Enregistré par</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var s in Model)
        {
            var total = s.Lines?.Sum(l => l.Quantity * l.UnitPrice) ?? 0m;
            <tr>
                <td>#@s.Id</td>
                <td>@s.SoldAt.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@(s.Vendeur?.Nom ?? "—")</td>
                <td>@PaymentMethodDisplay.Format(s.PaymentMethod, s.PaymentMethodAutre)</td>
                <td class="text-end">@(s.Lines?.Count ?? 0)</td>
                <td class="text-end">@ReportCsvFormatter.FormatFcfa(total)</td>
                <td>@UserDisplayResolver.Resolve(userLabels, s.UserId)</td>
            </tr>
        }
        </tbody>
    </table>

    <div class="footer">Pharmacie Saint Jean Paul II PNR — Document confidentiel</div>
    <script>
        window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 500); });
    </script>
</body>
</html>
