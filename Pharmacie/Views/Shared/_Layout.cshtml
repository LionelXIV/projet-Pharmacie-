<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Pharmacie Saint Jean Paul II</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/material_blue.min.css" crossorigin="anonymous" />
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Pharmacie.styles.css" asp-append-version="true" />
    <!-- PWA -->
    <link rel="manifest" href="~/manifest.json" asp-append-version="true" />
    <meta name="theme-color" content="#4CAF82" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Pharmacie SJP" />
    <link rel="apple-touch-icon" href="~/icons/icon-192.png" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var routeController = (ViewContext.RouteData.Values["controller"] as string) ?? string.Empty;
    var routeAction = (ViewContext.RouteData.Values["action"] as string) ?? string.Empty;
    bool IsCtrl(string name) => string.Equals(routeController, name, StringComparison.OrdinalIgnoreCase);
    bool IsAction(string name) => string.Equals(routeAction, name, StringComparison.OrdinalIgnoreCase);
    bool IsActionAny(params string[] names) => names.Any(n => string.Equals(routeAction, n, StringComparison.OrdinalIgnoreCase));
    bool IsCtrlAny(params string[] names) => names.Any(n => string.Equals(routeController, n, StringComparison.OrdinalIgnoreCase));
    var isHome = IsCtrl("Home") && IsAction("Index");
    var isDashboard = IsCtrl("Dashboard");
    var isReports = IsCtrl("Reports");
    var isCatalog = IsCtrlAny("Products", "Batches", "StockMovements", "ProductImports");
    var isPurchasing = IsCtrlAny("PurchaseOrders", "Categories", "Suppliers", "GoodsReceipts");
    var isSales = IsCtrl("Sales");
    var isBons = IsCtrl("Bons");
    var isAvoirs = IsCtrl("Avoirs");
    var isCaisse = IsCtrl("Caisse");
    var isCommerce = isSales || isPurchasing || isBons || isAvoirs || isCaisse;
    var isPatients = IsCtrlAny("Patients", "PatientPrescriptions", "PatientReminders", "PatientRemindersAlerts");
    var isAlerts = IsCtrl("Alerts");
    var isAdminUsers = IsCtrl("AdminUsers");
    var isVendeurs = IsCtrl("Vendeurs");
    var showPrincipalSection = true;
    var showCatalogueSection = User?.Identity?.IsAuthenticated == true && AppRoles.CanAccessCatalog(User);
    var showStockSection = User?.Identity?.IsAuthenticated == true && AppRoles.CanAccessStock(User);
    var showCommerceSection = User?.Identity?.IsAuthenticated == true && AppRoles.CanSeeCommerceMenu(User);
    var showPatientsSection = User?.Identity?.IsAuthenticated == true && AppRoles.CanAccessPatientsRead(User);
    var showDonneesSection = User?.Identity?.IsAuthenticated == true && AppRoles.CanAccessReports(User);
    var showAdminSection = User?.Identity?.IsAuthenticated == true && AppRoles.CanManageUsersAccounts(User);
    var showVendeursMenu = showAdminSection;
    var showPerformanceVendeurs = User?.Identity?.IsAuthenticated == true && AppRoles.CanAccessFinances(User);
    var antiforgeryTokens = Antiforgery.GetAndStoreTokens(Context);
}
<body>
    <input type="hidden"
           id="global-antiforgery-token"
           name="__RequestVerificationToken"
           value="@antiforgeryTokens.RequestToken" />
    <a class="skip-link visually-hidden-focusable" href="#main-content">Aller au contenu</a>
    <div class="ph-app">
        <aside class="ph-sidebar" id="sidebar" aria-label="Navigation principale">
            <a class="ph-sidebar-brand text-decoration-none" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="brand-mark" aria-hidden="true">
                    <svg class="brand-mark-svg" width="32" height="32" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" role="img">
                        <title>Pharmacie Saint Jean Paul II</title>
                        <rect x="2" y="2" width="40" height="40" rx="11" fill="#2ECC71"/>
                        <path d="M20 11h4v9h9v4h-9v9h-4v-9h-9v-4h9v-9z" fill="#fff"/>
                    </svg>
                </span>
                <span title="Pharmacie Saint Jean Paul II PNR">St Jean Paul II</span>
            </a>

            <nav class="ph-sidebar-nav">
                @if (showPrincipalSection)
                {
                    <div class="ph-nav-section">
                        <span class="ph-nav-label">Principal</span>
                        <a class="nav-link @(isHome ? "active" : null)" asp-area="" asp-controller="Home" asp-action="Index" aria-current="@(isHome ? "page" : null)">
                            <i class="bi bi-house-door" aria-hidden="true"></i>Accueil
                        </a>
                        @if (User?.Identity?.IsAuthenticated == true && AppRoles.CanAccessDashboard(User))
                        {
                            <a class="nav-link @(isDashboard && IsAction("Index") ? "active" : null)" asp-controller="Dashboard" asp-action="Index" aria-current="@(isDashboard && IsAction("Index") ? "page" : null)">
                                <i class="bi bi-speedometer2" aria-hidden="true"></i>Tableau de bord
                            </a>
                        }
                        @if (User?.Identity?.IsAuthenticated == true
                             && (AppRoles.IsTitulaire(User)
                                 || User.IsInRole(AppRoles.Pharmacien)
                                 || User.IsInRole(AppRoles.Vendeur)
                                 || User.IsInRole(AppRoles.Caissier)
                                 || User.IsInRole(AppRoles.AssistantPharmacien)
                                 || User.IsInRole(AppRoles.Assistant)
                                 || User.IsInRole(AppRoles.GestionnaireStock)))
                        {
                            <a class="nav-link @(isAlerts ? "active" : null)" asp-controller="Alerts" asp-action="Index" aria-current="@(isAlerts ? "page" : null)">
                                <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>Alertes
                            </a>
                        }
                    </div>
                }

                @if (showCatalogueSection)
                {
                    <div class="ph-nav-section">
                        <span class="ph-nav-label">Catalogue</span>
                        <a class="nav-link @(IsCtrl("Products") ? "active" : null)" asp-controller="Products" asp-action="Index" aria-current="@(IsCtrl("Products") ? "page" : null)">
                            <i class="bi bi-capsule" aria-hidden="true"></i>Produits
                        </a>
                        @if (User?.Identity?.IsAuthenticated == true && AppRoles.CanManageCatalog(User))
                        {
                            <a class="nav-link @(IsCtrl("Categories") ? "active" : null)" asp-controller="Categories" asp-action="Index" aria-current="@(IsCtrl("Categories") ? "page" : null)">
                                <i class="bi bi-bookmark" aria-hidden="true"></i>Catégories
                            </a>
                            <a class="nav-link @(IsCtrl("Suppliers") ? "active" : null)" asp-controller="Suppliers" asp-action="Index" aria-current="@(IsCtrl("Suppliers") ? "page" : null)">
                                <i class="bi bi-building" aria-hidden="true"></i>Fournisseurs
                            </a>
                        }
                        @if (User?.Identity?.IsAuthenticated == true && AppRoles.CanManageUsersAccounts(User))
                        {
                            <a class="nav-link @(IsCtrl("ProductImports") ? "active" : null)" asp-controller="ProductImports" asp-action="Upload" aria-current="@(IsCtrl("ProductImports") ? "page" : null)">
                                <i class="bi bi-file-earmark-spreadsheet" aria-hidden="true"></i>Import produits
                            </a>
                        }
                    </div>
                }

                @if (showStockSection)
                {
                    <div class="ph-nav-section">
                        <span class="ph-nav-label">Stock</span>
                        <a class="nav-link @(IsCtrl("Batches") ? "active" : null)" asp-controller="Batches" asp-action="Index" aria-current="@(IsCtrl("Batches") ? "page" : null)">
                            <i class="bi bi-layers" aria-hidden="true"></i>Lots
                        </a>
                        <a class="nav-link @(IsCtrl("StockMovements") ? "active" : null)" asp-controller="StockMovements" asp-action="Index" aria-current="@(IsCtrl("StockMovements") ? "page" : null)">
                            <i class="bi bi-arrow-down-up" aria-hidden="true"></i>Mouvements
                        </a>
                    </div>
                }

                @if (showCommerceSection)
                {
                    <div class="ph-nav-section">
                        <span class="ph-nav-label">Commerce</span>
                        @if (AppRoles.CanAccessSales(User!))
                        {
                            <a class="nav-link @(isSales ? "active" : null)" asp-controller="Sales" asp-action="Index" aria-current="@(isSales ? "page" : null)">
                                <i class="bi bi-cash-register" aria-hidden="true"></i>Ventes
                            </a>
                            <a class="nav-link @(IsCtrl("Bons") ? "active" : null)" asp-controller="Bons" asp-action="Index" aria-current="@(IsCtrl("Bons") ? "page" : null)">
                                <i class="bi bi-receipt-cutoff" aria-hidden="true"></i>Bons
                            </a>
                            <a class="nav-link @(IsCtrl("Avoirs") ? "active" : null)" asp-controller="Avoirs" asp-action="Index" aria-current="@(IsCtrl("Avoirs") ? "page" : null)">
                                <i class="bi bi-arrow-return-left" aria-hidden="true"></i>Avoirs
                            </a>
                        }
                        @if (AppRoles.CanAccessCaisseMenu(User!))
                        {
                            <a class="nav-link @(IsCtrl("Caisse") ? "active" : null)" asp-controller="Caisse" asp-action="Index" aria-current="@(IsCtrl("Caisse") ? "page" : null)">
                                <i class="bi bi-safe" aria-hidden="true"></i>Caisses
                            </a>
                        }
                        @if (AppRoles.CanAccessPurchasing(User!))
                        {
                            <a class="nav-link @(IsCtrl("PurchaseOrders") ? "active" : null)" asp-controller="PurchaseOrders" asp-action="Index" aria-current="@(IsCtrl("PurchaseOrders") ? "page" : null)">
                                <i class="bi bi-bag-check" aria-hidden="true"></i>Commandes fournisseurs
                            </a>
                        }
                        @if (AppRoles.CanAccessGoodsReceipts(User!))
                        {
                            <a class="nav-link @(IsCtrl("GoodsReceipts") ? "active" : null)" asp-controller="GoodsReceipts" asp-action="Index" aria-current="@(IsCtrl("GoodsReceipts") ? "page" : null)">
                                <i class="bi bi-box-seam" aria-hidden="true"></i>Bons de livraison
                            </a>
                        }
                    </div>
                }

                @if (showPatientsSection)
                {
                    <div class="ph-nav-section">
                        <span class="ph-nav-label">Patients</span>
                        <a class="nav-link @(IsCtrl("Patients") ? "active" : null)" asp-controller="Patients" asp-action="Index" aria-current="@(IsCtrl("Patients") ? "page" : null)">
                            <i class="bi bi-person-lines-fill" aria-hidden="true"></i>Portefeuille
                        </a>
                        <a class="nav-link @(IsCtrl("PatientRemindersAlerts") ? "active" : null)" asp-controller="PatientRemindersAlerts" asp-action="Index" aria-current="@(IsCtrl("PatientRemindersAlerts") ? "page" : null)">
                            <i class="bi bi-alarm" aria-hidden="true"></i>Rappels à traiter
                        </a>
                    </div>
                }

                @if (showDonneesSection)
                {
                    <div class="ph-nav-section">
                        <span class="ph-nav-label">Données</span>
                        <a class="nav-link @(isReports && IsAction("Index") ? "active" : null)" asp-controller="Reports" asp-action="Index" aria-current="@(isReports && IsAction("Index") ? "page" : null)">
                            <i class="bi bi-columns-gap" aria-hidden="true"></i>Vue d'ensemble
                        </a>
                        <a class="nav-link @(isReports && IsAction("StockStatus") ? "active" : null)" asp-controller="Reports" asp-action="StockStatus" aria-current="@(isReports && IsAction("StockStatus") ? "page" : null)">
                            <i class="bi bi-clipboard-data" aria-hidden="true"></i>État du stock
                        </a>
                        @if (AppRoles.CanAccessStockReports(User!))
                        {
                            <a class="nav-link @(isReports && IsAction("NearExpiration") ? "active" : null)" asp-controller="Reports" asp-action="NearExpiration" aria-current="@(isReports && IsAction("NearExpiration") ? "page" : null)">
                                <i class="bi bi-hourglass-split" aria-hidden="true"></i>Proches expiration
                            </a>
                            <a class="nav-link @(isReports && IsAction("ExpiredProducts") ? "active" : null)" asp-controller="Reports" asp-action="ExpiredProducts" aria-current="@(isReports && IsAction("ExpiredProducts") ? "page" : null)">
                                <i class="bi bi-calendar-x" aria-hidden="true"></i>Produits expirés
                            </a>
                        }
                        @if (AppRoles.CanAccessOperationalReports(User!))
                        {
                            <a class="nav-link @(isReports && IsAction("SalesHistory") ? "active" : null)" asp-controller="Reports" asp-action="SalesHistory" aria-current="@(isReports && IsAction("SalesHistory") ? "page" : null)">
                                <i class="bi bi-receipt" aria-hidden="true"></i>Historique ventes
                            </a>
                            <a class="nav-link @(isReports && IsAction("StockMovementsHistory") ? "active" : null)" asp-controller="Reports" asp-action="StockMovementsHistory" aria-current="@(isReports && IsAction("StockMovementsHistory") ? "page" : null)">
                                <i class="bi bi-arrow-left-right" aria-hidden="true"></i>Historique mouvements
                            </a>
                        }
                        @if (showPerformanceVendeurs)
                        {
                            <a class="nav-link @(isReports && IsActionAny("VendeursDuJour", "ExportVendeursCsv") ? "active" : null)" asp-controller="Reports" asp-action="VendeursDuJour" aria-current="@(isReports && IsActionAny("VendeursDuJour", "ExportVendeursCsv") ? "page" : null)">
                                <i class="bi bi-bar-chart-steps" aria-hidden="true"></i>Performance vendeurs
                            </a>
                        }
                    </div>
                }

                @if (User?.Identity?.IsAuthenticated == true && AppRoles.CanAccessFinances(User))
                {
                    <div class="ph-nav-section">
                        <span class="ph-nav-label">Finances</span>
                        <a class="nav-link @(isDashboard && IsAction("Finances") ? "active" : null)" asp-controller="Dashboard" asp-action="Finances" aria-current="@(isDashboard && IsAction("Finances") ? "page" : null)">
                            <i class="bi bi-graph-up-arrow" aria-hidden="true"></i>Finances
                        </a>
                        <a class="nav-link @(isReports && IsActionAny("EtatTVA", "EtatTVAPrint", "ExportTVAPdf") ? "active" : null)" asp-controller="Reports" asp-action="EtatTVA" aria-current="@(isReports && IsActionAny("EtatTVA", "EtatTVAPrint", "ExportTVAPdf") ? "page" : null)">
                            <i class="bi bi-percent" aria-hidden="true"></i>TVA / DGID
                        </a>
                        <a class="nav-link @(isReports && IsActionAny("Recapitulatif", "ExportRecapitulatifCSV") ? "active" : null)" asp-controller="Reports" asp-action="Recapitulatif" aria-current="@(isReports && IsActionAny("Recapitulatif", "ExportRecapitulatifCSV") ? "page" : null)">
                            <i class="bi bi-journal-richtext" aria-hidden="true"></i>Récapitulatif
                        </a>
                        <a class="nav-link @(isReports && IsActionAny("RapportCA", "ExportRapportCACSV") ? "active" : null)" asp-controller="Reports" asp-action="RapportCA" aria-current="@(isReports && IsActionAny("RapportCA", "ExportRapportCACSV") ? "page" : null)">
                            <i class="bi bi-cash-coin" aria-hidden="true"></i>Rapport CA
                        </a>
                    </div>
                }

                @if (showAdminSection || showVendeursMenu)
                {
                    <div class="ph-nav-section">
                        <span class="ph-nav-label">Administration</span>
                        @if (showAdminSection)
                        {
                            <a class="nav-link @(isAdminUsers && IsActionAny("Index", "Create", "Edit", "DeleteWithReport") ? "active" : null)" asp-controller="AdminUsers" asp-action="Index" aria-current="@(isAdminUsers && IsActionAny("Index", "Create", "Edit", "DeleteWithReport") ? "page" : null)">
                                <i class="bi bi-person-gear" aria-hidden="true"></i>Utilisateurs
                            </a>
                            <a class="nav-link @(isAdminUsers && IsActionAny("ActivityReports", "ActivityReportDetails", "ExportActivityReportCsv") ? "active" : null)" asp-controller="AdminUsers" asp-action="ActivityReports" aria-current="@(isAdminUsers && IsActionAny("ActivityReports", "ActivityReportDetails", "ExportActivityReportCsv") ? "page" : null)">
                                <i class="bi bi-archive" aria-hidden="true"></i>Rapports utilisateurs
                            </a>
                        }
                        @if (showVendeursMenu)
                        {
                            <a class="nav-link @(isVendeurs ? "active" : null)" asp-controller="Vendeurs" asp-action="Index" aria-current="@(isVendeurs ? "page" : null)">
                                <i class="bi bi-people" aria-hidden="true"></i>Vendeurs
                            </a>
                        }
                    </div>
                }
            </nav>

            @if (User?.Identity?.IsAuthenticated == true)
            {
                <div class="ph-sidebar-user">
                    <i class="bi bi-person-circle" aria-hidden="true"></i>
                    <span class="text-truncate">@User.Identity?.Name</span>
                </div>
            }
        </aside>

        <div class="ph-sidebar-overlay d-lg-none"
             id="sidebarOverlay"
             aria-hidden="true"></div>

        <div class="ph-main">
            <header class="ph-topbar">
                <button class="ph-burger btn btn-link p-0 me-3 d-lg-none"
                        type="button"
                        id="sidebarToggleMobile"
                        aria-label="Ouvrir le menu"
                        aria-expanded="false">
                    <i class="bi bi-list fs-3 text-dark" aria-hidden="true"></i>
                </button>
                <h6 class="ph-page-title mb-0">@ViewData["Title"]</h6>
                <span class="ph-mobile-nav-hint text-muted small">Menu latéral sur grand écran</span>
                <div class="ph-topbar-actions">
                    @if (User?.Identity?.IsAuthenticated == true && AppRoles.IsTitulaire(User))
                    {
                        <button type="button"
                                id="btn-install"
                                class="btn btn-sm btn-outline-success d-none ms-2"
                                title="Installer l'application sur ce poste">
                            <i class="bi bi-download" aria-hidden="true"></i>
                            <span class="d-none d-md-inline">Installer</span>
                        </button>
                    }
                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        <small class="text-muted d-none d-lg-inline me-2">
                            Cliquez ici avant de fermer →
                        </small>
                        <form asp-area="Identity"
                              asp-page="/Account/Logout"
                              asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                              method="post"
                              class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="btn btn-danger btn-sm"
                                    title="Terminer ma session et déconnecter">
                                <i class="bi bi-power" aria-hidden="true"></i>
                                <span class="d-none d-md-inline ms-1">Terminer la session</span>
                            </button>
                        </form>
                    }
                    <partial name="_LoginPartial" />
                </div>
            </header>

            <main id="main-content" role="main" class="ph-content-wrapper" tabindex="-1">
                <div class="app-flash-stack mb-3">
                    <partial name="_FlashMessages" />
                </div>
                @RenderBody()
            </main>

            <footer class="app-footer">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 px-3 px-md-4 py-3">
                    <span>&copy; 2026 — Pharmacie Saint Jean Paul II</span>
                    <span><a asp-area="" asp-controller="Home" asp-action="Privacy">Confidentialité</a></span>
                </div>
            </footer>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script>
      if (window.toastr) {
        toastr.options = {
          closeButton: true,
          progressBar: true,
          positionClass: "toast-top-right",
          timeOut: 4000,
          extendedTimeOut: 1000
        };
      }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js" crossorigin="anonymous"></script>
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        document.addEventListener('click', function (e) {
          const btn = e.target.closest('[data-confirm]');
          if (!btn) return;

          const form = btn.closest('form');
          if (!form) return;

          e.preventDefault();

          const message = btn.dataset.confirm || 'Cette action est irréversible.';

          if (!window.Swal) {
            if (confirm(message)) {
              if (form.requestSubmit) {
                form.requestSubmit(btn);
              } else {
                form.submit();
              }
            }
            return;
          }

          Swal.fire({
            title: 'Confirmer',
            text: message,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#EF4444',
            cancelButtonColor: '#64748B',
            confirmButtonText: 'Confirmer',
            cancelButtonText: 'Annuler'
          }).then((result) => {
            if (result.isConfirmed) {
              if (form.requestSubmit) {
                form.requestSubmit(btn);
              } else {
                form.submit();
              }
            }
          });
        });

        if (typeof window.processAppFlashMessages === 'function') {
          window.processAppFlashMessages();
        }
      });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/fr.js" crossorigin="anonymous"></script>
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        if (!window.flatpickr) {
          return;
        }

        flatpickr("input[type='date']:not([data-flatpickr-disabled]):not([data-flatpickr-ignore])", {
          locale: "fr",
          dateFormat: "Y-m-d",
          altInput: true,
          altFormat: "d/m/Y",
          allowInput: true
        });

        flatpickr("input[type='datetime-local']:not([data-flatpickr-disabled]):not([data-flatpickr-ignore])", {
          locale: "fr",
          dateFormat: "Y-m-dTH:i",
          altInput: true,
          altFormat: "d/m/Y à H:i",
          enableTime: true,
          time_24hr: true,
          allowInput: true
        });
      });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
(function () {
  'use strict';
  var toggle  = document.getElementById('sidebarToggleMobile');
  var sidebar = document.getElementById('sidebar');
  var overlay = document.getElementById('sidebarOverlay');
  if (!toggle || !sidebar || !overlay) return;

  function openSidebar() {
    sidebar.classList.add('sidebar-open');
    overlay.classList.add('active');
    document.body.style.overflow = 'hidden';
    toggle.setAttribute('aria-expanded', 'true');
  }

  function closeSidebar() {
    sidebar.classList.remove('sidebar-open');
    overlay.classList.remove('active');
    document.body.style.overflow = '';
    toggle.setAttribute('aria-expanded', 'false');
  }

  toggle.addEventListener('click', openSidebar);
  overlay.addEventListener('click', closeSidebar);

  sidebar.querySelectorAll('a.nav-link').forEach(function (link) {
    link.addEventListener('click', closeSidebar);
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeSidebar();
  });
})();
    </script>
    <script>
(function() {
  'use strict';
  var sidebar = document.getElementById('sidebar');
  if (!sidebar) return;

  // Restaurer la position sauvegardée
  var savedScroll = sessionStorage.getItem('sidebarScrollTop');
  if (savedScroll) {
    sidebar.scrollTop = parseInt(savedScroll, 10);
  }

  // Sauvegarder la position avant chaque navigation
  sidebar.addEventListener('scroll', function() {
    sessionStorage.setItem('sidebarScrollTop', sidebar.scrollTop);
  });

  // Aussi sauvegarder au clic sur un lien
  sidebar.querySelectorAll('a.nav-link').forEach(function(link) {
    link.addEventListener('click', function() {
      sessionStorage.setItem('sidebarScrollTop', sidebar.scrollTop);
    });
  });
})();
    </script>
    <script>
function togglePassword(fieldId) {
  var field = document.getElementById(fieldId);
  var icon = document.querySelector(
    '[onclick="togglePassword(\'' + fieldId + '\')"] i');
  if (!field) return;
  if (field.type === 'password') {
    field.type = 'text';
    if (icon) {
      icon.classList.remove('bi-eye');
      icon.classList.add('bi-eye-slash');
    }
  } else {
    field.type = 'password';
    if (icon) {
      icon.classList.remove('bi-eye-slash');
      icon.classList.add('bi-eye');
    }
  }
}
    </script>
    <script>
      var isAdmin = @(User?.Identity?.IsAuthenticated == true && AppRoles.IsTitulaire(User) ? "true" : "false");
      var btnInstall = document.getElementById('btn-install');
      var deferredPrompt;

      window.addEventListener('beforeinstallprompt', function (e) {
        e.preventDefault();
        deferredPrompt = e;
        if (isAdmin && btnInstall) {
          btnInstall.classList.remove('d-none');
        }
      });

      if (btnInstall) {
        btnInstall.addEventListener('click', async function () {
          if (!deferredPrompt) return;
          deferredPrompt.prompt();
          var choice = await deferredPrompt.userChoice;
          if (choice.outcome === 'accepted') {
            btnInstall.classList.add('d-none');
            if (window.toastr) {
              toastr.success('Application installée sur ce poste !', 'Installation réussie');
            }
          }
          deferredPrompt = null;
        });
      }

      window.addEventListener('appinstalled', function () {
        if (btnInstall) btnInstall.classList.add('d-none');
        deferredPrompt = null;
      });

      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker
            .register('/sw.js')
            .then(function () {
              console.log('Service Worker enregistré');
            })
            .catch(function (err) {
              console.log('Service Worker échec:', err);
            });
        });
      }
    </script>
    <script>
(function () {
  'use strict';

  // beforeunload retiré (non fiable sur Chrome).
  // pagehide + sendBeacon conservé pour PWA / navigateurs qui le supportent.
  var isAuthenticated = @(User?.Identity?.IsAuthenticated == true ? "true" : "false");
  if (!isAuthenticated) return;

  var isInternalNavigation = false;

  document.addEventListener('click', function (e) {
    var link = e.target.closest('a');
    var btn = e.target.closest('button[type="submit"]');
    if (link || btn) {
      isInternalNavigation = true;
      setTimeout(function () {
        isInternalNavigation = false;
      }, 2000);
    }
  });

  document.addEventListener('submit', function () {
    isInternalNavigation = true;
    setTimeout(function () {
      isInternalNavigation = false;
    }, 2000);
  });

  window.addEventListener('pagehide', function (e) {
    if (isInternalNavigation) return;
    if (!e.persisted) {
      var token = document.getElementById('global-antiforgery-token');
      if (token && navigator.sendBeacon) {
        navigator.sendBeacon('/logout-silent',
          new URLSearchParams({
            '__RequestVerificationToken': token.value
          })
        );
      }
    }
  });
})();
    </script>
