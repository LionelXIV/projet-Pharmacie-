@model DashboardFinancesViewModel
@{
    ViewData["Title"] = "Finances";
    var avgBasket = Model.TotalVentes > 0 ? Model.TotalCa / Model.TotalVentes : 0m;
    var tauxGlobal = Model.TotalCa > 0 ? (Model.TotalMarge / Model.TotalCa) * 100m : 0m;
}

<div class="page-header">
    <div class="d-flex flex-column flex-md-row align-items-md-start justify-content-md-between gap-3">
        <div>
            <h1 class="page-title">Finances</h1>
            <p class="page-lead mb-0">
                Du <strong>@Model.From.ToString("dd/MM/yyyy")</strong>
                au <strong>@Model.To.ToString("dd/MM/yyyy")</strong>
                · Accès Pharmacien Titulaire
            </p>
        </div>
        <a class="btn btn-outline-secondary btn-sm" asp-action="Index">
            <i class="bi bi-speedometer2 me-1" aria-hidden="true"></i>Tableau de bord
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-semibold mb-1">CA (30 j)</div>
                <div class="fs-4 fw-bold">@ReportCsvFormatter.FormatFcfa(Model.TotalCa)</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-semibold mb-1">Marge brute</div>
                <div class="fs-4 fw-bold text-success">@ReportCsvFormatter.FormatFcfa(Model.TotalMarge)</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-semibold mb-1">Panier moyen</div>
                <div class="fs-4 fw-bold text-primary">@ReportCsvFormatter.FormatFcfa(avgBasket)</div>
                <div class="small text-muted">@Model.TotalVentes vente(s)</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small text-uppercase fw-semibold mb-1">Taux de marge</div>
                <div class="fs-4 fw-bold text-warning">@tauxGlobal.ToString("N1") %</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm table-card h-100">
            <div class="card-header bg-white border-bottom py-3">
                <span class="fw-semibold">
                    <i class="bi bi-calendar3 me-2 text-primary" aria-hidden="true"></i>
                    Marge et panier moyen par jour
                </span>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th class="text-end">Ventes</th>
                            <th class="text-end">CA</th>
                            <th class="text-end">Marge brute</th>
                            <th class="text-end">Panier moyen</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.Days)
                        {
                            <tr class="@(d.Date == Model.To ? "table-primary" : null)">
                                <td class="text-nowrap">@d.Date.ToString("dd/MM/yyyy")</td>
                                <td class="text-end">@d.NbVentes</td>
                                <td class="text-end">@ReportCsvFormatter.FormatFcfa(d.Ca)</td>
                                <td class="text-end text-success">@ReportCsvFormatter.FormatFcfa(d.MargeBrute)</td>
                                <td class="text-end">@ReportCsvFormatter.FormatFcfa(d.PanierMoyen)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm table-card h-100">
            <div class="card-header bg-white border-bottom py-3">
                <span class="fw-semibold">
                    <i class="bi bi-wallet2 me-2 text-primary" aria-hidden="true"></i>
                    Répartition par moyen de paiement
                </span>
            </div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Paiement</th>
                            <th class="text-end">Ventes</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.PaymentBreakdown)
                        {
                            <tr>
                                <td>
                                    <span class="badge @PaymentMethodDisplay.BadgeCssClass(p.PaymentMethod)">
                                        @PaymentMethodDisplay.GetName(p.PaymentMethod)
                                    </span>
                                </td>
                                <td class="text-end">@p.SaleCount</td>
                                <td class="text-end fw-medium">@ReportCsvFormatter.FormatFcfa(p.Total)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="small text-muted px-3 py-2 mb-0">
                Période cumulée (30 derniers jours). Saisie manuelle du mode de paiement à la vente.
            </p>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm mt-3 mb-3">
    <div class="card-header bg-white fw-bold">
        <i class="bi bi-pie-chart me-1" aria-hidden="true"></i>
        Répartition CA par mode de paiement
        (@(ViewBag.NbJours ?? 30) derniers jours)
    </div>
    <div class="card-body">
        <div class="row g-3 align-items-center">
            <div class="col-md-6">
                <div class="ph-chart-container" style="height: 300px;">
                    <canvas id="chart-paiements-finances"
                            aria-label="Répartition CA par mode de paiement"
                            role="img"></canvas>
                </div>
            </div>
            <div class="col-md-6">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Mode</th>
                            <th class="text-end">CA</th>
                            <th class="text-end">%</th>
                        </tr>
                    </thead>
                    <tbody id="paiements-tbody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm mt-3">
  <div class="card-header fw-bold d-flex justify-content-between align-items-center">
    <span>
      <i class="bi bi-table me-1"></i>
      Tableau CA journalier (30 derniers jours)
    </span>
    <button type="button" onclick="window.print()"
            class="btn btn-sm btn-outline-success no-print">
      <i class="bi bi-printer me-1"></i>
      Imprimer
    </button>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-bordered table-sm table-hover mb-0">
        <thead class="table-dark">
          <tr>
            <th>DATE</th>
            <th class="text-end">MONTANT EXONÉRÉ</th>
            <th class="text-end">MONTANT HT</th>
            <th class="text-end">TVA 18%</th>
            <th class="text-end fw-bold">MONTANT TTC</th>
          </tr>
        </thead>
        <tbody id="tableau-journalier-body">
        </tbody>
        <tfoot class="table-warning fw-bold">
          <tr>
            <td>TOTAL</td>
            <td class="text-end" id="total-exonere">—</td>
            <td class="text-end" id="total-ht">—</td>
            <td class="text-end" id="total-tva">—</td>
            <td class="text-end" id="total-ttc">—</td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>
</div>

<style>
@@media print {
    .no-print { display: none !important; }
    .sidebar { display: none !important; }
    .topbar { display: none !important; }
}
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
      (function () {
        var tableauData = @Html.Raw(ViewBag.TableauJournalier ?? "[]");
        var tbody = document.getElementById('tableau-journalier-body');
        if (!tbody) return;
        var totExo = 0, totHT = 0, totTVA = 0, totTTC = 0;
        tableauData.forEach(function (ligne) {
          var date = new Date(ligne.Date);
          var dateStr = date.toLocaleDateString('fr-FR');
          totExo += ligne.Exonere;
          totHT += ligne.HT;
          totTVA += ligne.TVA;
          totTTC += ligne.TTC;
          tbody.innerHTML +=
            '<tr>' +
            '<td>' + dateStr + '</td>' +
            '<td class="text-end">' + Math.round(ligne.Exonere).toLocaleString('fr-FR') + ' F</td>' +
            '<td class="text-end">' + Math.round(ligne.HT).toLocaleString('fr-FR') + ' F</td>' +
            '<td class="text-end">' + Math.round(ligne.TVA).toLocaleString('fr-FR') + ' F</td>' +
            '<td class="text-end fw-bold">' + Math.round(ligne.TTC).toLocaleString('fr-FR') + ' F</td>' +
            '</tr>';
        });
        document.getElementById('total-exonere').textContent =
          Math.round(totExo).toLocaleString('fr-FR') + ' F';
        document.getElementById('total-ht').textContent =
          Math.round(totHT).toLocaleString('fr-FR') + ' F';
        document.getElementById('total-tva').textContent =
          Math.round(totTVA).toLocaleString('fr-FR') + ' F';
        document.getElementById('total-ttc').textContent =
          Math.round(totTTC).toLocaleString('fr-FR') + ' F';
      })();

      document.addEventListener('DOMContentLoaded', function () {
        if (!window.Chart) return;

        var labels = @Html.Raw(ViewBag.PaiementLabels ?? "[]");
        var data = @Html.Raw(ViewBag.PaiementData ?? "[]");
        var colors = ['#4CAF82', '#3B82F6', '#F97316', '#8B5CF6', '#EC4899', '#94A3B8'];
        var total = data.reduce(function (a, b) { return a + b; }, 0);
        var tbody = document.getElementById('paiements-tbody');
        if (tbody) {
          tbody.innerHTML = labels.map(function (label, i) {
            var val = data[i] || 0;
            var pct = total > 0 ? Math.round(val / total * 100) : 0;
            return '<tr><td>' + label + '</td>' +
              '<td class="text-end">' + Math.round(val).toLocaleString('fr-FR') + ' FCFA</td>' +
              '<td class="text-end">' + pct + ' %</td></tr>';
          }).join('');
        }

        var canvas = document.getElementById('chart-paiements-finances');
        if (!canvas) return;

        new Chart(canvas, {
          type: 'doughnut',
          data: {
            labels: labels,
            datasets: [{
              data: data,
              backgroundColor: colors,
              borderWidth: 2,
              borderColor: '#fff'
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: {
                position: 'bottom',
                labels: { padding: 12, boxWidth: 12, font: { size: 11 } }
              },
              tooltip: {
                callbacks: {
                  label: function (ctx) {
                    var sum = ctx.dataset.data.reduce(function (a, b) { return a + b; }, 0);
                    var pct = sum > 0 ? Math.round(ctx.parsed / sum * 100) : 0;
                    return ctx.label + ' : ' +
                      Number(ctx.parsed).toLocaleString('fr-FR') +
                      ' FCFA (' + pct + '%)';
                  }
                }
              }
            }
          }
        });
      });
    </script>
}
