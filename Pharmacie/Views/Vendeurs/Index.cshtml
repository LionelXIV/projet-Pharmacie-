@model IEnumerable<Vendeur>
@{
    ViewData["Title"] = "Vendeurs";

    string BadgeClass(string? couleur) => couleur switch
    {
        "Bleu" => "bg-primary",
        "Jaune" => "bg-warning text-dark",
        "Vert" => "bg-success",
        "Rose" => "",
        _ => "bg-secondary"
    };
}

<div class="page-header">
    <div class="d-flex flex-column flex-md-row align-items-md-start justify-content-md-between gap-3">
        <div>
            <h1 class="page-title">Vendeurs</h1>
            <p class="page-lead mb-0">Noms pour les tickets et le CA à la caisse — pas de comptes de connexion. La sélection se fait uniquement à l’encaissement.</p>
        </div>
        <a class="btn btn-primary flex-shrink-0" asp-action="Create"><i class="bi bi-person-plus me-1" aria-hidden="true"></i>Nouveau vendeur</a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="app-empty-state my-3" role="status">
        <i class="bi bi-people" aria-hidden="true"></i>
        <p class="app-empty-state-title mb-1">Aucun vendeur</p>
        <p class="mb-0 small">Créez un vendeur pour l'associer aux ventes à la caisse.</p>
        <a class="btn btn-primary btn-sm mt-3" asp-action="Create"><i class="bi bi-person-plus me-1" aria-hidden="true"></i>Nouveau vendeur</a>
    </div>
}
else
{
    <div class="table-card mb-3">
        <div class="table-responsive">
            <table class="table table-striped table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Couleur ticket</th>
                        <th>Statut</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@v.Nom</td>
                            <td>
                                @if (string.IsNullOrEmpty(v.CouleurTicket))
                                {
                                    <span class="text-muted">—</span>
                                }
                                else if (v.CouleurTicket == "Rose")
                                {
                                    <span class="badge text-white" style="background:#FF69B4">@v.CouleurTicket</span>
                                }
                                else
                                {
                                    <span class="badge @BadgeClass(v.CouleurTicket)">@v.CouleurTicket</span>
                                }
                            </td>
                            <td>
                                @if (v.IsActif)
                                {
                                    <span class="badge bg-success">Actif</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactif</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-primary py-0" asp-action="Edit" asp-route-id="@v.Id">Modifier</a>
                                <form asp-action="Toggle" asp-route-id="@v.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-secondary py-0"
                                            data-confirm="@(v.IsActif ? $"Désactiver « {v.Nom} » ?" : $"Activer « {v.Nom} » ?")">
                                        @(v.IsActif ? "Désactiver" : "Activer")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
