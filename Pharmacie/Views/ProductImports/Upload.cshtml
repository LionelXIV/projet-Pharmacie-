@model ProductImportUploadViewModel
@{
    ViewData["Title"] = "Import produits";
}

<div class="page-header">
    <h1 class="page-title">Import produits</h1>
    <p class="page-lead mb-0">Téléversez un fichier Excel <strong>.xlsx</strong> pour prévisualiser l'import avant confirmation.</p>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 border-bottom d-flex align-items-center gap-2">
                <i class="bi bi-file-earmark-spreadsheet text-primary fs-5" aria-hidden="true"></i>
                <span class="fw-semibold">Fichier d'import</span>
            </div>
            <div class="card-body p-3 p-md-4">
                <form asp-action="Upload" method="post" enctype="multipart/form-data" id="upload-import-form">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <p class="small text-muted mb-3">
                        Colonnes attendues (ordre libre) : <strong>Code produit (CIP)</strong>,
                        <strong>Nom du produit</strong>, <strong>Quantité</strong>,
                        <strong>Prix d'achat</strong>, <strong>Prix de vente</strong>
                        (référence fournisseur optionnelle).
                    </p>

                    <div class="mb-3">
                        <label asp-for="File" class="form-label"></label>
                        <input asp-for="File" class="form-control" type="file" accept=".xlsx" />
                        <span asp-validation-for="File" class="text-danger"></span>
                    </div>

                    <div class="mt-4 pt-3 border-top d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-upload me-1" aria-hidden="true"></i>Analyser le fichier
                        </button>
                        <a class="btn btn-outline-secondary" asp-controller="Products" asp-action="Index">Retour au catalogue</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
document.getElementById('upload-import-form').addEventListener('submit', function () {
  var overlay = document.createElement('div');
  overlay.style.cssText =
    'position:fixed;inset:0;background:rgba(15,45,30,0.7);' +
    'z-index:9999;display:flex;flex-direction:column;' +
    'align-items:center;justify-content:center;gap:1rem;';

  overlay.innerHTML =
    '<div class="spinner-border text-light" style="width:3rem;height:3rem;" role="status"></div>' +
    '<div style="color:#fff;font-size:1.1rem;font-weight:600;">Analyse du fichier en cours...</div>' +
    '<div style="color:#A9DFBF;font-size:0.9rem;">Ne fermez pas cette page</div>';

  document.body.appendChild(overlay);
});
    </script>
}
