@model List<PanierCommandeLigne>
@{
    ViewData["Title"] = "Panier de commande";
    var parFournisseur = ViewBag.ParFournisseur as List<PanierFournisseurGroupe>
        ?? new List<PanierFournisseurGroupe>();
    var nbLignes = ViewBag.NbLignes as int? ?? Model.Count;
    var nbFournisseurs = ViewBag.NbFournisseurs as int? ?? parFournisseur.Count;
    var searchUrl = Url.Action("Search", "Products") ?? "/Products/Search";
}

<div class="page-header">
    <div class="d-flex flex-column flex-md-row align-items-md-start justify-content-md-between gap-3">
        <div>
            <h1 class="page-title">
                <i class="bi bi-cart3 me-2"></i>
                Panier de commande
            </h1>
            <div class="text-muted small">
                @nbLignes produit(s) — @nbFournisseurs fournisseur(s)
            </div>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <form asp-action="ViderPanier" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="btn btn-sm btn-outline-danger"
                        onclick="return confirm('Vider le panier ?')">
                    <i class="bi bi-trash3 me-1"></i>
                    Vider
                </button>
            </form>
            <form asp-action="ValiderPanier" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success" @(Model.Count == 0 ? "disabled" : null)>
                    <i class="bi bi-check-circle me-1"></i>
                    Valider et créer les commandes
                </button>
            </form>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-3">
        <span class="fw-bold small me-3">Ajouter des suggestions :</span>
        <div class="d-inline-flex flex-wrap gap-2">
            <form asp-action="AjouterSuggestions" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="source" value="Rupture">
                <button type="submit" class="btn btn-sm btn-danger">
                    <i class="bi bi-x-circle me-1"></i>
                    Ruptures
                </button>
            </form>
            <form asp-action="AjouterSuggestions" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="source" value="StockFaible">
                <button type="submit" class="btn btn-sm btn-warning text-dark">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    Stock faible
                </button>
            </form>
            <form asp-action="AjouterSuggestions" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="source" value="TopVente">
                <button type="submit" class="btn btn-sm btn-info text-white">
                    <i class="bi bi-graph-up me-1"></i>
                    Top ventes faibles
                </button>
            </form>
        </div>

        <div class="mt-3">
            <form asp-action="AjouterProduit" method="post" class="row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <div class="col-md-4">
                    <label class="form-label small mb-0" for="productId">Ajout manuel</label>
                    <select name="productId"
                            id="productId"
                            class="form-select form-select-sm"
                            data-tomselect-product="true"
                            data-url="@searchUrl"
                            required>
                        <option value="">Rechercher un produit...</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-0" for="quantite">Qté</label>
                    <input type="number"
                           name="quantite"
                           id="quantite"
                           class="form-control form-control-sm text-center"
                           value="1"
                           min="1"
                           placeholder="Qté">
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-sm btn-outline-success w-100">
                        <i class="bi bi-plus-circle me-1"></i>
                        Ajouter
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@foreach (var groupe in parFournisseur)
{
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white fw-bold d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span>
                <i class="bi bi-truck me-1"></i>
                @groupe.Nom
                <span class="badge bg-secondary ms-2">@groupe.Lignes.Count produit(s)</span>
            </span>
            <span class="text-muted small">
                Total : @groupe.Total.ToString("N0") FCFA
            </span>
        </div>
        <div class="table-responsive">
            <table class="table table-sm mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Produit</th>
                        <th class="text-center">Stock actuel</th>
                        <th class="text-center">Seuil</th>
                        <th class="text-center">Source</th>
                        <th class="text-center" style="width:120px">Quantité</th>
                        <th class="text-end">Prix achat</th>
                        <th class="text-end">Total</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ligne in groupe.Lignes)
                    {
                        var product = ligne.Product;
                        var stock = product?.StockQuantity ?? 0;
                        var source = ligne.Source ?? "";
                        var badgeSource = source.Contains("Rupture", StringComparison.OrdinalIgnoreCase)
                            ? "bg-danger"
                            : source.Contains("TopVente", StringComparison.OrdinalIgnoreCase)
                                ? "bg-info"
                                : source.Contains("Manuel", StringComparison.OrdinalIgnoreCase)
                                    ? "bg-success"
                                    : "bg-warning text-dark";
                        var prix = product?.PurchasePrice ?? 0m;

                        <tr>
                            <td class="fw-bold small">@(product?.CommercialName ?? $"#{ligne.ProductId}")</td>
                            <td class="text-center">
                                <span class="badge @(stock <= 0 ? "bg-danger" : "bg-warning text-dark")">
                                    @stock
                                </span>
                            </td>
                            <td class="text-center text-muted">@(product?.AlertThreshold ?? 0)</td>
                            <td class="text-center">
                                <span class="badge @badgeSource small">@source</span>
                            </td>
                            <td class="text-center">
                                <form asp-action="ModifierQuantite" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="ligneId" value="@ligne.Id">
                                    <input type="number"
                                           name="quantite"
                                           value="@ligne.QuantiteFinale"
                                           min="1"
                                           class="form-control form-control-sm text-center"
                                           style="width:80px"
                                           onchange="this.form.submit()">
                                </form>
                            </td>
                            <td class="text-end small text-muted">@prix.ToString("N0")</td>
                            <td class="text-end fw-bold">@((ligne.QuantiteFinale * prix).ToString("N0"))</td>
                            <td>
                                <form asp-action="SupprimerLigne" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="ligneId" value="@ligne.Id">
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger py-0 px-2"
                                            onclick="return confirm('Retirer ce produit ?')">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5 text-muted">
            <i class="bi bi-cart3 fs-1 mb-3 d-block"></i>
            <p class="fs-5 mb-1">Votre panier est vide.</p>
            <p class="mb-0">
                Cliquez sur un des boutons de suggestion ou ajoutez des produits manuellement.
            </p>
        </div>
    </div>
}

@section Scripts {
    <script>
      (function () {
        if (!window.TomSelect) return;
        document.querySelectorAll('[data-tomselect-product]').forEach(function (el) {
          if (el.tomselect) return;
          new TomSelect(el, {
            valueField: 'value',
            labelField: 'text',
            searchField: ['text'],
            placeholder: 'Rechercher un produit...',
            maxOptions: 25,
            preload: false,
            create: false,
            loadThrottle: 300,
            dropdownParent: 'body',
            load: function (query, callback) {
              if (!query || query.length < 2) {
                callback();
                return;
              }
              var url = (el.dataset.url || '/Products/Search') + '?term=' + encodeURIComponent(query);
              fetch(url)
                .then(function (r) { return r.json(); })
                .then(function (data) { callback(data); })
                .catch(function () { callback(); });
            }
          });
        });
      })();
    </script>
}
