@model List<InventaireItemViewModel>
@{
    ViewData["Title"] = "Inventaire physique";
    var categories = ViewBag.Categories as IEnumerable<Category> ?? Enumerable.Empty<Category>();
    var categorieId = ViewBag.CategorieId as int?;
}

@await Html.PartialAsync("_BackButton")

<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="bi bi-clipboard-check me-2"></i>
            Inventaire physique
        </h1>
        <p class="page-lead mb-0">Comptez les produits en rayon et corrigez les écarts.</p>
    </div>
</div>

<div class="card border-success mb-3">
    <div class="card-header bg-success text-white fw-bold">
        <i class="bi bi-upc-scan me-1"></i>
        Scanner un produit
    </div>
    <div class="card-body">
        <div class="row g-3 align-items-center">
            <div class="col-md-5">
                <label class="form-label small fw-bold" for="scan-input">
                    Scanner USB ou CIP manuel
                </label>
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-upc"></i>
                    </span>
                    <input type="text"
                           id="scan-input"
                           class="form-control"
                           placeholder="Scanner ou taper le CIP..."
                           autocomplete="off"
                           autofocus>
                </div>
                <div class="form-text">
                    Le scanner USB tape automatiquement ici. Appuyez Entrée pour valider.
                </div>
            </div>
            <div class="col-md-1 text-center d-none d-md-block">
                <span class="text-muted">ou</span>
            </div>
            <div class="col-md-6">
                <label class="form-label small fw-bold">
                    Scanner avec la caméra
                    <span class="badge bg-secondary ms-1">Téléphone</span>
                </label>
                <div>
                    <button type="button" id="btn-camera" class="btn btn-outline-success" onclick="startCamera()">
                        <i class="bi bi-camera me-1"></i>
                        Ouvrir la caméra
                    </button>
                    <button type="button" id="btn-stop-camera" class="btn btn-outline-danger ms-2"
                            style="display:none" onclick="stopCamera()">
                        <i class="bi bi-stop-circle me-1"></i>
                        Arrêter
                    </button>
                </div>
                <div id="camera-container" style="display:none" class="mt-2">
                    <video id="camera-video"
                           style="width:100%; max-width:300px; border-radius:8px"
                           autoplay muted playsinline>
                    </video>
                </div>
            </div>
        </div>
        <div id="scan-result" style="display:none"
             class="mt-3 p-3 rounded bg-success bg-opacity-10 border border-success">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <strong id="scan-nom"></strong>
                    <span class="text-muted small ms-2" id="scan-cip"></span>
                </div>
                <div>
                    <span class="badge bg-success fs-5" id="scan-count">1</span>
                    <span class="text-muted small ms-1">scanné(s)</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-bold" for="categorieId">Filtrer par catégorie</label>
                <select name="categorieId" id="categorieId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">Toutes les catégories</option>
                    @foreach (var cat in categories)
                    {
                        if (categorieId == cat.Id)
                        {
                            <option value="@cat.Id" selected>@cat.Name</option>
                        }
                        else
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-bold" for="search-inventaire">Recherche</label>
                <input type="text"
                       id="search-inventaire"
                       class="form-control form-control-sm"
                       placeholder="Rechercher un produit..."
                       oninput="filtrerInventaire(this.value)">
            </div>
            <div class="col-md-4 text-md-end">
                <span class="badge bg-primary fs-6">@Model.Count produits</span>
            </div>
        </form>
    </div>
</div>

<div class="alert alert-info py-2 mb-3">
    <i class="bi bi-info-circle me-1"></i>
    <strong>Mode inventaire :</strong>
    saisissez le stock physique compté pour chaque produit.
    Les écarts sont surlignés en rouge (manquant) ou en vert (surplus).
    Cliquez <strong>Valider</strong> pour appliquer les corrections.
</div>

<form asp-action="ValiderInventaire" method="post" id="form-inventaire">
    @Html.AntiForgeryToken()

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span class="fw-bold">
                <i class="bi bi-list-check me-1"></i>
                Liste des produits
            </span>
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="remplirTousEgaux()">
                    <i class="bi bi-check-all me-1"></i>
                    Stock OK partout
                </button>
                <button type="submit" class="btn btn-sm btn-success" onclick="return confirmerInventaire()">
                    <i class="bi bi-check-circle me-1"></i>
                    Valider les corrections
                </button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-sm mb-0 align-middle" id="table-inventaire">
                <thead class="table-light">
                    <tr>
                        <th>Produit</th>
                        <th>CIP</th>
                        <th>Catégorie</th>
                        <th class="text-center">Stock logiciel</th>
                        <th class="text-center" style="width:140px">
                            Stock physique
                            <span class="text-muted fw-normal small">(compté)</span>
                        </th>
                        <th class="text-center">Écart</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model.Count; i++)
                    {
                        var item = Model[i];
                        <tr class="inventaire-row" data-nom="@item.Nom.ToLowerInvariant()" data-cip="@(item.Cip ?? "")">
                            <td class="fw-bold small">
                                <input type="hidden" name="ajustements[@i].ProductId" value="@item.ProductId" />
                                <input type="hidden" name="ajustements[@i].StockLogiciel" value="@item.StockLogiciel" />
                                @item.Nom
                            </td>
                            <td class="text-muted small">@(item.Cip ?? "—")</td>
                            <td class="small">@item.Categorie</td>
                            <td class="text-center fw-bold">@item.StockLogiciel</td>
                            <td class="text-center">
                                <input type="number"
                                       name="ajustements[@i].StockPhysique"
                                       class="form-control form-control-sm text-center stock-physique"
                                       min="0"
                                       placeholder="—"
                                       data-logiciel="@item.StockLogiciel"
                                       oninput="calculerEcart(this)" />
                            </td>
                            <td class="text-center fw-bold" id="ecart-@item.ProductId">—</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</form>

@section Scripts {
    <script src="https://unpkg.com/@@zxing/library@@0.19.1/umd/index.min.js"></script>
    <script>
      function calculerEcart(input) {
        var logiciel = parseInt(input.dataset.logiciel, 10) || 0;
        var physique = parseInt(input.value, 10);
        var row = input.closest('tr');
        var ecartCell = row.querySelector('[id^="ecart-"]');

        if (isNaN(physique)) {
          ecartCell.textContent = '—';
          row.classList.remove('table-danger', 'table-success', 'table-warning');
          return;
        }

        var ecart = physique - logiciel;
        ecartCell.textContent = (ecart > 0 ? '+' : '') + ecart;
        row.classList.remove('table-danger', 'table-success', 'table-warning');
        if (ecart < 0) row.classList.add('table-danger');
        else if (ecart > 0) row.classList.add('table-success');
        else row.classList.add('table-warning');
      }

      function remplirTousEgaux() {
        document.querySelectorAll('.stock-physique').forEach(function (input) {
          input.value = input.dataset.logiciel;
          calculerEcart(input);
        });
      }

      function filtrerInventaire(terme) {
        terme = (terme || '').toLowerCase();
        document.querySelectorAll('.inventaire-row').forEach(function (row) {
          var nom = row.dataset.nom || '';
          var cip = (row.dataset.cip || '').toLowerCase();
          row.style.display = nom.indexOf(terme) >= 0 || cip.indexOf(terme) >= 0 ? '' : 'none';
        });
      }

      function confirmerInventaire() {
        var modifies = Array.from(document.querySelectorAll('.stock-physique'))
          .filter(function (i) { return i.value !== ''; });

        if (modifies.length === 0) {
          if (window.toastr) toastr.warning('Aucun stock physique saisi.');
          else alert('Aucun stock physique saisi.');
          return false;
        }

        var avecEcart = modifies.filter(function (i) {
          return parseInt(i.value, 10) !== parseInt(i.dataset.logiciel, 10);
        });

        if (avecEcart.length === 0) {
          if (window.toastr) toastr.info('Aucun écart détecté.');
          else alert('Aucun écart détecté.');
          return false;
        }

        return confirm(avecEcart.length + ' écart(s) détecté(s). Confirmer les corrections ?');
      }

      var scanCounts = {};
      var scanBuffer = '';
      var scanTimer = null;
      var lastScanCip = '';
      var lastScanAt = 0;

      var scanInput = document.getElementById('scan-input');
      if (scanInput) {
        scanInput.addEventListener('keydown', function (e) {
          if (e.key === 'Enter') {
            e.preventDefault();
            var cip = this.value.trim();
            if (cip) {
              processScan(cip);
              this.value = '';
              this.focus();
            }
          }
        });

        scanInput.addEventListener('input', function () {
          clearTimeout(scanTimer);
          var val = this.value.trim();
          var input = this;
          if (/^\d{7,13}$/.test(val)) {
            scanTimer = setTimeout(function () {
              processScan(val);
              input.value = '';
              input.focus();
            }, 100);
          }
        });
      }

      function processScan(cip) {
        if (!cip) return;
        var now = Date.now();
        if (cip === lastScanCip && now - lastScanAt < 1200) return;
        lastScanCip = cip;
        lastScanAt = now;

        var rows = document.querySelectorAll('.inventaire-row');
        var found = false;

        rows.forEach(function (row) {
          var rowCip = (row.dataset.cip || '').trim();
          if (!rowCip) return;
          if (rowCip === cip || rowCip.endsWith(cip) || cip.endsWith(rowCip)) {
            found = true;
            if (!scanCounts[cip]) scanCounts[cip] = 0;
            scanCounts[cip]++;

            var input = row.querySelector('.stock-physique');
            if (input) {
              var current = parseInt(input.value, 10) || 0;
              input.value = current + 1;
              calculerEcart(input);
              row.scrollIntoView({ behavior: 'smooth', block: 'center' });
              row.style.background = '#d4edda';
              setTimeout(function () { row.style.background = ''; }, 1000);
            }

            var nom = row.querySelector('td:first-child')?.textContent?.trim();
            document.getElementById('scan-nom').textContent = nom || cip;
            document.getElementById('scan-cip').textContent = cip;
            document.getElementById('scan-count').textContent = scanCounts[cip];
            document.getElementById('scan-result').style.display = 'block';
          }
        });

        if (!found) {
          if (window.toastr) toastr.warning('CIP ' + cip + ' non trouvé dans la liste.');
          document.getElementById('scan-result').style.display = 'none';
        }
      }

      var codeReader = null;

      function startCamera() {
        document.getElementById('camera-container').style.display = 'block';
        document.getElementById('btn-camera').style.display = 'none';
        document.getElementById('btn-stop-camera').style.display = 'inline-block';

        if (!window.ZXing) {
          if (window.toastr) toastr.error('Scanner caméra indisponible.');
          return;
        }

        var Reader = ZXing.BrowserMultiFormatReader || ZXing.BrowserBarcodeReader;
        if (!Reader) {
          if (window.toastr) toastr.error('Scanner caméra indisponible.');
          return;
        }

        codeReader = new Reader();
        codeReader.decodeFromVideoDevice(null, 'camera-video', function (result, err) {
          if (result) {
            var cip = result.getText();
            processScan(cip);
            if (navigator.vibrate) navigator.vibrate(100);
          }
        });
      }

      function stopCamera() {
        if (codeReader) {
          codeReader.reset();
          codeReader = null;
        }
        document.getElementById('camera-container').style.display = 'none';
        document.getElementById('btn-camera').style.display = 'inline-block';
        document.getElementById('btn-stop-camera').style.display = 'none';
      }

      window.startCamera = startCamera;
      window.stopCamera = stopCamera;
    </script>
}
