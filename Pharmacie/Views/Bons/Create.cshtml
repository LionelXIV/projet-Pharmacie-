@{
    ViewData["Title"] = "Nouveau bon";
    var vendeurs = (ViewBag.Vendeurs as IEnumerable<dynamic>) ?? Enumerable.Empty<dynamic>();
}

@await Html.PartialAsync("_BackButton")

<div class="d-flex align-items-center gap-2 mb-3">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h1 class="h4 mb-0"><i class="bi bi-receipt-cutoff me-2 text-primary"></i>Nouveau bon</h1>
</div>

@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@err
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
{
    <div class="alert alert-danger py-2">@error.ErrorMessage</div>
}

<div class="row g-3">
    <!-- ─── GAUCHE 70% — Panier ─────────────────────────────── -->
    <div class="col-lg-8">
        <!-- Informations client -->
        <div class="card mb-3">
            <div class="card-body">
                <h6 class="card-title fw-bold mb-3"><i class="bi bi-person me-2"></i>Informations client</h6>
                <div class="row g-2">
                    <div class="col-sm-6">
                        <label class="form-label small fw-bold text-danger">Nom du client *</label>
                        <input type="text" id="clientNom" name="clientNom" class="form-control"
                               placeholder="Ex : Mamadou Diallo" required />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label small">Téléphone (optionnel)</label>
                        <input type="text" id="clientTelephone" name="clientTelephone" class="form-control"
                               placeholder="77 123 45 67" />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label small">N° pièce d'identité (optionnel)</label>
                        <input type="text" id="numeroIdentite" name="numeroIdentite" class="form-control"
                               placeholder="Ex: 1 234 567 89" maxlength="50" />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label small">Vendeur</label>
                        <select id="vendeurId" name="vendeurId" class="form-select">
                            <option value="">— Aucun vendeur —</option>
                            @foreach (var v in vendeurs)
                            {
                                <option value="@v.Id">@v.Nom</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label small">Notes</label>
                        <input type="text" id="bonNotes" name="notes" class="form-control"
                               placeholder="Remarques éventuelles" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Recherche produit -->
        <div class="card mb-3">
            <div class="card-body">
                <h6 class="card-title fw-bold mb-2"><i class="bi bi-search me-2"></i>Rechercher un produit</h6>
                <div class="input-group">
                    <input type="text" id="productSearch" class="form-control"
                           placeholder="Nom, CIP, code-barre…" autocomplete="off" />
                    <button class="btn btn-outline-secondary" type="button" id="clearSearch">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <div id="searchResults" class="list-group mt-2 d-none"></div>
            </div>
        </div>

        <!-- Panier -->
        <div class="card">
            <div class="card-body p-2">
                <h6 class="card-title fw-bold px-2 mb-2"><i class="bi bi-cart3 me-2"></i>Panier</h6>
                <div id="cartEmpty" class="text-center text-muted py-4">
                    <i class="bi bi-cart-x fs-3 d-block mb-1"></i>Panier vide
                </div>
                <div class="table-responsive">
                <table id="cartTable" class="table table-sm align-middle mb-0 d-none">
                    <thead class="table-light">
                        <tr>
                            <th>Produit</th>
                            <th class="text-center" style="width:90px">Qté</th>
                            <th class="text-end" style="width:100px">P.U.</th>
                            <th style="width:160px">Remise</th>
                            <th class="text-end" style="width:100px">Total</th>
                            <th style="width:36px"></th>
                        </tr>
                    </thead>
                    <tbody id="cartBody"></tbody>
                </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ─── DROITE 30% — Résumé ─────────────────────────────── -->
    <div class="col-lg-4">
        <div class="card sticky-top" style="top:80px">
            <div class="card-body">
                <h6 class="fw-bold mb-3"><i class="bi bi-calculator me-2"></i>Résumé</h6>

                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted small">Sous-total</span>
                    <span id="summarySubtotal" class="fw-bold">0 FCFA</span>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted small">Remises</span>
                    <span id="summaryDiscount" class="text-danger">- 0 FCFA</span>
                </div>
                <hr class="my-2" />
                <div class="d-flex justify-content-between mb-3">
                    <span class="fw-bold">TOTAL BON</span>
                    <span id="summaryTotal" class="fw-bold fs-5 text-primary">0 FCFA</span>
                </div>

                <div class="alert alert-info py-2 small mb-3">
                    <i class="bi bi-info-circle me-1"></i>
                    Le stock sera mis à jour <strong>immédiatement</strong> à la création du bon.
                </div>

                <button type="button" id="btnSubmitBon" class="btn btn-primary w-100 py-2 fw-bold">
                    <i class="bi bi-receipt-cutoff me-2"></i>Créer le bon
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary w-100 mt-2">Annuler</a>
            </div>
        </div>
    </div>
</div>

<!-- Formulaire caché soumis par JS -->
<form id="bonForm" method="post" asp-action="Create">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
<script>
(function () {
    var cart = [];

    // ── Recherche produit ──────────────────────────────────────
    var searchInput = document.getElementById('productSearch');
    var searchResults = document.getElementById('searchResults');
    var clearBtn = document.getElementById('clearSearch');
    var debounceTimer;

    searchInput.addEventListener('input', function () {
        clearTimeout(debounceTimer);
        var q = this.value.trim();
        if (q.length < 2) { searchResults.classList.add('d-none'); return; }
        debounceTimer = setTimeout(function () { fetchProducts(q); }, 250);
    });

    clearBtn.addEventListener('click', function () {
        searchInput.value = '';
        searchResults.innerHTML = '';
        searchResults.classList.add('d-none');
    });

    function fetchProducts(q) {
        fetch('/Sales/SearchProducts?q=' + encodeURIComponent(q))
            .then(function (r) { return r.json(); })
            .then(function (data) { renderResults(data); })
            .catch(function () {});
    }

    function renderResults(data) {
        searchResults.innerHTML = '';
        if (!data || data.length === 0) {
            searchResults.innerHTML = '<div class="list-group-item text-muted small">Aucun résultat</div>';
            searchResults.classList.remove('d-none');
            return;
        }
        data.forEach(function (p) {
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'list-group-item list-group-item-action py-2';
            var stockBadge = p.stockQuantity <= 0
                ? '<span class="badge bg-danger ms-1">Rupture</span>'
                : '<span class="badge bg-success ms-1">' + p.stockQuantity + '</span>';
            btn.innerHTML = '<div class="d-flex justify-content-between align-items-center">'
                + '<span class="fw-semibold small">' + escapeHtml(p.commercialName) + '</span>'
                + stockBadge + '</div>'
                + '<div class="d-flex justify-content-between">'
                + '<small class="text-muted">' + escapeHtml(p.cip || '') + '</small>'
                + '<small class="text-success fw-bold">' + formatCurrency(p.salePrice) + '</small>'
                + '</div>';
            btn.addEventListener('click', function () { addToCart(p); });
            searchResults.appendChild(btn);
        });
        searchResults.classList.remove('d-none');
    }

    function addToCart(p) {
        var idx = cart.findIndex(function (c) { return c.productId === p.id; });
        if (idx >= 0) {
            cart[idx].quantity++;
        } else {
            cart.push({
                productId: p.id,
                name: p.commercialName,
                unitPrice: p.salePrice,
                quantity: 1,
                discountValue: 0,
                discountType: 'percent'
            });
        }
        searchInput.value = '';
        searchResults.classList.add('d-none');
        renderCart();
    }

    // ── Rendu panier ──────────────────────────────────────────
    var cartEmpty = document.getElementById('cartEmpty');
    var cartTable = document.getElementById('cartTable');
    var cartBody = document.getElementById('cartBody');

    function renderCart() {
        cartBody.innerHTML = '';
        if (cart.length === 0) {
            cartEmpty.classList.remove('d-none');
            cartTable.classList.add('d-none');
        } else {
            cartEmpty.classList.add('d-none');
            cartTable.classList.remove('d-none');
            cart.forEach(function (item, i) {
                var total = getLineTotal(item);
                var base = item.unitPrice * item.quantity;
                var discountDisplay = '';
                if (item.discountValue > 0) {
                    discountDisplay = '<div class="text-danger small">-'
                        + (item.discountType === 'percent' ? item.discountValue + '%' : formatCurrency(item.discountValue))
                        + '</div>';
                }
                var tr = document.createElement('tr');
                tr.innerHTML = '<td class="small">' + escapeHtml(item.name) + '</td>'
                    + '<td class="text-center">'
                    + '<div class="input-group input-group-sm" style="width:82px">'
                    + '<button type="button" class="btn btn-outline-secondary btn-sm px-1" onclick="changeQty(' + i + ',-1)">−</button>'
                    + '<input type="number" class="form-control form-control-sm text-center px-1" value="' + item.quantity + '" min="1" onchange="setQty(' + i + ',this.value)" style="min-width:30px">'
                    + '<button type="button" class="btn btn-outline-secondary btn-sm px-1" onclick="changeQty(' + i + ',1)">+</button>'
                    + '</div></td>'
                    + '<td class="text-end small">' + formatCurrency(item.unitPrice) + '</td>'
                    + '<td><div class="input-group input-group-sm">'
                    + '<input type="number" class="form-control form-control-sm" value="' + (item.discountValue || '') + '" min="0" placeholder="0" oninput="updateDiscount(' + i + ',this)" style="width:55px">'
                    + '<button type="button" class="btn btn-sm ' + (item.discountType === 'percent' ? 'btn-secondary' : 'btn-outline-secondary') + ' px-1" onclick="toggleDiscountType(' + i + ',this)">%</button>'
                    + '<button type="button" class="btn btn-sm ' + (item.discountType === 'amount' ? 'btn-secondary' : 'btn-outline-secondary') + ' px-1" onclick="toggleDiscountAmount(' + i + ',this)">F</button>'
                    + '</div>' + discountDisplay + '</td>'
                    + '<td class="text-end small fw-bold text-success">' + formatCurrency(total) + '</td>'
                    + '<td><button type="button" class="btn btn-sm btn-outline-danger px-1" onclick="removeItem(' + i + ')"><i class="bi bi-trash"></i></button></td>';
                cartBody.appendChild(tr);
            });
        }
        updateSummary();
    }

    window.changeQty = function (i, delta) {
        cart[i].quantity = Math.max(1, cart[i].quantity + delta);
        renderCart();
    };
    window.setQty = function (i, val) {
        cart[i].quantity = Math.max(1, parseInt(val) || 1);
        renderCart();
    };
    window.removeItem = function (i) {
        cart.splice(i, 1);
        renderCart();
    };
    window.updateDiscount = function (i, input) {
        cart[i].discountValue = parseFloat(input.value) || 0;
        renderCart();
    };
    window.toggleDiscountType = function (i, btn) {
        cart[i].discountType = 'percent';
        renderCart();
    };
    window.toggleDiscountAmount = function (i, btn) {
        cart[i].discountType = 'amount';
        renderCart();
    };

    function getLineTotal(item) {
        var base = item.unitPrice * item.quantity;
        if (item.discountValue > 0) {
            if (item.discountType === 'percent')
                return base * (1 - item.discountValue / 100);
            else
                return Math.max(0, base - item.discountValue);
        }
        return base;
    }

    function updateSummary() {
        var subtotal = cart.reduce(function (s, item) { return s + item.unitPrice * item.quantity; }, 0);
        var total = cart.reduce(function (s, item) { return s + getLineTotal(item); }, 0);
        var discount = subtotal - total;
        document.getElementById('summarySubtotal').textContent = formatCurrency(subtotal);
        document.getElementById('summaryDiscount').textContent = '- ' + formatCurrency(discount);
        document.getElementById('summaryTotal').textContent = formatCurrency(total);
    }

    // ── Soumission ────────────────────────────────────────────
    document.getElementById('btnSubmitBon').addEventListener('click', function () {
        var clientNom = document.getElementById('clientNom').value.trim();
        if (!clientNom) {
            alert('Le nom du client est obligatoire.');
            document.getElementById('clientNom').focus();
            return;
        }
        if (cart.length === 0) {
            alert('Ajoutez au moins un produit.');
            return;
        }

        var form = document.getElementById('bonForm');
        // Vider les anciens champs dynamiques
        form.querySelectorAll('.dyn').forEach(function (el) { el.remove(); });

        function addHidden(name, value) {
            var inp = document.createElement('input');
            inp.type = 'hidden';
            inp.name = name;
            inp.value = value;
            inp.className = 'dyn';
            form.appendChild(inp);
        }

        addHidden('clientNom', clientNom);
        addHidden('clientTelephone', document.getElementById('clientTelephone').value);
        addHidden('numeroIdentite', document.getElementById('numeroIdentite').value);
        addHidden('notes', document.getElementById('bonNotes').value);
        var vendeurId = document.getElementById('vendeurId').value;
        if (vendeurId) addHidden('vendeurId', vendeurId);

        cart.forEach(function (item, i) {
            addHidden('productIds[' + i + ']', item.productId);
            addHidden('quantities[' + i + ']', item.quantity);
            addHidden('discountPercents[' + i + ']', item.discountType === 'percent' ? item.discountValue : 0);
            addHidden('discountAmounts[' + i + ']', item.discountType === 'amount' ? item.discountValue : 0);
            addHidden('discountTypes[' + i + ']', item.discountType || 'percent');
        });

        form.submit();
    });

    // ── Utilitaires ───────────────────────────────────────────
    function formatCurrency(val) {
        return new Intl.NumberFormat('fr-FR').format(Math.round(val)) + ' FCFA';
    }
    function escapeHtml(str) {
        var div = document.createElement('div');
        div.appendChild(document.createTextNode(str || ''));
        return div.innerHTML;
    }

    // Close search on outside click
    document.addEventListener('click', function (e) {
        if (!searchResults.contains(e.target) && e.target !== searchInput) {
            searchResults.classList.add('d-none');
        }
    });
})();
</script>
}
