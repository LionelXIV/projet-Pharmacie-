@model Pharmacie.Models.Bon
@using Pharmacie.Models
@{
    ViewData["Title"] = "Bon " + Model.Numero;
}

@await Html.PartialAsync("_BackButton")

<div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h1 class="h4 mb-0"><i class="bi bi-receipt-cutoff me-2 text-primary"></i>Bon @Model.Numero</h1>
    @{
        var (badgeCss, badgeLabel) = Model.Statut switch
        {
            BonStatut.Ouvert => ("bg-danger", "Ouvert"),
            BonStatut.PartiellemntRegle => ("bg-warning text-dark", "Partiellement réglé"),
            BonStatut.Solde => ("bg-success", "Soldé"),
            BonStatut.Annule => ("bg-secondary", "Annulé"),
            _ => ("bg-secondary", Model.Statut.ToString())
        };
    }
    <span class="badge @badgeCss fs-6">@badgeLabel</span>
    <div class="ms-auto d-flex gap-2">
        @if (Model.Statut != BonStatut.Solde && Model.Statut != BonStatut.Annule)
        {
            <a asp-action="Regler" asp-route-id="@Model.Id" class="btn btn-success btn-sm">
                <i class="bi bi-cash-coin me-1"></i>Régler
            </a>
        }
        <a asp-action="Ticket" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm" target="_blank">
            <i class="bi bi-printer me-1"></i>Ticket
        </a>
        @if (Model.Statut != BonStatut.Solde && Model.Statut != BonStatut.Annule)
        {
            <form asp-action="AnnulerBon" asp-route-id="@Model.Id" method="post"
                  onsubmit="return confirm('Confirmer l\'annulation du bon @Model.Numero ?')">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger btn-sm">
                    <i class="bi bi-x-circle me-1"></i>Annuler le bon
                </button>
            </form>
        }
    </div>
</div>

@if (TempData["Success"] is string succ)
{
    <div class="alert alert-success alert-dismissible fade show py-2" role="alert">
        <i class="bi bi-check-circle me-1"></i>@succ
        <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] is string errMsg)
{
    <div class="alert alert-danger alert-dismissible fade show py-2" role="alert">
        @errMsg
        <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["NewBon"] is bool nb && nb)
{
    <div class="alert alert-success alert-dismissible fade show d-flex justify-content-between align-items-center" role="alert">
        <span><i class="bi bi-check-circle-fill me-2"></i>Bon créé avec succès ! Stock mis à jour.</span>
        <a asp-action="Ticket" asp-route-id="@Model.Id" asp-route-auto="true" target="_blank"
           class="btn btn-sm btn-success ms-3">
            <i class="bi bi-printer me-1"></i>Imprimer le ticket
        </a>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="fw-bold mb-3">Informations</h6>
                <dl class="row mb-0 small">
                    <dt class="col-5">N° Bon</dt><dd class="col-7 fw-bold">@Model.Numero</dd>
                    <dt class="col-5">Client</dt><dd class="col-7">@Model.ClientNom</dd>
                    @if (Model.ClientTelephone != null)
                    {
                        <dt class="col-5">Téléphone</dt><dd class="col-7">@Model.ClientTelephone</dd>
                    }
                    @if (!string.IsNullOrEmpty(Model.NumeroIdentite))
                    {
                        <dt class="col-5">N° pièce d'identité</dt><dd class="col-7">@Model.NumeroIdentite</dd>
                    }
                    <dt class="col-5">Date</dt><dd class="col-7">@Model.DateCreation.ToString("dd/MM/yyyy HH:mm")</dd>
                    @if (Model.Vendeur != null)
                    {
                        <dt class="col-5">Vendeur</dt><dd class="col-7">@Model.Vendeur.Nom</dd>
                    }
                    @if (Model.Notes != null)
                    {
                        <dt class="col-5">Notes</dt><dd class="col-7">@Model.Notes</dd>
                    }
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="fw-bold mb-3">Montants</h6>
                <div class="d-flex justify-content-between mb-2">
                    <span>Total bon</span>
                    <span class="fw-bold">@Model.MontantTotal.ToString("N0") FCFA</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>Réglé</span>
                    <span class="text-success fw-bold">@Model.MontantRegle.ToString("N0") FCFA</span>
                </div>
                <hr class="my-2" />
                <div class="d-flex justify-content-between fs-5">
                    <span class="fw-bold">Restant dû</span>
                    <span class="fw-bold @(Model.MontantRestant > 0 ? "text-danger" : "text-success")">
                        @Model.MontantRestant.ToString("N0") FCFA
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Lignes -->
<div class="card mt-3">
    <div class="card-body">
        <h6 class="fw-bold mb-2"><i class="bi bi-list-ul me-2"></i>Produits</h6>
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Produit</th>
                        <th class="text-center">Qté</th>
                        <th class="text-end">P.U.</th>
                        <th class="text-end">Remise</th>
                        <th class="text-end">Total ligne</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ligne in Model.Lignes)
                    {
                        <tr>
                            <td>@(ligne.Product?.CommercialName ?? $"#{ligne.ProductId}")</td>
                            <td class="text-center">@ligne.Quantity</td>
                            <td class="text-end">@ligne.UnitPrice.ToString("N0") FCFA</td>
                            <td class="text-end text-danger small">
                                @if (ligne.DiscountType == "percent" && ligne.DiscountPercent > 0)
                                {
                                    <span>-@ligne.DiscountPercent.ToString("N0")%</span>
                                }
                                else if (ligne.DiscountType == "amount" && ligne.DiscountAmount > 0)
                                {
                                    <span>-@ligne.DiscountAmount.ToString("N0") FCFA</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-end fw-bold">@ligne.LineTotal.ToString("N0") FCFA</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light fw-bold">
                    <tr>
                        <td colspan="4" class="text-end">TOTAL BON</td>
                        <td class="text-end">@Model.MontantTotal.ToString("N0") FCFA</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

<!-- Règlements -->
@if (Model.Reglements.Any())
{
    <div class="card mt-3">
        <div class="card-body">
            <h6 class="fw-bold mb-2"><i class="bi bi-cash-coin me-2"></i>Règlements</h6>
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th class="text-end">Montant</th>
                            <th>Mode de paiement</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Reglements.OrderBy(r => r.DateReglement))
                        {
                            <tr>
                                <td class="small">@r.DateReglement.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end fw-bold text-success">@r.Montant.ToString("N0") FCFA</td>
                                <td>@Pharmacie.Models.PaymentMethodDisplay.Format(r.PaymentMethod, r.PaymentMethodAutre)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td>Total réglé</td>
                            <td class="text-end text-success">@Model.MontantRegle.ToString("N0") FCFA</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
}
