@model IEnumerable<Pharmacie.Models.Bon>
@using Pharmacie.Models
@{
    ViewData["Title"] = "Bons";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    int totalCount = ViewBag.TotalCount;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0"><i class="bi bi-receipt-cutoff me-2 text-primary"></i>Bons (@totalCount)</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>Nouveau bon
    </a>
</div>

@if (TempData["Success"] is string succ)
{
    <div class="alert alert-success alert-dismissible fade show py-2" role="alert">
        <i class="bi bi-check-circle me-1"></i>@succ
        <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] is string errMsg)
{
    <div class="alert alert-danger alert-dismissible fade show py-2" role="alert">
        @errMsg
        <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Filtres -->
<form asp-action="Index" method="get" class="card card-body mb-3 p-2">
    <div class="row g-2 align-items-end">
        <div class="col-sm-4 col-md-2">
            <label class="form-label small mb-1">Statut</label>
            <select name="statut" class="form-select form-select-sm">
                <option value="">Tous</option>
                @foreach (var s in Enum.GetValues<BonStatut>())
                {
                    var sel = (ViewBag.FilterStatut as string) == s.ToString();
                    <option value="@s" selected="@sel">@s</option>
                }
            </select>
        </div>
        <div class="col-sm-4 col-md-2">
            <label class="form-label small mb-1">Du</label>
            <input type="date" name="from" value="@ViewBag.FilterFrom" class="form-control form-control-sm" />
        </div>
        <div class="col-sm-4 col-md-2">
            <label class="form-label small mb-1">Au</label>
            <input type="date" name="to" value="@ViewBag.FilterTo" class="form-control form-control-sm" />
        </div>
        <div class="col-sm-6 col-md-3">
            <label class="form-label small mb-1">Client</label>
            <input type="text" name="client" value="@ViewBag.FilterClient" class="form-control form-control-sm" placeholder="Nom client" />
        </div>
        <div class="col-sm-6 col-md-2">
            <label class="form-label small mb-1">N° bon</label>
            <input type="text" name="numero" value="@ViewBag.FilterNumero" class="form-control form-control-sm" placeholder="BON-2026-001" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-sm btn-primary">Filtrer</button>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Effacer</a>
        </div>
    </div>
</form>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-receipt-cutoff fs-2 d-block mb-2"></i>
        Aucun bon trouvé.
        <div class="mt-2"><a asp-action="Create" class="btn btn-primary btn-sm">Créer le premier bon</a></div>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover table-sm align-middle">
            <thead class="table-light">
                <tr>
                    <th>N° Bon</th>
                    <th>Client</th>
                    <th>Date</th>
                    <th class="text-end">Total</th>
                    <th class="text-end">Réglé</th>
                    <th class="text-end">Restant</th>
                    <th>Statut</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bon in Model)
                {
                    <tr>
                        <td><strong>@bon.Numero</strong></td>
                        <td>
                            @bon.ClientNom
                            @if (bon.ClientTelephone != null)
                            {
                                <div class="text-muted small">@bon.ClientTelephone</div>
                            }
                        </td>
                        <td class="small text-nowrap">@bon.DateCreation.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-end fw-bold">@bon.MontantTotal.ToString("N0") FCFA</td>
                        <td class="text-end text-success">@bon.MontantRegle.ToString("N0") FCFA</td>
                        <td class="text-end @(bon.MontantRestant > 0 ? "text-danger fw-bold" : "text-muted")">
                            @bon.MontantRestant.ToString("N0") FCFA
                        </td>
                        <td>
                            @{
                                var (badgeCss, label) = bon.Statut switch
                                {
                                    BonStatut.Ouvert => ("bg-danger", "Ouvert"),
                                    BonStatut.PartiellemntRegle => ("bg-warning text-dark", "Part. réglé"),
                                    BonStatut.Solde => ("bg-success", "Soldé"),
                                    BonStatut.Annule => ("bg-secondary", "Annulé"),
                                    _ => ("bg-secondary", bon.Statut.ToString())
                                };
                            }
                            <span class="badge @badgeCss">@label</span>
                        </td>
                        <td class="text-nowrap">
                            <a asp-action="Details" asp-route-id="@bon.Id" class="btn btn-sm btn-outline-primary" title="Détails">
                                <i class="bi bi-eye"></i>
                            </a>
                            @if (bon.Statut != BonStatut.Solde && bon.Statut != BonStatut.Annule)
                            {
                                <a asp-action="Regler" asp-route-id="@bon.Id" class="btn btn-sm btn-outline-success" title="Régler">
                                    <i class="bi bi-cash-coin"></i>
                                </a>
                            }
                            <a asp-action="Ticket" asp-route-id="@bon.Id" class="btn btn-sm btn-outline-secondary" title="Ticket" target="_blank">
                                <i class="bi bi-printer"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <nav aria-label="Pagination">
            <ul class="pagination pagination-sm justify-content-center">
                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)"
                       asp-route-statut="@ViewBag.FilterStatut" asp-route-client="@ViewBag.FilterClient"
                       asp-route-numero="@ViewBag.FilterNumero">‹</a>
                </li>
                @for (var p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == currentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p"
                           asp-route-statut="@ViewBag.FilterStatut" asp-route-client="@ViewBag.FilterClient"
                           asp-route-numero="@ViewBag.FilterNumero">@p</a>
                    </li>
                }
                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)"
                       asp-route-statut="@ViewBag.FilterStatut" asp-route-client="@ViewBag.FilterClient"
                       asp-route-numero="@ViewBag.FilterNumero">›</a>
                </li>
            </ul>
        </nav>
    }
}
