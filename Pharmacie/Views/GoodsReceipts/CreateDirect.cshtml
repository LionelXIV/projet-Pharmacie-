@model GoodsReceiptDirectViewModel
@{
    ViewData["Title"] = "Saisir un BL";
    var fournisseurs = ViewBag.Fournisseurs as IEnumerable<Supplier> ?? Enumerable.Empty<Supplier>();
}

@await Html.PartialAsync("_BackButton")

<div class="page-header mb-3">
    <h1 class="page-title">Nouvelle saisie BL</h1>
    <p class="page-lead mb-0">Réception fournisseur directe — met à jour le stock et trace les mouvements.</p>
</div>
<details id="bl-ocr-debug" class="mb-3" style="display:none">
    <summary class="small text-muted">Texte OCR brut (admin)</summary>
    <pre id="bl-ocr-debug-text" class="small bg-light border rounded p-2 mb-0" style="max-height:16rem;overflow:auto;white-space:pre-wrap"></pre>
</details>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <div asp-validation-summary="All" class="mb-0"></div>
    </div>
}

<form asp-action="CreateDirect" method="post" id="form-bl-direct">
    @Html.AntiForgeryToken()

    <div class="row g-3 mb-3 align-items-stretch">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3 border-bottom fw-semibold">
                    <i class="bi bi-truck text-primary me-1"></i>Informations générales
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="SupplierId" class="form-label fw-bold"></label>
                            <select asp-for="SupplierId" class="form-select">
                                <option value="">— Fournisseur —</option>
                                @foreach (var s in fournisseurs)
                                {
                                    <option value="@s.Id">@s.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Reference" class="form-label fw-bold"></label>
                            <input asp-for="Reference" class="form-control" placeholder="N° bon de livraison" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="DateReception" class="form-label fw-bold"></label>
                            <input asp-for="DateReception" class="form-control" type="date" />
                        </div>
                        <div class="col-12">
                            <label asp-for="Notes" class="form-label"></label>
                            <input asp-for="Notes" class="form-control" placeholder="Optionnel" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100" id="bl-resume-card" aria-live="polite">
                <div class="card-header bg-white py-3 border-bottom fw-semibold">
                    <i class="bi bi-calculator text-primary me-1"></i>Résumé
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Total prix achat</span>
                        <span class="fw-bold text-nowrap"><span id="bl-total-achat">0</span>&nbsp;FCFA</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Total prix public</span>
                        <span class="fw-bold text-nowrap"><span id="bl-total-vente">0</span>&nbsp;FCFA</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted" title="TVA contenue dans le prix public (TTC)">Total TVA</span>
                        <span class="fw-bold text-nowrap"><span id="bl-total-tva">0</span>&nbsp;FCFA</span>
                    </div>
                    <hr class="my-2" />
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Lignes</span>
                        <span class="fw-bold" id="bl-nb-lignes">0</span>
                    </div>
                    <div class="small text-muted mt-3 mb-0">
                        <div><strong>Qté</strong> = unités payantes. Cochez <strong>UG</strong> puis saisissez le <em>nombre</em> d’unités gratuites.</div>
                        <div class="mt-1">Stock reçu = qté + UG. Les UG sont <em>hors</em> total achat et <em>hors</em> TVA.</div>
                        <div class="mt-1"><strong>TVA %</strong> = taux catalogue (souvent 0 ou 18). Total TVA = part TVA du prix public sur la qté payante.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white py-3 border-bottom">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span class="fw-semibold"><i class="bi bi-capsule text-primary me-1"></i>Produits / médicaments</span>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-outline-danger" id="btn-erreurs" style="display:none">
                        Lignes avec erreur (<span id="bl-nb-erreurs">0</span>)
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="btn-import-bl"
                            title="Préremplir depuis Excel, CSV ou PDF texte (CIP, QTE, prix…)">
                        <i class="bi bi-upload me-1"></i>Importer un BL
                    </button>
                    <input type="file" id="bl-import-file" accept=".xlsx,.xlsm,.csv,.txt,.pdf" class="d-none" />
                    <button type="button" class="btn btn-sm btn-primary" id="btn-add-ligne">
                        <i class="bi bi-plus-lg me-1"></i>Ajouter un produit
                    </button>
                </div>
            </div>
        </div>
        <div class="card-body border-bottom py-2">
            <div class="input-group input-group-sm" style="max-width:28rem">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="search" class="form-control" id="bl-filtre-lignes"
                       placeholder="Rechercher un produit dans les lignes…" autocomplete="off" />
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="min-width:200px">Produit</th>
                            <th style="width:80px">Qté</th>
                            <th style="width:100px">Prix achat</th>
                            <th style="width:100px">Prix public</th>
                            <th style="width:100px" class="text-end">Montant</th>
                            <th style="width:120px">N° lot</th>
                            <th style="width:120px">Péremption</th>
                            <th style="width:72px" class="text-center" title="Cochez puis indiquez le nombre d’UG">UG</th>
                            <th style="width:88px" title="Taux TVA du produit (0 = exonéré)">TVA %</th>
                            <th style="width:90px" class="text-end" title="Montant TVA (dans le prix public)">TVA</th>
                            <th style="min-width:150px">Détail</th>
                            <th style="width:40px"></th>
                        </tr>
                    </thead>
                    <tbody id="bl-tbody"></tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white border-top py-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <button type="button" class="btn btn-link text-decoration-none px-0" id="btn-add-ligne-bas">
                    <i class="bi bi-plus-lg me-1"></i>Ajouter une ligne
                </button>
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-lg me-1"></i>Enregistrer
                </button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
    (function () {
      var ligneCount = 0;
      var tbody = document.getElementById('bl-tbody');
      var elAchat = document.getElementById('bl-total-achat');
      var elVente = document.getElementById('bl-total-vente');
      var elTva = document.getElementById('bl-total-tva');
      var elLignes = document.getElementById('bl-nb-lignes');
      var elErreurs = document.getElementById('bl-nb-erreurs');
      var btnErreurs = document.getElementById('btn-erreurs');
      var filtre = document.getElementById('bl-filtre-lignes');

      function formatFcfa(n) {
        var v = Math.round(n || 0);
        return String(v).replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
      }

      function num(el) {
        if (!el || el.value === '' || el.value == null) return 0;
        var raw = String(el.value).replace(',', '.').replace(/\s/g, '');
        return parseFloat(raw) || 0;
      }

      /** TVA contenue dans le TTC (prix public), comme TVACalculator côté ventes. */
      function tvaFromTtc(montantTtc, tauxPct) {
        if (montantTtc <= 0 || tauxPct <= 0) return 0;
        var ht = Math.round(montantTtc / (1 + tauxPct / 100));
        return montantTtc - ht;
      }

      function productLabel(tr) {
        var sel = tr.querySelector('select[data-tomselect-product]');
        if (sel && sel.tomselect) {
          var v = sel.tomselect.getValue();
          if (v && sel.tomselect.options[v]) return (sel.tomselect.options[v].text || '').toLowerCase();
        }
        return '';
      }

      function lineHasError(tr) {
        var sel = tr.querySelector('select[data-tomselect-product]');
        var productId = sel && sel.tomselect ? sel.tomselect.getValue() : (sel && sel.value);
        var qty = num(tr.querySelector('.bl-qty-input'));
        var ugOn = !!(tr.querySelector('.bl-ug-check') && tr.querySelector('.bl-ug-check').checked);
        var nbUg = ugOn ? Math.max(0, Math.round(num(tr.querySelector('.bl-ug-qty')))) : 0;
        var pa = num(tr.querySelector('.prix-achat-input'));
        if (!productId) return true;
        if (qty + nbUg < 1) return true;
        if (ugOn && nbUg < 1) return true;
        if (qty > 0 && pa <= 0) return true;
        return false;
      }

      function syncUgInputs(tr) {
        var check = tr.querySelector('.bl-ug-check');
        var qtyUg = tr.querySelector('.bl-ug-qty');
        if (!check || !qtyUg) return;
        var on = check.checked;
        qtyUg.disabled = !on;
        if (on) {
          if (!qtyUg.value || Number(qtyUg.value) < 1) qtyUg.value = '1';
          qtyUg.classList.remove('d-none');
        } else {
          qtyUg.value = '0';
        }
      }

      function updateTotals() {
        var rows = tbody.querySelectorAll('tr.bl-ligne');
        var totalAchat = 0, totalVente = 0, totalTva = 0, erreurs = 0;

        rows.forEach(function (tr) {
          syncUgInputs(tr);
          var qty = num(tr.querySelector('.bl-qty-input'));
          var pa = num(tr.querySelector('.prix-achat-input'));
          var pv = num(tr.querySelector('.prix-vente-input'));
          var taux = num(tr.querySelector('.bl-tva-input'));
          var ugOn = !!(tr.querySelector('.bl-ug-check') && tr.querySelector('.bl-ug-check').checked);
          var nbUg = ugOn ? Math.max(0, Math.round(num(tr.querySelector('.bl-ug-qty')))) : 0;

          // Achat / TVA : uniquement la qté payante. Stock valeur public : qté + UG.
          var montantAchat = qty * pa;
          var montantVente = (qty + nbUg) * pv;
          var montantTva = tvaFromTtc(qty * pv, taux);

          totalAchat += montantAchat;
          totalVente += montantVente;
          totalTva += montantTva;

          var cell = tr.querySelector('.bl-ligne-montant');
          if (cell) cell.textContent = formatFcfa(montantAchat);

          var tvaCell = tr.querySelector('.bl-ligne-tva');
          if (tvaCell) tvaCell.textContent = formatFcfa(montantTva);

          var bad = lineHasError(tr);
          tr.classList.toggle('table-danger', bad);
          if (bad) erreurs++;
        });

        elAchat.textContent = formatFcfa(totalAchat);
        elVente.textContent = formatFcfa(totalVente);
        elTva.textContent = formatFcfa(totalTva);
        elLignes.textContent = String(rows.length);
        elErreurs.textContent = String(erreurs);
        btnErreurs.style.display = erreurs > 0 ? '' : 'none';
      }

      function applyFiltre() {
        var q = (filtre.value || '').trim().toLowerCase();
        tbody.querySelectorAll('tr.bl-ligne').forEach(function (tr) {
          if (!q) { tr.style.display = ''; return; }
          tr.style.display = productLabel(tr).indexOf(q) >= 0 ? '' : 'none';
        });
      }

      function initTomSelect(el) {
        if (!window.TomSelect || !el || el.tomselect) return;
        new TomSelect(el, {
          valueField: 'value',
          labelField: 'text',
          searchField: ['text'],
          placeholder: 'Rechercher un produit…',
          maxOptions: 25,
          preload: false,
          create: false,
          loadThrottle: 300,
          dropdownParent: 'body',
          load: function (query, callback) {
            if (!query || query.length < 2) { callback(); return; }
            var url = (el.dataset.url || '/Products/Search') + '?term=' + encodeURIComponent(query);
            fetch(url)
              .then(function (r) { return r.json(); })
              .then(function (data) { callback(data); })
              .catch(function () { callback(); });
          },
          onChange: function (value) {
            var tr = el.closest('tr.bl-ligne');
            if (!tr) return;
            if (!value) { updateTotals(); applyFiltre(); return; }
            var opt = this.options[value];
            if (!opt) return;

            var prixAchatInput = tr.querySelector('.prix-achat-input');
            if (prixAchatInput && opt.purchasePrice > 0) prixAchatInput.value = opt.purchasePrice;

            var prixVenteInput = tr.querySelector('.prix-vente-input');
            if (prixVenteInput && opt.salePrice > 0) prixVenteInput.value = opt.salePrice;

            var tvaInput = tr.querySelector('.bl-tva-input');
            if (tvaInput) {
              // Préférer le taux catalogue ; sinon 18 si assujetti, sinon 0
              var t = 0;
              if (opt.tauxTVA != null && opt.tauxTVA !== '') t = Number(opt.tauxTVA);
              else if (opt.assujettiTVA) t = 18;
              tvaInput.value = t;
            }
            updateTotals();
            applyFiltre();
          }
        });
      }

      function addLigne(preset) {
        var index = ligneCount++;
        var qty = preset && preset.quantite > 0 ? preset.quantite : 1;
        var pa = preset && preset.prixAchat != null ? preset.prixAchat : '';
        var pv = preset && preset.prixVente != null ? preset.prixVente : '';
        var lot = preset && preset.numeroLot ? String(preset.numeroLot).replace(/"/g, '&quot;') : '';
        var exp = preset && preset.datePeremption ? preset.datePeremption : '';
        var tva = preset && preset.tauxTVA != null ? preset.tauxTVA : 0;
        var ugChecked = preset && (preset.estUG || (preset.nbUG > 0)) ? ' checked' : '';
        var nbUg = preset && preset.nbUG > 0 ? preset.nbUG : (ugChecked ? 1 : 0);
        var ugDisabled = ugChecked ? '' : ' disabled';

        var html =
          '<tr class="bl-ligne">' +
          '<td><div class="d-flex align-items-center gap-1">' +
          '<select name="Lignes[' + index + '].ProductId" class="form-select form-select-sm" data-tomselect-product data-url="/Products/Search" required><option value="">Chercher...</option></select>' +
          '<button type="button" class="btn btn-outline-success btn-sm flex-shrink-0" title="Créer un nouveau produit" onclick="openQuickProductModal(this)"><i class="bi bi-plus-lg" aria-hidden="true"></i></button>' +
          '</div>' +
          (preset && preset.unmatched
            ? '<button type="button" class="btn btn-link btn-sm p-0 mt-1 btn-create-from-import" data-name="' + (preset.libelle || '').replace(/"/g, '&quot;') + '" data-cip="' + (preset.cip || '').replace(/"/g, '&quot;') + '" data-pa="' + (preset.prixAchat != null ? preset.prixAchat : '') + '">Créer ce produit</button>'
            : '') +
          '</td>' +
          '<td><input type="number" name="Lignes[' + index + '].QuantiteLivree" class="form-control form-control-sm bl-qty-input" min="0" value="' + qty + '" required title="Quantité payante"></td>' +
          '<td><input type="number" name="Lignes[' + index + '].PrixAchat" class="form-control form-control-sm prix-achat-input" min="0" step="1" placeholder="Achat" value="' + pa + '"></td>' +
          '<td><input type="number" name="Lignes[' + index + '].PrixVente" class="form-control form-control-sm prix-vente-input" min="0" step="1" placeholder="Public" value="' + pv + '"></td>' +
          '<td class="text-end fw-semibold text-nowrap"><span class="bl-ligne-montant">0</span> <span class="text-muted small">F</span></td>' +
          '<td><input type="text" name="Lignes[' + index + '].NumeroLot" class="form-control form-control-sm" placeholder="LOT-..." value="' + lot + '"></td>' +
          '<td><input type="date" name="Lignes[' + index + '].DatePeremption" class="form-control form-control-sm" data-flatpickr-ignore="true" value="' + exp + '"></td>' +
          '<td class="text-center">' +
          '<input class="form-check-input bl-ug-check" type="checkbox" name="Lignes[' + index + '].EstUG" value="true" title="Activer les unités gratuites"' + ugChecked + '>' +
          '<input type="number" name="Lignes[' + index + '].NbUG" class="form-control form-control-sm bl-ug-qty mt-1 mx-auto" min="0" step="1" value="' + nbUg + '" style="width:3.5rem"' + ugDisabled + ' title="Nombre d’UG">' +
          '</td>' +
          '<td><input type="number" name="Lignes[' + index + '].TauxTVA" class="form-control form-control-sm bl-tva-input" min="0" max="100" step="1" value="' + tva + '" title="Taux % (0 = exonéré)"></td>' +
          '<td class="text-end text-nowrap"><span class="bl-ligne-tva">0</span> <span class="text-muted small">F</span></td>' +
          '<td class="small">' +
          '<div class="form-check mb-1"><input class="form-check-input bl-vd-check" type="checkbox" name="Lignes[' + index + '].CreerVenteDetail" value="true" id="vd' + index + '"><label class="form-check-label" for="vd' + index + '">Créer unité</label></div>' +
          '<input type="number" name="Lignes[' + index + '].NbUnitesParBoite" class="form-control form-control-sm mb-1" min="1" placeholder="Nb/boîte">' +
          '<input type="number" name="Lignes[' + index + '].PrixUnite" class="form-control form-control-sm mb-1" min="1" step="1" placeholder="Prix unité">' +
          '<label class="form-label small fw-bold mb-0" for="boites-ouvrir-' + index + '">Boîtes à ouvrir</label>' +
          '<input type="number" name="Lignes[' + index + '].NbBoitesAOuvrir" id="boites-ouvrir-' + index + '" class="form-control form-control-sm" min="0" value="0">' +
          '</td>' +
          '<td><button type="button" class="btn btn-sm btn-outline-danger btn-remove-ligne" title="Supprimer">✕</button></td>' +
          '</tr>';
        tbody.insertAdjacentHTML('beforeend', html);
        var select = tbody.querySelector('select[name="Lignes[' + index + '].ProductId"]');
        initTomSelect(select);

        if (preset && preset.productId && select && select.tomselect) {
          var text = preset.productText || ('#' + preset.productId);
          select.tomselect.addOption({
            value: String(preset.productId),
            text: text,
            salePrice: preset.salePrice || preset.prixVente || 0,
            purchasePrice: preset.purchasePrice || preset.prixAchat || 0,
            tauxTVA: preset.tauxTVA || 0
          });
          select.tomselect.setValue(String(preset.productId), true);
        }

        updateTotals();
        var newRow = tbody.querySelector('tr.bl-ligne:last-child');
        if (newRow && !preset) {
          newRow.scrollIntoView({ behavior: 'smooth', block: 'center' });
          setTimeout(function () {
            if (select && select.tomselect) select.tomselect.focus();
          }, 150);
        }
        return newRow;
      }

      function showImportFlash(message, isError) {
        var existing = document.getElementById('bl-import-flash');
        if (existing) existing.remove();
        var div = document.createElement('div');
        div.id = 'bl-import-flash';
        div.className = 'alert alert-' + (isError ? 'danger' : 'success') + ' alert-dismissible fade show';
        div.innerHTML = message +
          '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>';
        var header = document.querySelector('.page-header');
        if (header && header.parentNode)
          header.parentNode.insertBefore(div, header.nextSibling);
      }

      function applyImportLines(lines) {
        tbody.querySelectorAll('tr.bl-ligne').forEach(function (tr) { tr.remove(); });
        lines.forEach(function (line) {
          addLigne({
            productId: line.productId,
            productText: line.productText,
            quantite: line.quantite,
            prixAchat: line.prixAchat,
            prixVente: line.prixVente,
            purchasePrice: line.purchasePrice,
            salePrice: line.salePrice,
            numeroLot: line.numeroLot,
            datePeremption: line.datePeremption,
            estUG: line.estUG || (line.nbUG > 0),
            nbUG: line.nbUG,
            tauxTVA: line.tauxTVA,
            unmatched: !line.matched,
            cip: line.cip || '',
            libelle: line.libelle || line.productText || ''
          });
        });
        updateTotals();
        var firstErr = tbody.querySelector('tr.bl-ligne.table-danger');
        if (firstErr) firstErr.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }

      var importUrl = '@Url.Action("ImportBlPreview", "GoodsReceipts")';
      var fileInput = document.getElementById('bl-import-file');
      document.getElementById('btn-import-bl').addEventListener('click', function () {
        fileInput.value = '';
        fileInput.click();
      });
      fileInput.addEventListener('change', function () {
        if (!fileInput.files || !fileInput.files[0]) return;
        var fd = new FormData();
        fd.append('file', fileInput.files[0]);
        var token = document.querySelector('#form-bl-direct input[name="__RequestVerificationToken"]');
        if (token) fd.append('__RequestVerificationToken', token.value);

        var btn = document.getElementById('btn-import-bl');
        btn.disabled = true;
        fetch(importUrl, {
          method: 'POST',
          body: fd,
          credentials: 'same-origin',
          headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
          .then(function (r) { return r.json(); })
          .then(function (data) {
            btn.disabled = false;
            if (!data || !data.ok) {
              showImportFlash((data && data.message) || 'Import impossible.', true);
              return;
            }
            if (!data.lines || !data.lines.length) {
              showImportFlash('Aucune ligne importée.', true);
              return;
            }
            applyImportLines(data.lines);
            window._blImportSupplierId = data.supplierId || '';
            var selSup = document.getElementById('SupplierId');
            if (selSup && !selSup.value && data.supplierId) selSup.value = String(data.supplierId);
            var refEl = document.getElementById('Reference');
            if (refEl && !refEl.value && data.numeroBL) refEl.value = data.numeroBL;
            var dateEl = document.getElementById('DateReception');
            if (dateEl && !dateEl.value && data.dateBL) {
              var d = String(data.dateBL);
              dateEl.value = d.length >= 10 ? d.substring(0, 10) : d;
            }
            var ocrBox = document.getElementById('bl-ocr-debug');
            var ocrText = document.getElementById('bl-ocr-debug-text');
            if (data.texteOcrBrut && ocrBox && ocrText) {
              ocrText.textContent = data.texteOcrBrut;
              ocrBox.style.display = '';
            } else if (ocrBox) {
              ocrBox.style.display = 'none';
            }
            showImportFlash(data.message || 'Import terminé.', data.unmatchedCount > 0);
          })
          .catch(function () {
            btn.disabled = false;
            showImportFlash('Erreur réseau lors de l’import.', true);
          });
      });

      tbody.addEventListener('input', function (e) {
        if (e.target.matches('.bl-qty-input, .prix-achat-input, .prix-vente-input, .bl-tva-input, .bl-ug-qty'))
          updateTotals();
      });
      tbody.addEventListener('change', function (e) {
        if (e.target.matches('.bl-qty-input, .prix-achat-input, .prix-vente-input, .bl-tva-input, .bl-ug-check, .bl-ug-qty'))
          updateTotals();
      });
      tbody.addEventListener('click', function (e) {
        var btn = e.target.closest('.btn-remove-ligne');
        if (!btn) return;
        var tr = btn.closest('tr.bl-ligne');
        if (tr) tr.remove();
        updateTotals();
        applyFiltre();
      });

      tbody.addEventListener('click', function (e) {
        var createBtn = e.target.closest('.btn-create-from-import');
        if (!createBtn) return;
        openQuickProductModal(createBtn, {
          name: createBtn.getAttribute('data-name') || '',
          cip: createBtn.getAttribute('data-cip') || '',
          purchasePrice: createBtn.getAttribute('data-pa') || 0,
          supplierId: window._blImportSupplierId || ''
        });
      });

      filtre.addEventListener('input', applyFiltre);

      btnErreurs.addEventListener('click', function () {
        var first = tbody.querySelector('tr.bl-ligne.table-danger');
        if (first) {
          first.style.display = '';
          first.scrollIntoView({ behavior: 'smooth', block: 'center' });
          var focusable = first.querySelector('input:not([type=checkbox]), select');
          if (focusable) focusable.focus();
        }
      });

      document.getElementById('btn-add-ligne').addEventListener('click', function () { addLigne(); });
      document.getElementById('btn-add-ligne-bas').addEventListener('click', function () { addLigne(); });
      document.addEventListener('DOMContentLoaded', function () { addLigne(); });
      if (new URLSearchParams(window.location.search).get('pdf') === '1') {
        setTimeout(function () { fileInput.click(); }, 400);
      }
    })();
    </script>
    <partial name="_QuickProductModal" />
}
