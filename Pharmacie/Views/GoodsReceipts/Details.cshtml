@model GoodsReceipt
@{
    ViewData["Title"] = "BL #" + Model.Id;
    var supplierName = Model.Supplier?.Name
        ?? Model.PurchaseOrder?.Supplier?.Name
        ?? "—";
}

@await Html.PartialAsync("_BackButton")

<div class="page-header mb-3">
    <h1 class="page-title">Bon de livraison #@Model.Id</h1>
    <p class="page-lead mb-0">
        @if (!string.IsNullOrWhiteSpace(Model.Reference))
        {
            <span>Réf. @Model.Reference · </span>
        }
        @Model.ReceivedAt.ToString("dd/MM/yyyy HH:mm") · @supplierName
    </p>
    <div class="mt-2">
        <a class="btn btn-outline-warning" asp-action="Edit" asp-route-id="@Model.Id">
            <i class="bi bi-pencil me-1" aria-hidden="true"></i>Modifier le BL
        </a>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit"
                    class="btn btn-outline-danger"
                    data-confirm="Supprimer le BL #@Model.Id ? Le stock ajouté par ce BL sera retiré. Impossible si des unités ont déjà été vendues.">
                <i class="bi bi-trash me-1" aria-hidden="true"></i>Supprimer
            </button>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Produit</th>
                    <th class="text-end">Qté reçue</th>
                    <th>Lot</th>
                    <th>Péremption</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in Model.Lines)
                {
                    <tr>
                        <td>@(l.Product?.CommercialName ?? ("#" + l.ProductId))</td>
                        <td class="text-end">@l.QuantityReceived</td>
                        <td class="font-monospace">@l.LotNumber</td>
                        <td>@ExpirationMonth.Format(l.ExpirationDate)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
