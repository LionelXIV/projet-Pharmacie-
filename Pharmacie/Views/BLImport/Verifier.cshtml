@model BLImportViewModel
@{
    ViewData["Title"] = "Vérifier le BL";
}

@await Html.PartialAsync("_BackButton")

<div class="page-header mb-3">
    <h1 class="page-title">Vérification du BL</h1>
    <p class="page-lead mb-0">
        Fichier : <strong>@Model.NomFichier</strong>
        — date BL : @Model.DateBL.ToString("dd/MM/yyyy")
    </p>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="card border-success">
            <div class="card-body text-center">
                <div class="fs-4 fw-bold text-success">@Model.Fournisseur</div>
                <div class="text-muted small">Fournisseur détecté</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-primary">
            <div class="card-body text-center">
                <div class="fs-5 fw-bold">@(string.IsNullOrEmpty(Model.NumeroBL) ? "—" : Model.NumeroBL)</div>
                <div class="text-muted small">N° BL</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-success">
            <div class="card-body text-center">
                <div class="fs-4 fw-bold text-success">@Model.NbTrouvees</div>
                <div class="text-muted small">Produits trouvés</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-warning">
            <div class="card-body text-center">
                <div class="fs-4 fw-bold text-warning">@Model.NbNonTrouvees</div>
                <div class="text-muted small">Non trouvés</div>
            </div>
        </div>
    </div>
</div>

@if (ViewBag.OcrUtilise == true)
{
    <div class="alert alert-info py-2 mb-3">
        <i class="bi bi-cpu me-1"></i>
        <strong>OCR utilisé</strong> —
        Le PDF était scanné. Les données ont été extraites automatiquement
        mais peuvent contenir des erreurs. Vérifiez attentivement avant de confirmer.
    </div>
}

<div class="alert alert-warning py-2 mb-3">
    <i class="bi bi-pencil me-1"></i>
    <strong>Vérifiez et complétez</strong>
    les champs manquants (quantité livrée, lot, péremption) en vous référant au BL papier.
</div>

@if (Model.Lignes.Count == 0)
{
    <div class="alert alert-danger">
        Aucune ligne extraite. Le PDF est peut-être scanné (image) ou le format n'est pas reconnu.
        Utilisez « Saisir un BL » ou un export Excel/CSV.
    </div>
    <a asp-action="Upload" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Recommencer
    </a>
}
else
{
    <form asp-action="Confirmer" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Fournisseur" value="@Model.Fournisseur">
        <input type="hidden" name="NumeroBL" value="@Model.NumeroBL">
        <input type="hidden" name="DateBL" value="@Model.DateBL.ToString("yyyy-MM-dd")">

        <div class="table-responsive">
            <table class="table table-sm table-bordered table-hover align-middle">
                <thead class="table-dark" style="position:sticky;top:0;z-index:1">
                    <tr>
                        <th style="width:35px">✓</th>
                        <th>Produit BL</th>
                        <th>Correspondance catalogue</th>
                        <th style="width:90px">Qté livrée *</th>
                        <th style="width:120px">N° Lot</th>
                        <th style="width:130px">Péremption</th>
                        <th style="width:100px">Prix achat</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model.Lignes.Count; i++)
                    {
                        var ligne = Model.Lignes[i];
                        var rowClass = ligne.Trouve ? "" : "table-warning";
                        <tr class="@rowClass">
                            <td class="text-center">
                                <input type="hidden" name="Lignes[@i].Importer" value="false">
                                <input type="checkbox"
                                       name="Lignes[@i].Importer"
                                       value="true"
                                       @(ligne.Trouve ? "checked" : null)>
                            </td>
                            <td>
                                <div class="fw-bold small">@ligne.NomProduit</div>
                                <div class="text-muted small">CIP: @ligne.CIP</div>
                                @if (!string.IsNullOrEmpty(ligne.Confiance))
                                {
                                    <span class="badge @(ligne.Confiance == "bonne" ? "bg-success" : "bg-secondary")">@ligne.Confiance</span>
                                }
                            </td>
                            <td>
                                @if (ligne.Trouve)
                                {
                                    <div class="text-success small fw-bold">
                                        <i class="bi bi-check-circle me-1"></i>@ligne.NomCatalogue
                                    </div>
                                    <input type="hidden" name="Lignes[@i].ProductId" value="@ligne.ProductId">
                                    <input type="hidden" name="Lignes[@i].NomProduit" value="@ligne.NomCatalogue">
                                }
                                else
                                {
                                    <span class="text-warning small">
                                        <i class="bi bi-exclamation-triangle me-1"></i>Non trouvé
                                    </span>
                                    <input type="hidden" name="Lignes[@i].ProductId" value="0">
                                    <input type="hidden" name="Lignes[@i].NomProduit" value="@ligne.NomProduit">
                                }
                            </td>
                            <td>
                                <input type="number"
                                       name="Lignes[@i].QuantiteLivree"
                                       class="form-control form-control-sm text-center"
                                       value="@(ligne.QuantiteLivree ?? 1)"
                                       min="0">
                            </td>
                            <td>
                                <input type="text"
                                       name="Lignes[@i].NumeroLot"
                                       class="form-control form-control-sm"
                                       value="@ligne.NumeroLot"
                                       placeholder="LOT-XXX"
                                       maxlength="80">
                            </td>
                            <td>
                                <input type="date"
                                       name="Lignes[@i].DatePeremption"
                                       class="form-control form-control-sm"
                                       value="@(ligne.DatePeremption?.ToString("yyyy-MM-dd"))"
                                       data-flatpickr-ignore="true">
                            </td>
                            <td>
                                <input type="number"
                                       name="Lignes[@i].PrixAchat"
                                       class="form-control form-control-sm text-end"
                                       value="@ligne.PrixAchat.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                       min="0"
                                       step="1">
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-3">
            <button type="submit" class="btn btn-success btn-lg">
                <i class="bi bi-check-circle me-2"></i>
                Confirmer l'import (@Model.NbTrouvees produits)
            </button>
            <a asp-action="Upload" class="btn btn-outline-secondary btn-lg">
                <i class="bi bi-arrow-left me-1"></i>
                Recommencer
            </a>
        </div>
    </form>
}

@if (User.IsInRole("Administrateur") && ViewBag.TexteOcrBrut is string texteOcrBrut && !string.IsNullOrEmpty(texteOcrBrut))
{
    <details class="mt-4">
        <summary class="text-muted small" style="cursor:pointer">
            <i class="bi bi-bug me-1"></i>Texte OCR brut (debug admin)
        </summary>
        <pre class="small bg-light border rounded p-3 mt-2" style="max-height:320px;overflow:auto;white-space:pre-wrap">@texteOcrBrut</pre>
    </details>
}
