@model Pharmacie.Models.SessionCaisse
@{
    ViewData["Title"] = "Fermer la caisse";
    decimal caEspeces = ViewBag.CaEspeces ?? 0m;
    decimal caWave = ViewBag.CaWave ?? 0m;
    decimal caOM = ViewBag.CaOM ?? 0m;
    decimal caAutre = ViewBag.CaAutre ?? 0m;
    decimal attendu = ViewBag.AttenduEspeces ?? (Model.FondDepart + caEspeces);
    int nbVentes = ViewBag.NbVentes ?? 0;

    var coupures = new[]
    {
        (10000, "Billet 10 000 F", "Billet10000"),
        (5000, "Billet 5 000 F", "Billet5000"),
        (2000, "Billet 2 000 F", "Billet2000"),
        (1000, "Billet 1 000 F", "Billet1000"),
        (500, "Pièce 500 F", "Piece500"),
        (250, "Pièce 250 F", "Piece250"),
        (200, "Pièce 200 F", "Piece200"),
        (100, "Pièce 100 F", "Piece100"),
        (50, "Pièce 50 F", "Piece50"),
        (25, "Pièce 25 F", "Piece25"),
        (10, "Pièce 10 F", "Piece10"),
        (5, "Pièce 5 F", "Piece5"),
    };
}

@await Html.PartialAsync("_BackButton")

<div class="d-flex align-items-center gap-2 mb-3">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i></a>
    <h1 class="h4 mb-0">Fermer — @Model.NomCaisse</h1>
</div>

@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger py-2">@err</div>
}

<div class="card shadow-sm">
    <div class="card-header bg-warning text-dark fw-bold">
        <i class="bi bi-lock me-1"></i>
        Fermer la caisse — Billetage
    </div>
    <div class="card-body">
        <form asp-action="Fermer" method="post"
              onsubmit="return confirm('Fermer définitivement la caisse ? Cette action ne peut pas être annulée.');">
            @Html.AntiForgeryToken()
            <input type="hidden" name="SessionId" value="@Model.Id" />

            <div class="alert alert-info mb-3">
                <strong>Résumé de votre session :</strong><br />
                Ventes : @nbVentes |
                CA Espèces : @caEspeces.ToString("N0") FCFA |
                CA Wave : @caWave.ToString("N0") FCFA |
                CA Orange Money : @caOM.ToString("N0") FCFA
                @if (caAutre > 0)
                {
                    <text>| Autres : @caAutre.ToString("N0") FCFA</text>
                }
                <br />
                Dépôts déjà effectués : @(((decimal)(ViewBag.TotalDepots ?? 0m)).ToString("N0")) FCFA<br />
                <strong>Attendu en caisse (fond + espèces − dépôts) :</strong> @attendu.ToString("N0") FCFA
            </div>

            <h6 class="fw-bold mb-3">Comptez votre caisse :</h6>

            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead class="table-success">
                        <tr>
                            <th>Coupure</th>
                            <th class="text-center">Nombre</th>
                            <th class="text-end">Montant</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (valeur, label, name) in coupures)
                        {
                            <tr>
                                <td>@label</td>
                                <td class="text-center">
                                    <input type="number"
                                           name="@name"
                                           class="form-control form-control-sm text-center coupure-input"
                                           data-valeur="@valeur"
                                           min="0" value="0"
                                           style="width:80px;margin:auto;" />
                                </td>
                                <td class="text-end fw-bold montant-ligne" id="montant-@name">0 F</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-warning">
                        <tr>
                            <td colspan="2" class="fw-bold">TOTAL BILLETAGE</td>
                            <td class="text-end fw-bold fs-5" id="total-billetage">0 FCFA</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="alert alert-secondary" id="alert-ecart">
                Écart vs attendu (@attendu.ToString("N0") FCFA) :
                <span id="ecart-montant" class="fw-bold">0 FCFA</span>
            </div>

            <div class="mb-3">
                <label class="form-label">Notes (optionnel)</label>
                <textarea name="Notes" class="form-control" rows="2" placeholder="Observations..."></textarea>
            </div>

            <button type="submit" class="btn btn-warning w-100 py-3 fw-bold">
                <i class="bi bi-lock me-2"></i>
                Fermer ma caisse
            </button>
        </form>
    </div>
</div>

@section Scripts {
<script>
(function () {
  var attendu = @attendu.ToString(System.Globalization.CultureInfo.InvariantCulture);

  function formatFcfa(n) {
    return Math.round(n).toLocaleString('fr-FR') + ' FCFA';
  }

  function recalc() {
    var total = 0;
    document.querySelectorAll('.coupure-input').forEach(function (inp) {
      var v = parseInt(inp.dataset.valeur, 10);
      var n = parseInt(inp.value, 10) || 0;
      var montant = v * n;
      total += montant;
      var el = document.getElementById('montant-' + inp.name);
      if (el) el.textContent = Math.round(montant).toLocaleString('fr-FR') + ' F';
    });

    document.getElementById('total-billetage').textContent = formatFcfa(total);

    var ecart = total - attendu;
    document.getElementById('ecart-montant').textContent =
      (ecart >= 0 ? '+' : '') + Math.round(ecart).toLocaleString('fr-FR') + ' FCFA';

    var alertDiv = document.getElementById('alert-ecart');
    alertDiv.className = 'alert ' +
      (ecart === 0 ? 'alert-success' : ecart > 0 ? 'alert-warning' : 'alert-danger');
  }

  document.querySelectorAll('.coupure-input').forEach(function (input) {
    input.addEventListener('input', recalc);
    input.addEventListener('change', recalc);
  });
  recalc();
})();
</script>
}
