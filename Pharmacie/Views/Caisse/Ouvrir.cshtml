@{
    ViewData["Title"] = "Ouvrir une caisse";
    int numeroCaisse = ViewBag.NumeroCaisse ?? 1;
    var titre = numeroCaisse == 1 ? "Caisse 1 — Matin" : "Caisse 2 — Soir";
}

@await Html.PartialAsync("_BackButton")

<div class="d-flex align-items-center gap-2 mb-3">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i></a>
    <h1 class="h4 mb-0">Ouvrir une caisse</h1>
</div>

@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger py-2">@err</div>
}

<div class="card shadow-sm mx-auto" style="max-width:500px">
    <div class="card-header bg-success text-white fw-bold">
        <i class="bi bi-unlock me-1"></i>
        Ouvrir @titre
    </div>
    <div class="card-body">
        <form asp-action="Ouvrir" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="NumeroCaisse" value="@numeroCaisse" />

            <div class="mb-3">
                <label class="form-label fw-bold">Fond de caisse de départ (FCFA)</label>
                <input type="number"
                       name="FondDepart"
                       class="form-control form-control-lg text-end"
                       value="50000"
                       min="0"
                       step="500" />
                <div class="form-text">Montant par défaut : 50 000 FCFA</div>
            </div>

            <div class="alert alert-info py-2">
                <i class="bi bi-info-circle me-1"></i>
                <small>Toutes vos ventes seront associées à cette caisse jusqu'à la fermeture.</small>
            </div>

            <button type="submit" class="btn btn-success w-100 py-3">
                <i class="bi bi-unlock me-2"></i>
                Ouvrir ma caisse
            </button>
        </form>
    </div>
</div>
