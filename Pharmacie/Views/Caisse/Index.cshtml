@using Pharmacie.Models
@using Pharmacie.Services
@using Pharmacie.Authorization
@{
    ViewData["Title"] = "Caisses";
    var sessionOuverte1 = ViewBag.SessionOuverte1 as SessionCaisse;
    var sessionOuverte2 = ViewBag.SessionOuverte2 as SessionCaisse;
    var derniereFermee1 = ViewBag.DerniereFermee1 as SessionCaisse;
    var derniereFermee2 = ViewBag.DerniereFermee2 as SessionCaisse;
    var labels = ViewBag.Labels as Dictionary<string, string> ?? new Dictionary<string, string>();
    bool isAdmin = ViewBag.IsAdminOrPharmacien == true;
    string currentUserId = ViewBag.CurrentUserId as string ?? "";
    var seuil = CaisseService.SeuilDepotFcfa;

    string Nom(SessionCaisse? s) =>
        s == null ? "—" : UserDisplayResolver.Resolve(labels, s.CaissierUserId);

    (int nb, decimal ca) Stats(SessionCaisse? s)
    {
        if (s == null) return (0, 0);
        var sales = s.Ventes.Select(v => v.Sale).Where(x => x != null).Cast<Sale>().ToList();
        return (sales.Count, sales.Sum(CaisseService.CalculerTotalSale));
    }

    var caisses = new[]
    {
        (1, sessionOuverte1, derniereFermee1, "Caisse 1 — Matin", "bg-success", "btn-success", "Caisse Matin"),
        (2, sessionOuverte2, derniereFermee2, "Caisse 2 — Soir", "bg-primary", "btn-primary", "Caisse Soir")
    };
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h1 class="h4 mb-0"><i class="bi bi-safe me-2 text-success"></i>Caisses du jour</h1>
    @if (isAdmin)
    {
        <a asp-action="RapportConsolide" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-bar-chart me-1"></i>Rapport consolidé
        </a>
    }
</div>

@if (TempData["Success"] is string succ)
{
    <div class="alert alert-success alert-dismissible fade show py-2" role="alert">
        <i class="bi bi-check-circle me-1"></i>@succ
        <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger alert-dismissible fade show py-2" role="alert">
        @err
        <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3">
@foreach (var (numero, sessionOuverte, derniereFermee, titre, headerCss, btnCss, nomCourt) in caisses)
{
    var session = sessionOuverte;
    var isOpen = session != null;
    var isMine = session != null && session.CaissierUserId == currentUserId;
    var canSeeDetails = isAdmin || isMine;
    var (nb, ca) = Stats(session);
    var solde = session != null ? CaisseService.CalculerSoldeTheorique(session) : 0m;
    var pct = seuil > 0 ? Math.Min((double)(solde / seuil * 100m), 100d) : 0d;
    var seuilAtteint = solde >= seuil;
    <div class="col-md-6">
        <div class="card shadow-sm h-100 @(isOpen ? (seuilAtteint ? "border-danger" : "border-success") : "border-secondary")">
            <div class="card-header @headerCss text-white fw-bold">
                <i class="bi bi-cash-register me-1"></i>@titre
            </div>
            <div class="card-body">
                @if (isOpen && session != null)
                {
                    <p class="mb-1"><span class="text-muted">Statut :</span> <span class="badge bg-success">Ouverte</span></p>
                    <p class="mb-1"><span class="text-muted">Caissier :</span> <strong>@Nom(session)</strong></p>
                    <p class="mb-1"><span class="text-muted">Ouverture :</span> @session.HeureOuverture.ToString("HH:mm")</p>
                    @if (canSeeDetails)
                    {
                        <p class="mb-1"><span class="text-muted">Fond départ :</span> @session.FondDepart.ToString("N0") FCFA</p>
                        <p class="mb-1"><span class="text-muted">Ventes :</span> @nb</p>
                        <p class="mb-2"><span class="text-muted">CA :</span> <strong class="text-success">@ca.ToString("N0") FCFA</strong></p>

                        <div class="mb-2">
                            <div class="d-flex justify-content-between">
                                <small class="text-muted">Solde en caisse</small>
                                <strong class="@(seuilAtteint ? "text-danger" : "text-success")">
                                    @solde.ToString("N0") FCFA
                                </strong>
                            </div>
                            <div class="progress" style="height:8px">
                                <div class="progress-bar @(seuilAtteint ? "bg-danger" : "bg-success")"
                                     style="width:@pct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"
                                     role="progressbar"></div>
                            </div>
                            <small class="text-muted">Seuil : @seuil.ToString("N0") FCFA</small>
                        </div>

                        @if (seuilAtteint)
                        {
                            <div class="alert alert-danger py-2 mb-2">
                                <i class="bi bi-exclamation-triangle me-1"></i>
                                Seuil atteint — Effectuez un dépôt
                            </div>
                        }

                        @if (isMine || isAdmin)
                        {
                            <div class="d-grid gap-2 mb-2">
                                <a asp-action="Depot" asp-route-sessionId="@session.Id" asp-route-type="0"
                                   class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-safe me-1"></i>Dépôt
                                </a>
                                <a asp-action="Depot" asp-route-sessionId="@session.Id" asp-route-type="1"
                                   class="btn btn-outline-warning btn-sm">
                                    <i class="bi bi-safe-fill me-1"></i>Dépôt final
                                </a>
                                <a asp-action="Fermer" asp-route-id="@session.Id" class="btn btn-warning">
                                    <i class="bi bi-lock me-1"></i>Fermer ma caisse
                                </a>
                            </div>
                        }
                        @if (AppRoles.IsTitulaire(User))
                        {
                            <form asp-action="ForcerFermeture" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="sessionId" value="@session.Id" />
                                <button type="submit"
                                        class="btn btn-sm btn-outline-danger mt-1"
                                        data-confirm="Forcer la fermeture de cette caisse ? Le billetage ne sera pas enregistré.">
                                    <i class="bi bi-lock-fill me-1"></i>
                                    Forcer fermeture
                                </button>
                            </form>
                        }
                    }
                    else
                    {
                        <p class="text-muted small mb-2">Session ouverte — détails réservés au caissier / admin.</p>
                        @if (AppRoles.IsTitulaire(User))
                        {
                            <form asp-action="ForcerFermeture" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="sessionId" value="@session.Id" />
                                <button type="submit"
                                        class="btn btn-sm btn-outline-danger mt-1"
                                        data-confirm="Forcer la fermeture de cette caisse ? Le billetage ne sera pas enregistré.">
                                    <i class="bi bi-lock-fill me-1"></i>
                                    Forcer fermeture
                                </button>
                            </form>
                        }
                    }
                }
                else if (derniereFermee != null)
                {
                    <div class="alert alert-warning py-2 mb-2">
                        <i class="bi bi-lock me-1"></i>
                        Fermée à @derniereFermee.HeureFermeture?.ToString("HH:mm")
                        — <a asp-action="Rapport" asp-route-id="@derniereFermee.Id" class="alert-link">
                            Voir le rapport
                        </a>
                    </div>
                    <p class="mb-1 small text-muted">Caissier : @Nom(derniereFermee)</p>
                    @if (isAdmin || derniereFermee.CaissierUserId == currentUserId)
                    {
                        <p class="mb-3 small text-muted">
                            Billetage : @(derniereFermee.BilletageTotal?.ToString("N0") ?? "—") FCFA
                        </p>
                    }
                    <a asp-action="Ouvrir" asp-route-numero="@numero" class="btn @btnCss w-100">
                        <i class="bi bi-unlock me-1"></i>
                        Réouvrir @nomCourt
                    </a>
                }
                else
                {
                    <p class="text-muted mb-3">Non ouverte</p>
                    <a asp-action="Ouvrir" asp-route-numero="@numero" class="btn @btnCss w-100">
                        <i class="bi bi-unlock me-1"></i>Ouvrir @nomCourt
                    </a>
                }
            </div>
        </div>
    </div>
}
</div>
