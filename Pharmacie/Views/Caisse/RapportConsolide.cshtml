@using Pharmacie.Models
@using Pharmacie.Services
@{
    ViewData["Title"] = "Rapport consolidé";
    var d = (DateTime)(ViewBag.Date ?? DateTime.Today);
    var c1 = ViewBag.Caisse1 as SessionCaisse;
    var c2 = ViewBag.Caisse2 as SessionCaisse;
    var labels = ViewBag.Labels as Dictionary<string, string> ?? new Dictionary<string, string>();

    (int nb, decimal ca, decimal especes, decimal wave, decimal om, decimal autre, decimal depots) Stats(SessionCaisse? s)
    {
        if (s == null) return (0, 0, 0, 0, 0, 0, 0);
        var sales = s.Ventes.Select(v => v.Sale).Where(x => x != null).Cast<Sale>().ToList();
        decimal SumPm(PaymentMethod pm) => sales.Where(x => x.PaymentMethod == pm).Sum(CaisseService.CalculerTotalSale);
        var especes = SumPm(PaymentMethod.Especes);
        var wave = SumPm(PaymentMethod.Wave);
        var om = SumPm(PaymentMethod.OrangeMoney);
        var autre = sales
            .Where(x => x.PaymentMethod is not (PaymentMethod.Especes or PaymentMethod.Wave or PaymentMethod.OrangeMoney))
            .Sum(CaisseService.CalculerTotalSale);
        var depots = s.Depots.Sum(x => x.MontantDepose);
        return (sales.Count, especes + wave + om + autre, especes, wave, om, autre, depots);
    }

    var s1 = Stats(c1);
    var s2 = Stats(c2);
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i></a>
        <h1 class="h4 mb-0">Rapport consolidé</h1>
    </div>
    <form method="get" class="d-flex gap-2 align-items-center">
        <input type="date" name="date" value="@d.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
        <button type="submit" class="btn btn-sm btn-primary">Filtrer</button>
    </form>
</div>

<p class="text-muted">Journée du <strong>@d.ToString("dd/MM/yyyy")</strong></p>

<div class="row g-3 mb-3">
    @foreach (var item in new[] { (c1, s1, "Caisse 1 — Matin", "border-success"), (c2, s2, "Caisse 2 — Soir", "border-primary") })
    {
        var session = item.Item1;
        var st = item.Item2;
        <div class="col-md-6">
            <div class="card h-100 @item.Item4">
                <div class="card-header fw-bold">@item.Item3</div>
                <div class="card-body">
                    @if (session == null)
                    {
                        <p class="text-muted mb-0">Aucune session ce jour.</p>
                    }
                    else
                    {
                        <p class="mb-1">
                            Statut :
                            <span class="badge @(session.Statut == SessionCaisseStatut.Ouverte ? "bg-success" : "bg-secondary")">
                                @session.Statut
                            </span>
                        </p>
                        <p class="mb-1">Caissier : <strong>@UserDisplayResolver.Resolve(labels, session.CaissierUserId)</strong></p>
                        <p class="mb-1">Fond : @session.FondDepart.ToString("N0") FCFA</p>
                        <p class="mb-1">Ventes : @st.nb</p>
                        <p class="mb-1">CA total : <strong>@st.ca.ToString("N0") FCFA</strong></p>
                        <p class="mb-1">Total dépôts : <strong class="text-primary">@st.depots.ToString("N0") FCFA</strong></p>
                        <p class="mb-1 small text-muted">Espèces @st.especes.ToString("N0") · Wave @st.wave.ToString("N0") · OM @st.om.ToString("N0")</p>
                        @if (session.BilletageTotal.HasValue)
                        {
                            <p class="mb-1">Billetage : @session.BilletageTotal.Value.ToString("N0") FCFA</p>
                        }
                        <a asp-action="Rapport" asp-route-id="@session.Id" class="btn btn-sm btn-outline-primary mt-2">Détail</a>
                    }
                </div>
            </div>
        </div>
    }
</div>

<div class="card border-dark">
    <div class="card-header bg-dark text-white fw-bold">Total consolidé</div>
    <div class="card-body">
        <div class="row text-center">
            <div class="col-6 col-md-3 mb-2">
                <div class="text-muted small">Ventes</div>
                <div class="fs-4 fw-bold">@(s1.nb + s2.nb)</div>
            </div>
            <div class="col-6 col-md-3 mb-2">
                <div class="text-muted small">CA journalier</div>
                <div class="fs-4 fw-bold text-success">@((s1.ca + s2.ca).ToString("N0")) FCFA</div>
            </div>
            <div class="col-6 col-md-3 mb-2">
                <div class="text-muted small">Total dépôts</div>
                <div class="fs-4 fw-bold text-primary">@((s1.depots + s2.depots).ToString("N0")) FCFA</div>
            </div>
            <div class="col-6 col-md-3 mb-2">
                <div class="text-muted small">Espèces</div>
                <div class="fs-5 fw-bold">@((s1.especes + s2.especes).ToString("N0"))</div>
            </div>
        </div>
        <hr />
        <div class="d-flex flex-wrap gap-3 small">
            <span>Wave : <strong>@((s1.wave + s2.wave).ToString("N0")) FCFA</strong></span>
            <span>Orange Money : <strong>@((s1.om + s2.om).ToString("N0")) FCFA</strong></span>
            <span>Autres : <strong>@((s1.autre + s2.autre).ToString("N0")) FCFA</strong></span>
            <span>Fonds départ : <strong>@(((c1?.FondDepart ?? 0) + (c2?.FondDepart ?? 0)).ToString("N0")) FCFA</strong></span>
            <span>Wave + OM : <strong>@((s1.wave + s2.wave + s1.om + s2.om).ToString("N0")) FCFA</strong></span>
        </div>
    </div>
</div>
