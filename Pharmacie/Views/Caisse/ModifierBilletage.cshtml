@model Pharmacie.Models.SessionCaisse
@using Pharmacie.Models
@{
    ViewData["Title"] = "Modifier le billetage";
    var billetage = ViewBag.Billetage as BilletageDetail ?? new BilletageDetail();
    var coupures = new[]
    {
        (10000, "Billet 10 000 F", "Billet10000", billetage.Billet10000),
        (5000, "Billet 5 000 F", "Billet5000", billetage.Billet5000),
        (2000, "Billet 2 000 F", "Billet2000", billetage.Billet2000),
        (1000, "Billet 1 000 F", "Billet1000", billetage.Billet1000),
        (500, "Pièce 500 F", "Piece500", billetage.Piece500),
        (250, "Pièce 250 F", "Piece250", billetage.Piece250),
        (200, "Pièce 200 F", "Piece200", billetage.Piece200),
        (100, "Pièce 100 F", "Piece100", billetage.Piece100),
        (50, "Pièce 50 F", "Piece50", billetage.Piece50),
        (25, "Pièce 25 F", "Piece25", billetage.Piece25),
        (10, "Pièce 10 F", "Piece10", billetage.Piece10),
        (5, "Pièce 5 F", "Piece5", billetage.Piece5),
    };
}

@await Html.PartialAsync("_BackButton")

<div class="d-flex align-items-center gap-2 mb-3">
    <a asp-action="Rapport" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h1 class="h4 mb-0">Modifier le billetage — @Model.NomCaisse</h1>
</div>

<div class="alert alert-warning">
    <i class="bi bi-exclamation-triangle me-1"></i>
    <strong>Attention :</strong> cette correction remplace le billetage de clôture
    et recalcule l’écart du rapport. Action réservée au Pharmacien Titulaire.
</div>

<div class="card mb-3">
    <div class="card-body small">
        <div><strong>Session :</strong> @Model.NomCaisse</div>
        <div><strong>Date :</strong> @Model.DateSession.ToString("dd/MM/yyyy")</div>
        <div><strong>Fermeture originale :</strong> @(Model.HeureFermeture?.ToString("dd/MM/yyyy HH:mm") ?? "—")</div>
        <div><strong>Billetage actuel :</strong> @(Model.BilletageTotal?.ToString("N0") ?? "—") FCFA</div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-warning text-dark fw-bold">
        <i class="bi bi-pencil me-1"></i>
        Nouveau décompte
    </div>
    <div class="card-body">
        <form asp-action="ModifierBilletage" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="sessionId" value="@Model.Id" />

            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead class="table-success">
                        <tr>
                            <th>Coupure</th>
                            <th class="text-center">Nombre</th>
                            <th class="text-end">Montant</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (valeur, label, name, count) in coupures)
                        {
                            <tr>
                                <td>@label</td>
                                <td class="text-center">
                                    <input type="number"
                                           name="@name"
                                           class="form-control form-control-sm text-center coupure-input"
                                           data-valeur="@valeur"
                                           min="0" value="@count"
                                           style="width:80px;margin:auto;" />
                                </td>
                                <td class="text-end fw-bold montant-ligne" id="montant-@name">
                                    @((count * valeur).ToString("N0")) F
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-warning">
                        <tr>
                            <td colspan="2" class="fw-bold">TOTAL BILLETAGE</td>
                            <td class="text-end fw-bold fs-5" id="total-billetage">
                                @billetage.Total.ToString("N0") FCFA
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <button type="submit" class="btn btn-warning w-100 py-3 fw-bold"
                    onclick="return confirm('Enregistrer cette correction de billetage ?');">
                <i class="bi bi-check-circle me-2"></i>
                Enregistrer la correction
            </button>
        </form>
    </div>
</div>

@section Scripts {
<script>
(function () {
  function formatFcfa(n) {
    return Math.round(n).toLocaleString('fr-FR') + ' FCFA';
  }
  function recalc() {
    var total = 0;
    document.querySelectorAll('.coupure-input').forEach(function (inp) {
      var v = parseInt(inp.dataset.valeur, 10);
      var n = parseInt(inp.value, 10) || 0;
      var montant = v * n;
      total += montant;
      var el = document.getElementById('montant-' + inp.name);
      if (el) el.textContent = Math.round(montant).toLocaleString('fr-FR') + ' F';
    });
    document.getElementById('total-billetage').textContent = formatFcfa(total);
  }
  document.querySelectorAll('.coupure-input').forEach(function (input) {
    input.addEventListener('input', recalc);
    input.addEventListener('change', recalc);
  });
  recalc();
})();
</script>
}
