@using Pharmacie.Models
@{
    decimal Get(string name)
    {
        var val = ViewData[name];
        return val == null ? 0m : Convert.ToDecimal(val);
    }
    var totalWave = Get("TotalWave");
    var totalOm = Get("TotalOrangeMoney");
    var totalFreemoney = Get("TotalFreemoney");
    var totalYas = Get("TotalYasMoney");
    var totalCheque = Get("TotalCheque");
    var totalTpe = Get("TotalTPE");
    var totalVirement = Get("TotalVirement");
    var totalTransfert = Get("TotalTransfertInternational");
    var totalAutres = Get("TotalAutres");
    var totalAutresPaiements = Get("TotalAutresPaiements");
    var totalEspeces = Get("TotalEspeces");
    if (totalEspeces == 0)
        totalEspeces = Get("CaEspeces");
}
<div class="card border-0 shadow-sm mt-3">
    <div class="card-header fw-bold">
        <i class="bi bi-credit-card me-1"></i>
        Répartition par mode de paiement
    </div>
    <div class="card-body p-0">
        <table class="table table-sm mb-0">
            <tbody>
                @if (totalEspeces > 0)
                {
                    <tr>
                        <td><i class="bi bi-cash text-success me-2"></i>Espèces</td>
                        <td class="text-end fw-bold">@totalEspeces.ToString("N0") FCFA</td>
                    </tr>
                }
                @if (totalWave > 0)
                {
                    <tr>
                        <td><i class="bi bi-phone text-primary me-2"></i>Wave</td>
                        <td class="text-end fw-bold">@totalWave.ToString("N0") FCFA</td>
                    </tr>
                }
                @if (totalOm > 0)
                {
                    <tr>
                        <td><i class="bi bi-phone text-warning me-2"></i>Orange Money</td>
                        <td class="text-end fw-bold">@totalOm.ToString("N0") FCFA</td>
                    </tr>
                }
                @if (totalFreemoney > 0)
                {
                    <tr>
                        <td>Freemoney</td>
                        <td class="text-end fw-bold">@totalFreemoney.ToString("N0") FCFA</td>
                    </tr>
                }
                @if (totalYas > 0)
                {
                    <tr>
                        <td>Yas Money</td>
                        <td class="text-end fw-bold">@totalYas.ToString("N0") FCFA</td>
                    </tr>
                }
                @if (totalCheque > 0)
                {
                    <tr>
                        <td><i class="bi bi-file-text me-2"></i>Chèque</td>
                        <td class="text-end fw-bold">@totalCheque.ToString("N0") FCFA</td>
                    </tr>
                }
                @if (totalTpe > 0)
                {
                    <tr>
                        <td>TPE</td>
                        <td class="text-end fw-bold">@totalTpe.ToString("N0") FCFA</td>
                    </tr>
                }
                @if (totalVirement > 0)
                {
                    <tr>
                        <td>Virement</td>
                        <td class="text-end fw-bold">@totalVirement.ToString("N0") FCFA</td>
                    </tr>
                }
                @if (totalTransfert > 0)
                {
                    <tr>
                        <td>Transfert intl</td>
                        <td class="text-end fw-bold">@totalTransfert.ToString("N0") FCFA</td>
                    </tr>
                }
                @if (totalAutres > 0)
                {
                    <tr>
                        <td>Autres</td>
                        <td class="text-end fw-bold">@totalAutres.ToString("N0") FCFA</td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-success">
                <tr>
                    <td class="fw-bold">TOTAL GÉNÉRAL (toutes caisses)</td>
                    <td class="text-end fw-bold fs-5">
                        @((totalEspeces + totalAutresPaiements).ToString("N0")) FCFA
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
