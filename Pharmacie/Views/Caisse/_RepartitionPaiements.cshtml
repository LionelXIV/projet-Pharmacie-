@using Pharmacie.Models
@{
    decimal Get(string name)
    {
        var val = ViewData[name];
        return val == null ? 0m : Convert.ToDecimal(val);
    }

    var simples = new (string Label, string Icon, decimal Amount)[]
    {
        ("Espèces", "bi bi-cash text-success", Get("CaEspeces")),
        ("Wave", "bi bi-phone text-primary", Get("CaWave")),
        ("Orange Money", "bi bi-phone text-warning", Get("CaOM")),
        ("Freemoney", "bi bi-phone", Get("CaFreemoney")),
        ("Yas Money", "bi bi-phone", Get("CaYasMoney")),
        ("Chèque", "bi bi-file-text", Get("CaCheque")),
        ("TPE", "bi bi-credit-card", Get("CaTPE")),
        ("Virement", "bi bi-bank", Get("CaVirement")),
        ("Transfert intl", "bi bi-globe", Get("CaTransfert")),
        ("Autres", "bi bi-three-dots", Get("CaAutreSimple"))
    };

    var fracs = new (string Label, decimal Amount)[]
    {
        ("Espèces (fractionné)", Get("CaEspecesFrac")),
        ("Wave (fractionné)", Get("CaWaveFrac")),
        ("Orange Money (fractionné)", Get("CaOMFrac")),
        ("Freemoney (fractionné)", Get("CaFreemoneyFrac")),
        ("Yas Money (fractionné)", Get("CaYasMoneyFrac")),
        ("Chèque (fractionné)", Get("CaChequeFrac")),
        ("TPE (fractionné)", Get("CaTPEFrac")),
        ("Virement (fractionné)", Get("CaVirementFrac")),
        ("Transfert intl (fractionné)", Get("CaTransfertFrac")),
        ("Autres (fractionné)", Get("CaAutreFrac"))
    };

    var totalAutresPaiements = Get("TotalAutresPaiements");
    var totalEspeces = Get("TotalEspeces");
    if (totalEspeces == 0)
        totalEspeces = Get("CaEspeces") + Get("CaEspecesFrac");
    var hasFrac = fracs.Any(x => x.Amount > 0);
}
<div class="card border-0 shadow-sm mt-3">
    <div class="card-header fw-bold">
        <i class="bi bi-credit-card me-1"></i>
        Répartition par mode de paiement
    </div>
    <div class="card-body p-0">
        <table class="table table-sm mb-0">
            <tbody>
                @foreach (var row in simples.Where(x => x.Amount > 0))
                {
                    <tr>
                        <td><i class="@row.Icon me-2"></i>@row.Label</td>
                        <td class="text-end fw-bold">@row.Amount.ToString("N0") FCFA</td>
                    </tr>
                }
                @if (hasFrac)
                {
                    <tr>
                        <td colspan="2" class="text-muted small pt-2">
                            <em>Paiements fractionnés</em>
                        </td>
                    </tr>
                    foreach (var row in fracs.Where(x => x.Amount > 0))
                    {
                        <tr>
                            <td>
                                <i class="bi bi-layout-split me-1 text-muted"></i>
                                @row.Label
                            </td>
                            <td class="text-end fw-bold">@row.Amount.ToString("N0") FCFA</td>
                        </tr>
                    }
                }
            </tbody>
            <tfoot class="table-success">
                <tr>
                    <td class="fw-bold">TOTAL GÉNÉRAL (toutes caisses)</td>
                    <td class="text-end fw-bold fs-5">
                        @((totalEspeces + totalAutresPaiements).ToString("N0")) FCFA
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
