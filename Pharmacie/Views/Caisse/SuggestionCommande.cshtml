@{
    ViewData["Title"] = "Suggestion de commande";
    var sessionId = ViewBag.SessionId as int? ?? 0;
    var produitsVendus = ViewBag.ProduitsVendus as List<Pharmacie.Models.ViewModels.SuggestionItem>
        ?? new List<Pharmacie.Models.ViewModels.SuggestionItem>();
    var ruptures = ViewBag.Ruptures as List<Pharmacie.Models.ViewModels.SuggestionItem>
        ?? new List<Pharmacie.Models.ViewModels.SuggestionItem>();
    var stockFaible = ViewBag.StockFaible as List<Pharmacie.Models.ViewModels.SuggestionItem>
        ?? new List<Pharmacie.Models.ViewModels.SuggestionItem>();
}

@await Html.PartialAsync("_BackButton")

<style>
    @@media print {
        .btn, form, .card-footer, .no-print {
            display: none !important;
        }
        .card {
            border: 1px solid #000 !important;
            break-inside: avoid;
        }
    }
</style>

<div class="page-header mb-3">
    <h1 class="page-title">Suggestion de commande après fermeture de caisse</h1>
    <p class="page-lead mb-0">
        Trois listes : produits vendus pendant la session, ruptures, et stock faible.
    </p>
</div>

@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger alert-dismissible fade show no-print" role="alert">
        @err
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
    </div>
}

<div class="d-flex flex-wrap gap-2 mb-3 no-print">
    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()">
        <i class="bi bi-printer me-1"></i>Imprimer
    </button>
    <a asp-controller="PanierCommande" asp-action="Index" class="btn btn-success btn-sm">
        <i class="bi bi-cart3 me-1"></i>Préparer la commande
    </a>
    <a asp-controller="Caisse" asp-action="Rapport" asp-route-id="@sessionId"
       class="btn btn-outline-primary btn-sm ms-auto">
        Voir le rapport
    </a>
</div>

<div class="row g-2">
    <div class="col-md-4">
        <div class="card border-primary h-100">
            <div class="card-header bg-primary text-white py-2">
                <i class="bi bi-cart-check me-1"></i>
                Vendus aujourd'hui
                <span class="badge bg-white text-primary ms-1">@produitsVendus.Count</span>
            </div>
            <div class="card-body p-0" style="max-height:400px;overflow-y:auto">
                <table class="table table-sm mb-0">
                    <thead class="sticky-top bg-white">
                        <tr>
                            <th>Produit</th>
                            <th class="text-center">Stock</th>
                            <th class="text-center">Vendu</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (produitsVendus.Count == 0)
                        {
                            <tr><td colspan="3" class="text-muted small text-center py-3">Aucune vente liée à cette session.</td></tr>
                        }
                        else
                        {
                            foreach (var p in produitsVendus)
                            {
                                <tr>
                                    <td class="small">@p.Nom</td>
                                    <td class="text-center">
                                        <span class="badge @(p.StockActuel <= 0 ? "bg-danger" : p.StockActuel <= p.Seuil ? "bg-warning text-dark" : "bg-success")">
                                            @p.StockActuel
                                        </span>
                                    </td>
                                    <td class="text-center fw-bold">@p.QteVendue</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer py-1">
                <form asp-controller="PanierCommande" asp-action="AjouterSuggestions" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="source" value="TopVente" />
                    <button type="submit" class="btn btn-sm btn-primary w-100">Ajouter au panier</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-danger h-100">
            <div class="card-header bg-danger text-white py-2">
                <i class="bi bi-x-circle me-1"></i>
                Ruptures
                <span class="badge bg-white text-danger ms-1">@ruptures.Count</span>
            </div>
            <div class="card-body p-0" style="max-height:400px;overflow-y:auto">
                <table class="table table-sm mb-0">
                    <thead class="sticky-top bg-white">
                        <tr>
                            <th>Produit</th>
                            <th>Fournisseur</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ruptures.Count == 0)
                        {
                            <tr><td colspan="2" class="text-muted small text-center py-3">Aucune rupture.</td></tr>
                        }
                        else
                        {
                            foreach (var p in ruptures)
                            {
                                <tr>
                                    <td class="small fw-bold text-danger">@p.Nom</td>
                                    <td class="small text-muted">@p.Fournisseur</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer py-1">
                <form asp-controller="PanierCommande" asp-action="AjouterSuggestions" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="source" value="Rupture" />
                    <button type="submit" class="btn btn-sm btn-danger w-100">Ajouter au panier</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-warning h-100">
            <div class="card-header bg-warning text-dark py-2">
                <i class="bi bi-exclamation-triangle me-1"></i>
                Stock faible
                <span class="badge bg-dark text-warning ms-1">@stockFaible.Count</span>
            </div>
            <div class="card-body p-0" style="max-height:400px;overflow-y:auto">
                <table class="table table-sm mb-0">
                    <thead class="sticky-top bg-white">
                        <tr>
                            <th>Produit</th>
                            <th class="text-center">Stock</th>
                            <th class="text-center">Seuil</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (stockFaible.Count == 0)
                        {
                            <tr><td colspan="3" class="text-muted small text-center py-3">Aucun stock faible.</td></tr>
                        }
                        else
                        {
                            foreach (var p in stockFaible)
                            {
                                <tr>
                                    <td class="small">@p.Nom</td>
                                    <td class="text-center">
                                        <span class="badge bg-warning text-dark">@p.StockActuel</span>
                                    </td>
                                    <td class="text-center text-muted">@p.Seuil</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer py-1">
                <form asp-controller="PanierCommande" asp-action="AjouterSuggestions" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="source" value="StockFaible" />
                    <button type="submit" class="btn btn-sm btn-warning text-dark w-100">Ajouter au panier</button>
                </form>
            </div>
        </div>
    </div>
</div>
